      kv[[2]] =!= "" && ! KeyExistsQ[spec, kv[[1]]], spec[kv[[1]]] = kv[[2]]],
    {line, Select[StringTrim /@ StringSplit[StringReplace[text, "\r\n" -> "\n"], "\n"], # =!= "" && ! StringStartsQ[#, "#"] &]}];
  spec];

