      If[FromDigits[a] <= FromDigits[b] <= FromDigits[a] + 40, Range[FromDigits[a], FromDigits[b]], {}]],
    StringCases[s, ("\:30b9\:30e9\:30a4\:30c9" | "Slide" | "slide" | "#") ~~ ws ~~ a : d :> {FromDigits[a]}],
    StringCases[s, a : d ~~ ws ~~ ("\:679a\:76ee" | "\:756a\:76ee") :> {FromDigits[a]}]];
