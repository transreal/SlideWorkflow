          True,
          (* \:4f4d\:7f6e\:304c 2 \:79d2\:9032\:3093\:3067\:3044\:306a\:3044: \:9cf4\:308a\:7d42\:308f\:308a (\:307e\:305f\:306f\:6b7b\:3093\:3060\:30b9\:30c8\:30ea\:30fc\:30e0) \:6271\:3044 *)
