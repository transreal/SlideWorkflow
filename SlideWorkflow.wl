    If[p === {} || p[[-1, 1]] < n/2, cut <> "\:2026", StringTake[cut, p[[-1, 2]]]]]]];
iSWPosterTalkSkeleton[ctx_Association] := Module[{plan = ctx["Plan"], order = ctx["Order"], budget = ctx["Budget"], outline = ctx["Outline"],
    lang = ctx["Lang"], rate = ctx["Rate"], talks = <||>, op, stop},
  stop = If[lang === "ja", "\:3002", ". "];
  op = ctx["Title"] <> If[lang === "ja", "\:306e\:767a\:8868\:3067\:3059\:3002", ". "] <> iSWPosterLayoutSentence[plan, lang];
  op = iSWPosterTrimChars[op, Round[budget["Opening"] rate]];
  Do[With[{blk = order[[k]], bb = budget["Blocks"][[k]]},
      MapIndexed[Function[{p, i}, Module[{n = p["Slide"], head, body, pts, gist = Replace[blk["Gist"], Except[_String] -> ""]},
        pts = If[1 <= n <= Length[outline["Markdown"]], iSWPosterFirstLines[ToString[outline["Markdown"][[n]]], 2], {}];
        head = If[First[i] === 1,
          iSWPosterBlockRef[blk, lang] <> If[lang === "ja", "\:3067\:3059\:3002", ". "] <>
            If[gist =!= "", gist <> If[StringEndsQ[gist, "\:3002" | "."], "", stop], ""], ""];
        body = iSWQAOneLine[p["Title"]] <> stop <> If[pts === {}, "", StringRiffle[pts, stop] <> stop];
        talks[n] = iSWPosterTrimChars[head <> body, Max[40, Round[bb["PerPanel"] rate]]]]], blk["Panels"]]],
    {k, Length[order]}];
  <|"Opening" -> op, "Talks" -> talks|>];

(* ---- \:66f8\:304f (\:30d1\:30ec\:30c3\:30c8\:300c\:30dd\:30b9\:30bf\:30fc\:539f\:7a3f\:300d) ---- *)
Options[SlidePosterTalkFill] = {"Minutes" -> Automatic, "Mode" -> Automatic, "Then" -> None};
SlidePosterTalkFill[opts : OptionsPattern[]] := With[{nb = iSWNotebook[]}, If[nb === $Failed, $Failed, SlidePosterTalkFill[nb, opts]]];
SlidePosterTalkFill[nb_NotebookObject, OptionsPattern[]] := Module[
  {plan, outline, minutes, lang, mode, order, budget, rate, ctx, title, batches, written},
  If[iSWPosterTalkBusyQ[],
    iSWStatus[nb, iSL["\:30dd\:30b9\:30bf\:30fc\:539f\:7a3f\:3092\:66f8\:3044\:3066\:3044\:307e\:3059\:3002\:7d42\:308f\:308b\:307e\:3067\:5f85\:3063\:3066\:304f\:3060\:3055\:3044", "Writing the poster talk; wait until it finishes"]];
    Return[<|"Status" -> "Busy"|>]];
  Quiet[SlidePosterTalkRestyle[nb]];   (* \:30b9\:30bf\:30a4\:30eb\:306e\:6ce8\:5165\:3068\:3001\:53e4\:3044\:5f62\:306e\:30bb\:30eb\:306e\:4ed8\:3051\:66ff\:3048 *)
  plan = Quiet @ Check[SlidePosterPlan[nb], $Failed];
  If[! iSWPosterPlanQ[plan],
    iSWStatus[nb, iSL["\:30dd\:30b9\:30bf\:30fc\:306e\:8a08\:753b\:304c\:4f5c\:308c\:307e\:305b\:3093 (\:30b9\:30e9\:30a4\:30c9\:304c\:7121\:3044?)", "Cannot plan the poster (no slides?)"]]; iSWStatusClearLater[nb];
    Return[plan]];
  outline = iTalkDeckOutline[iSWDeckTextSource[nb]];
  If[outline === $Failed,
    iSWStatus[nb, iSL["\:30b9\:30e9\:30a4\:30c9\:304c\:898b\:3064\:304b\:308a\:307e\:305b\:3093", "No slides found"]]; iSWStatusClearLater[nb]; Return[$Failed]];
  minutes = Replace[OptionValue["Minutes"], Except[_?NumericQ] -> iSWPosterTalkMinutesFor[plan]];
  lang = Lookup[plan, "Language", "ja"];
  rate = If[lang === "ja", iSWTalkCharRate[], 2.0 iSWTalkCharRate[]];
  order = iSWPosterTalkOrder[plan];
  budget = iSWPosterTalkBudget[order, minutes];
  title = With[{t = Lookup[plan["Header"], "Title", ""]}, If[StringQ[t] && StringTrim[t] =!= "", t, Last[iSWDeckBaseName[nb]]]];
  mode = Replace[OptionValue["Mode"], Automatic -> If[iSWLLMReadyQ[], "LLM", "Skeleton"]];
  ctx = <|"Plan" -> plan, "Order" -> order, "Budget" -> budget, "Outline" -> outline, "Lang" -> lang, "Rate" -> rate,
    "Minutes" -> minutes, "Title" -> title, "Meta" -> iSWDirectivesBlock[nb] <> iSWDictionaryBlock[nb]|>;
  If[mode =!= "LLM",
    written = iSWPosterTalkWriteAll[nb, iSWPosterTalkSkeleton[ctx]];
    Quiet[iSWRefreshTalkModeLabel[nb]];
    iSWGraphApplyNote[nb, iSL["\:30dd\:30b9\:30bf\:30fc\:539f\:7a3f\:306e\:9aa8\:683c\:3092 " <> ToString[written] <> " \:30bb\:30eb\:306b\:66f8\:304d\:307e\:3057\:305f (" <> iSWMinutesString[minutes] <> ")\:3002LLM \:304c\:3042\:308c\:3070\:300c\:30dd\:30b9\:30bf\:30fc\:539f\:7a3f\:300d\:3067\:66f8\:304d\:76f4\:305b\:307e\:3059\:3002\:767a\:8868\:30d1\:30ec\:30c3\:30c8\:306e\:300c\:539f\:7a3f: \:30dd\:30b9\:30bf\:30fc\:300d\:3067\:518d\:751f",
      "Wrote a skeleton poster talk into " <> ToString[written] <> " cells (" <> iSWMinutesString[minutes] <> "). Rewrite with Poster talk when an LLM is available; play with Talk: Poster in the talk palette"]];
    Return[<|"Status" -> "Skeleton", "Written" -> written, "Minutes" -> minutes|>]];
  batches = Partition[Range[Length[order]], UpTo[Max[1, $iSWPosterTalkBatch]]];
  $iSWPosterTalkRun = <|"Written" -> 0, "Failed" -> 0, "Busy" -> True, "Since" -> AbsoluteTime[], "Then" -> OptionValue["Then"], "Minutes" -> minutes|>;
  iSWPosterTalkChain[nb, Append[ctx, "Batches" -> batches], 1];
  <|"Status" -> "Submitted", "Blocks" -> Length[order], "Batches" -> Length[batches], "Minutes" -> minutes|>];

$iSWPosterTalkRun = <|"Busy" -> False|>;
iSWPosterTalkBusyQ[] := TrueQ[Lookup[$iSWPosterTalkRun, "Busy", False]] && AbsoluteTime[] - Lookup[$iSWPosterTalkRun, "Since", 0] < 1200;
iSWPosterTalkChain[nb_, ctx_Association, idx_Integer] := If[idx > Length[ctx["Batches"]],
  $iSWPosterTalkRun["Busy"] = False;
  Quiet[iSWRefreshTalkModeLabel[nb]];
  iSWGraphApplyNote[nb, iSL["\:30dd\:30b9\:30bf\:30fc\:539f\:7a3f\:3092 " <> ToString[$iSWPosterTalkRun["Written"]] <> " \:30bb\:30eb\:306b\:66f8\:304d\:307e\:3057\:305f (" <> iSWMinutesString[Lookup[$iSWPosterTalkRun, "Minutes", 7]] <> ")" <>
      If[$iSWPosterTalkRun["Failed"] > 0, " (\:66f8\:3051\:306a\:304b\:3063\:305f\:679a " <> ToString[$iSWPosterTalkRun["Failed"]] <> ")", ""] <>
      "\:3002\:767a\:8868\:30d1\:30ec\:30c3\:30c8\:306e\:300c\:539f\:7a3f: \:30dd\:30b9\:30bf\:30fc\:300d\:3067\:3001\:30dd\:30b9\:30bf\:30fc\:539f\:7a3f\:306e\:3042\:308b\:679a\:3060\:3051\:3092\:9806\:306b\:8aad\:307f\:307e\:3059",
    "Wrote the poster talk into " <> ToString[$iSWPosterTalkRun["Written"]] <> " cells (" <> iSWMinutesString[Lookup[$iSWPosterTalkRun, "Minutes", 7]] <> ")" <>
      If[$iSWPosterTalkRun["Failed"] > 0, " (" <> ToString[$iSWPosterTalkRun["Failed"]] <> " failed)", ""] <>
      ". Play with Talk: Poster in the talk palette"]];
  With[{then = Lookup[$iSWPosterTalkRun, "Then", None]}, If[then =!= None, Quiet[then[]]]],
  Module[{idxs = ctx["Batches"][[idx]], prompt, nums},
    $iSWPosterTalkRun["Since"] = AbsoluteTime[];
    nums = Flatten[Map[Lookup[ctx["Order"][[#]]["Panels"], "Slide"] &, idxs]];
    iSWStatus[nb, iSL["\:30dd\:30b9\:30bf\:30fc\:539f\:7a3f\:3092\:66f8\:3044\:3066\:3044\:307e\:3059 " <> ToString[idx] <> "/" <> ToString[Length[ctx["Batches"]]] <> "\:2026",
      "Writing the poster talk " <> ToString[idx] <> "/" <> ToString[Length[ctx["Batches"]]] <> "..."]];
    prompt = iSWPosterTalkPrompt[ctx, idxs, idx === 1];
    With[{n2 = nb, c = ctx, i2 = idx, targets = nums},
      NBAccess`$NBLLMQueryFunc[prompt,
        Function[resp, Module[{r = iSWPosterTalkParse[resp, targets]},
          If[AssociationQ[r],
            Do[If[KeyExistsQ[r["Talks"], k] && iSWPosterTalkWriteCell[n2, k, r["Talks"][k]] =!= $Failed,
                $iSWPosterTalkRun["Written"] = $iSWPosterTalkRun["Written"] + 1,
                $iSWPosterTalkRun["Failed"] = $iSWPosterTalkRun["Failed"] + 1],
              {k, Reverse[targets]}];
            If[i2 === 1 && r["Opening"] =!= "" && iSWPosterTalkWriteCell[n2, 0, r["Opening"]] =!= $Failed,
              $iSWPosterTalkRun["Written"] = $iSWPosterTalkRun["Written"] + 1],
            $iSWPosterTalkRun["Failed"] = $iSWPosterTalkRun["Failed"] + Length[targets]];
          iSWPosterTalkChain[n2, c, i2 + 1]]],
        n2, Fallback -> iSWFallback[]]]]];
iSWPosterTalkAction[nb_] := SlidePosterTalkFill[nb];

(* ---- \:518d\:751f: \:30dd\:30b9\:30bf\:30fc\:539f\:7a3f\:306e\:3042\:308b\:679a\:3060\:3051\:3092\:8aad\:3080 (\:539f\:7a3f\:306e\:7121\:3044\:679a\:306f\:98db\:3070\:3059) ---- *)
iSWPlayNextWithText[texts_Association, n_Integer, count_Integer] := Module[{k = n},
  While[k <= count && StringTrim[ToString[Lookup[texts, k, ""]]] === "", k++];
  k];
iSWPlaySkipSilent[nb_, n_Integer] := Module[{k = n, texts = Replace[$iSWPlayState["Texts"], Except[_Association] -> <||>], count = $iSWPlayState["Count"]},
  While[k <= count && StringTrim[ToString[Lookup[texts, k, ""]]] === "",
    iSWSlideGoNext[nb]; Pause[0.15]; k++];
  k];

