     \:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:306e\:30bb\:30eb\:4f4d\:7f6e\:304b\:3089\:6c7a\:307e\:308b\:306e\:3067\:3001\:540c\:3058\:30ce\:30fc\:30c8\:306a\:3089\:524d\:63d0\:8fba\:306e\:5148\:3082\:5909\:308f\:3089\:306a\:3044 *)
