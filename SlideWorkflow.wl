SlideYouTubeUpload[src : (_NotebookObject | _String), opts : OptionsPattern[]] := Module[
  {interactive, nb = None, deck = None, file, tl, res, cur, meta, pl, title, desc, tags, privacy, category, lang,
   size, fdate, prev, token, metadata, video, id, url, status, entry},
  interactive = Replace[OptionValue["Interactive"], Automatic -> True];
  Which[
    Head[src] === NotebookObject,
      nb = src; deck = Quiet[NotebookFileName[nb]];
      file = Replace[OptionValue["File"], Automatic :> iSWVideoOutput[nb]],
    StringQ[src] && ToLowerCase[FileExtension[src]] === "nb",
      deck = src; file = Replace[OptionValue["File"], Automatic :> FileNameJoin[{DirectoryName[src], FileBaseName[src] <> "_narrated.mp4"}]],
    StringQ[src],
      file = src,
    True, Return[iSWVideoFail["SlideYouTubeNoVideo", "\:52d5\:753b\:304c\:6307\:5b9a\:3055\:308c\:3066\:3044\:307e\:305b\:3093\:3002", "No video was given."]]];
  (* \:52d5\:753b\:304c\:7121\:3051\:308c\:3070 (\:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:304b\:3089\:306a\:3089) \:5148\:306b\:4f5c\:308b *)
  If[! FileExistsQ[file],
    If[Head[nb] === NotebookObject && interactive && TrueQ[ChoiceDialog[
        iSL["\:8aad\:307f\:4e0a\:3052\:4ed8\:304d\:306e\:52d5\:753b\:304c\:307e\:3060\:3042\:308a\:307e\:305b\:3093\:3002\:5148\:306b\:4f5c\:3063\:3066\:304b\:3089\:30a2\:30c3\:30d7\:30ed\:30fc\:30c9\:3057\:307e\:3059\:304b?", "There is no narrated video yet. Make it first, then upload?"],
        {iSL["\:4f5c\:3063\:3066\:304b\:3089\:4e0a\:3052\:308b", "Make it, then upload"] -> True, iSL["\:3084\:3081\:308b", "Cancel"] -> False}]],
      res = SlideTalkVideo[nb];
      If[! (AssociationQ[res] && res["Status"] === "Done"),
        Return[Which[FailureQ[res], res,
          AssociationQ[res] && res["Status"] === "Recording",
            iSWVideoFail["SlideYouTubeRecording", "gpt-live-1 \:3067\:9332\:97f3\:3092\:59cb\:3081\:307e\:3057\:305f\:3002\:52d5\:753b\:304c\:3067\:304d\:3066\:304b\:3089\:300cYouTube\:300d\:3092\:62bc\:3057\:3066\:304f\:3060\:3055\:3044\:3002",
              "Recording with gpt-live-1 has started; press YouTube again once the video is ready."],
          True, iSWVideoFail["SlideYouTubeNoVideo", "\:52d5\:753b\:3092\:4f5c\:308c\:307e\:305b\:3093\:3067\:3057\:305f\:3002", "Could not make the video."]]]],
      Return[iSWVideoFail["SlideYouTubeNoVideo", "\:52d5\:753b\:304c\:3042\:308a\:307e\:305b\:3093: " <> file, "No video: " <> file]]]];
  iSWTrace["YT video " <> FileNameTake[file]];
  tl = Replace[iSWReadJSON[iSWVideoTimelineFile[file]], Except[_Association] -> <||>];
  (* \:4f5c\:3063\:305f\:3042\:3068\:3067\:30b9\:30e9\:30a4\:30c9\:304c\:5909\:308f\:3063\:3066\:3044\:308c\:3070\:77e5\:3089\:305b\:308b *)
  If[Head[nb] === NotebookObject && interactive,
    cur = iSWVideoDeckDigest[nb];
    If[StringQ[cur] && StringQ[Lookup[tl, "SlidesDigest", None]] && cur =!= tl["SlidesDigest"],
      Switch[ChoiceDialog[iSL["\:52d5\:753b\:3092\:4f5c\:3063\:305f\:3042\:3068\:3067\:30b9\:30e9\:30a4\:30c9\:304c\:5909\:308f\:3063\:3066\:3044\:307e\:3059\:3002", "The slides changed after the video was made."],
          {iSL["\:4f5c\:308a\:76f4\:3057\:3066\:304b\:3089\:4e0a\:3052\:308b", "Remake, then upload"] -> "Remake", iSL["\:3053\:306e\:307e\:307e\:4e0a\:3052\:308b", "Upload as is"] -> "AsIs",
           iSL["\:3084\:3081\:308b", "Cancel"] -> "Cancel"}],
        "Remake",
          res = SlideTalkVideo[nb];
          If[! (AssociationQ[res] && res["Status"] === "Done"),
            Return[If[FailureQ[res], res, iSWVideoFail["SlideYouTubeNoVideo", "\:52d5\:753b\:3092\:4f5c\:308a\:76f4\:305b\:307e\:305b\:3093\:3067\:3057\:305f\:3002", "Could not remake the video."]]]];
          tl = Replace[iSWReadJSON[iSWVideoTimelineFile[file]], Except[_Association] -> <||>],
        "AsIs", Null,
        _, Return[Failure["Cancelled", <||>]]]]];
  iSWTrace["YT checked"];
  meta = Which[Head[nb] === NotebookObject, Quiet[SlideTalkMeta[nb]], StringQ[deck] && FileExistsQ[deck], Quiet[iSWUploadMetaOf[deck]], True, <||>];
  If[! AssociationQ[meta], meta = <||>];
  (* \:516c\:958b\:3057\:3066\:3088\:3044\:304b: \:767a\:8868\:306e PrivacyLevel \:3068\:3001\:30ce\:30fc\:30c8\:306e\:975e\:516c\:958b\:5ba3\:8a00 (\:9650\:5b9a\:516c\:958b\:3067\:3082\:30ea\:30f3\:30af\:3092\:77e5\:308b\:4eba\:306f\:8ab0\:3067\:3082\:898b\:3089\:308c\:308b) *)
  pl = Lookup[meta, "PrivacyLevel", None];
  If[NumericQ[pl] && pl >= 0.5,
    Return[iSWVideoFail["SlideYouTubePrivate",
      "\:3053\:306e\:767a\:8868\:306f PrivacyLevel " <> ToString[pl] <> " (0.5 \:4ee5\:4e0a) \:306a\:306e\:3067 YouTube \:3078\:306f\:4e0a\:3052\:307e\:305b\:3093\:3002\:9650\:5b9a\:516c\:958b\:3067\:3082\:3001\:30ea\:30f3\:30af\:3092\:77e5\:308b\:4eba\:306f\:8ab0\:3067\:3082\:898b\:3089\:308c\:307e\:3059\:3002",
      "This talk has PrivacyLevel " <> ToString[pl] <> " (0.5 or more), so it is not uploaded. An unlisted video is visible to anyone with the link."]]];
  If[Head[nb] === NotebookObject && Quiet[CurrentValue[nb, {TaggingRules, "SourceVault", "CloudPublishable"}]] === False,
    Return[iSWVideoFail["SlideYouTubePrivate", "\:3053\:306e\:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:306f\:975e\:516c\:958b (Private) \:3068\:5ba3\:8a00\:3055\:308c\:3066\:3044\:308b\:306e\:3067 YouTube \:3078\:306f\:4e0a\:3052\:307e\:305b\:3093\:3002",
      "This notebook is declared Private, so it is not uploaded to YouTube."]]];
  title = Replace[OptionValue["Title"], Automatic :> With[{t = Lookup[tl, "Title", Lookup[meta, "Title", ""]]},
    If[StringQ[t] && StringTrim[t] =!= "", t, FileBaseName[file]]]];
  title = StringTake[iSWYTOneLine[title], UpTo[100]];
  desc = Replace[OptionValue["Description"], Automatic :> iSWYTDescription[meta, tl, title, OptionValue["Chapters"]]];
  desc = iSWYTTruncateBytes[StringReplace[ToString[desc], {"<" -> "\:ff1c", ">" -> "\:ff1e"}], 4900];
  tags = Replace[OptionValue["Tags"], Automatic :> Select[DeleteDuplicates[
      iSWYTOneLine /@ Flatten[{Lookup[meta, "Event", ""], Lookup[meta, "Aliases", {}]}]], # =!= "" && StringLength[#] <= 30 &]];
  tags = Take[Select[Flatten[{tags}], StringQ], UpTo[15]];
  privacy = Replace[OptionValue["Privacy"], Automatic :> $SlideYouTubePrivacy];
  If[! MemberQ[{"unlisted", "private", "public"}, privacy], privacy = "unlisted"];
  category = ToString[Replace[OptionValue["Category"], Automatic :> $SlideYouTubeCategory]];
  lang = Replace[OptionValue["Language"], Automatic :> Replace[Lookup[tl, "Language", None],
    Except[_String] :> If[Head[nb] === NotebookObject, Quiet[SlideTalkLanguage[nb]], None]]];
  size = FileByteCount[file];
  fdate = DateString[FileDate[file], "ISODateTime"];
  (* \:540c\:3058\:30d5\:30a1\:30a4\:30eb\:3092\:524d\:306b\:4e0a\:3052\:3066\:3044\:308c\:3070\:77e5\:3089\:305b\:308b *)
  iSWTrace["YT meta ok"];
  prev = SelectFirst[Reverse[iSWYTHistory[file]], Lookup[#, "Bytes", -1] === size && Lookup[#, "FileDate", ""] === fdate &, None];
  If[AssociationQ[prev] && ! TrueQ[OptionValue["Force"]],
    If[! interactive, Return[<|"Status" -> "AlreadyUploaded", "URL" -> prev["URL"], "VideoId" -> prev["VideoId"]|>]];
    Switch[ChoiceDialog[iSL["\:3053\:306e\:52d5\:753b\:306f " <> ToString[Lookup[prev, "UploadedAt", ""]] <> " \:306b\:4e0a\:3052\:3066\:3044\:307e\:3059:\n", "This video was uploaded at " <> ToString[Lookup[prev, "UploadedAt", ""]] <> ":\n"] <> ToString[prev["URL"]],
        {iSL["\:3082\:3046\:4e00\:5ea6\:4e0a\:3052\:308b", "Upload again"] -> "Again", iSL["\:524d\:306e\:52d5\:753b\:3092\:958b\:304f", "Open the earlier one"] -> "Open", iSL["\:3084\:3081\:308b", "Cancel"] -> "Cancel"}],
      "Again", Null,
      "Open", Quiet[SystemOpen[prev["URL"]]]; Return[<|"Status" -> "AlreadyUploaded", "URL" -> prev["URL"], "VideoId" -> prev["VideoId"]|>],
      _, Return[Failure["Cancelled", <||>]]]];
  (* \:5916\:3078\:51fa\:3059\:524d\:306b\:5fc5\:305a\:78ba\:304b\:3081\:308b *)
  iSWTrace["YT confirm >"];
  If[interactive && ! TrueQ[ChoiceDialog[
      Column[{Style[iSL["YouTube \:306b\:30a2\:30c3\:30d7\:30ed\:30fc\:30c9\:3057\:307e\:3059", "Upload to YouTube"], Bold, 12],
        Grid[{
          {iSL["\:984c", "Title"], title},
          {iSL["\:516c\:958b\:7bc4\:56f2", "Visibility"], Switch[privacy, "unlisted", iSL["\:9650\:5b9a\:516c\:958b (\:30ea\:30f3\:30af\:3092\:77e5\:3063\:3066\:3044\:308b\:4eba\:3060\:3051\:304c\:898b\:3089\:308c\:308b)", "Unlisted (anyone with the link)"],
            "private", iSL["\:975e\:516c\:958b", "Private"], _, iSL["\:516c\:958b", "Public"]]},
          {iSL["\:9577\:3055", "Length"], If[NumericQ[Lookup[tl, "Duration", None]], iSWClock[tl["Duration"]], "?"]},
          {iSL["\:5927\:304d\:3055", "Size"], ToString[Round[size/2.^20, 0.1]] <> " MB"},
          {iSL["\:30d5\:30a1\:30a4\:30eb", "File"], file}}, Alignment -> Left, Spacings -> {1.5, 0.6}]}, Spacings -> 1],
      {iSL["\:30a2\:30c3\:30d7\:30ed\:30fc\:30c9", "Upload"] -> True, iSL["\:3084\:3081\:308b", "Cancel"] -> False}, WindowTitle -> "YouTube"]],
    Return[Failure["Cancelled", <||>]]];
  iSWTrace["YT token >"];
  token = iSWYTAccessToken[interactive];
  If[! StringQ[token], Return[If[FailureQ[token], token, iSWVideoFail["SlideYouTubeTokenFailed", "\:8a31\:53ef\:3092\:5f97\:3089\:308c\:307e\:305b\:3093\:3067\:3057\:305f\:3002", "Not authorized."]]]];
  metadata = <|"snippet" -> Join[<|"title" -> title, "description" -> desc, "categoryId" -> category|>,
      If[tags =!= {}, <|"tags" -> tags|>, <||>],
      If[StringQ[lang] && lang =!= "", <|"defaultLanguage" -> lang, "defaultAudioLanguage" -> lang|>, <||>]],
    "status" -> <|"privacyStatus" -> privacy, "selfDeclaredMadeForKids" -> TrueQ[OptionValue["MadeForKids"]],
      "embeddable" -> True|>|>;
  If[Head[nb] === NotebookObject, iSWStatus[nb, iSL["YouTube \:3078\:30a2\:30c3\:30d7\:30ed\:30fc\:30c9\:3057\:3066\:3044\:307e\:3059 0%", "Uploading to YouTube 0%"]]];
  iSWTrace["YT upload >"];
  video = iSWYTUploadFile[file, metadata, token,
    Function[{done, total}, If[Head[nb] === NotebookObject,
      iSWStatus[nb, iSL["YouTube \:3078\:30a2\:30c3\:30d7\:30ed\:30fc\:30c9\:3057\:3066\:3044\:307e\:3059 ", "Uploading to YouTube "] <>
        ToString[Round[100. done/Max[1, total]]] <> "% (" <> ToString[Round[done/2.^20]] <> " / " <> ToString[Round[total/2.^20]] <> " MB)"]]]];
  token = Null;
  If[FailureQ[video], If[Head[nb] === NotebookObject, iSWStatusClearLater[nb]]; Return[video]];
  id = Lookup[video, "id", None];
  If[! StringQ[id],
    If[Head[nb] === NotebookObject, iSWStatusClearLater[nb]];
    Return[iSWVideoFail["SlideYouTubeUploadFailed", "\:30a2\:30c3\:30d7\:30ed\:30fc\:30c9\:306e\:5fdc\:7b54\:306b\:52d5\:753b ID \:304c\:3042\:308a\:307e\:305b\:3093\:3002", "The upload response has no video id."]]];
  url = "https://youtu.be/" <> id;
  status = Lookup[Lookup[video, "status", <||>], "privacyStatus", privacy];
  entry = <|"VideoId" -> id, "URL" -> url, "Title" -> title, "Privacy" -> status, "File" -> file,
    "Bytes" -> size, "FileDate" -> fdate, "UploadedAt" -> DateString[Now, {"Year", "-", "Month", "-", "Day", " ", "Hour", ":", "Minute"}]|>;
  Quiet[iSWWriteJSON[iSWYTHistoryFile[file], Append[iSWYTHistory[file], entry]]];
  Quiet[CopyToClipboard[url]];
  If[Head[nb] === NotebookObject,
    iSWStatus[nb, iSL["YouTube \:306b\:30a2\:30c3\:30d7\:30ed\:30fc\:30c9\:3057\:307e\:3057\:305f: ", "Uploaded to YouTube: "] <> url];
    iSWStatusClearLater[nb]];
  If[interactive && TrueQ[ChoiceDialog[
      iSL["YouTube \:306b\:30a2\:30c3\:30d7\:30ed\:30fc\:30c9\:3057\:307e\:3057\:305f (URL \:306f\:30af\:30ea\:30c3\:30d7\:30dc\:30fc\:30c9\:306b\:30b3\:30d4\:30fc\:6e08\:307f)\:3002\n", "Uploaded to YouTube (the URL is on the clipboard).\n"] <> url <>
        If[status =!= privacy, iSL["\n\:516c\:958b\:7bc4\:56f2\:304c\:300c" <> ToString[status] <> "\:300d\:306b\:306a\:3063\:3066\:3044\:307e\:3059\:3002YouTube Studio \:3067\:78ba\:304b\:3081\:3066\:304f\:3060\:3055\:3044\:3002",
          "\nThe visibility came back as \"" <> ToString[status] <> "\"; check it in YouTube Studio."], "\n" <>
          iSL["YouTube \:3067\:306e\:51e6\:7406 (\:753b\:8cea\:306e\:5909\:63db) \:304c\:7d42\:308f\:308b\:307e\:3067\:3001\:3057\:3070\:3089\:304f\:518d\:751f\:3067\:304d\:306a\:3044\:3053\:3068\:304c\:3042\:308a\:307e\:3059\:3002", "YouTube may need a while to process it before it plays."]],
      {iSL["\:958b\:304f", "Open"] -> True, iSL["\:9589\:3058\:308b", "Close"] -> False}]],
    Quiet[SystemOpen[url]]];
  Join[<|"Status" -> "Uploaded"|>, entry]];

(* \:62bc\:3057\:305f\:3089\:3059\:3050\:72b6\:614b\:884c\:306b\:51fa\:3059 (\:51fa\:306a\:3051\:308c\:3070\:30dc\:30bf\:30f3\:306e\:51e6\:7406\:304c\:59cb\:307e\:3063\:3066\:3044\:306a\:3044)\:3002\:9014\:4e2d\:306e\:30e1\:30c3\:30bb\:30fc\:30b8\:3082\:62fe\:3044\:3001\:60f3\:5b9a\:5916\:306e\:623b\:308a\:5024\:306f\:898b\:305b\:308b *)
iSWYouTubeAction[nb_] := Module[{ed, r, msgs},
  iSWTrace["YT action >"];
  iSWStatus[nb, iSL["YouTube: \:6e96\:5099\:3057\:3066\:3044\:307e\:3059...", "YouTube: preparing..."]];
  ed = EvaluationData[SlideYouTubeUpload[nb]];
  r = ed["Result"];
  msgs = Take[Replace[ed["MessagesText"], Except[_List] -> {}], UpTo[4]];
  iSWTrace["YT action < " <> ToString[Head[r]] <> If[FailureQ[r], " " <> ToString[First[r]], ""] <>
    If[msgs === {}, "", " msgs: " <> StringTake[StringRiffle[msgs, " | "], UpTo[400]]]];
  Which[
    FailureQ[r] && First[r] === "Cancelled", iSWStatus[nb, ""],
    FailureQ[r],
      iSWStatusClearLater[nb];
      MessageDialog[iSL["YouTube \:3078\:4e0a\:3052\:3089\:308c\:307e\:305b\:3093\:3067\:3057\:305f:\n", "Could not upload to YouTube:\n"] <> iSWVideoFailText[r]],
    AssociationQ[r] && StringQ[Lookup[r, "Status", None]], Null,
    True,
      iSWStatusClearLater[nb];
      MessageDialog[iSL["YouTube \:306e\:51e6\:7406\:304c\:60f3\:5b9a\:5916\:306e\:7d50\:679c\:3067\:7d42\:308f\:308a\:307e\:3057\:305f:\n", "The YouTube step ended unexpectedly:\n"] <>
        StringTake[ToString[Short[r, 3]], UpTo[300]] <> If[msgs === {}, "", "\n" <> StringRiffle[msgs, "\n"]]]];
  r];

