(* \:767b\:9332\:3057\:305f OAuth \:30af\:30e9\:30a4\:30a2\:30f3\:30c8 <|client_id, client_secret|> (\:7121\:3051\:308c\:3070 None)\:3002\:30b7\:30fc\:30af\:30ec\:30c3\:30c8\:306f\:8fd4\:308a\:5024\:306b\:51fa\:3055\:306a\:3044 *)
iSWYTClient[] := Module[{s = iSWCredGet[$iSWYTClientKey], c},
