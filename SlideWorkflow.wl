  (* \:58f0\:306f 1 \:672c\:306e wav (48 kHz\:30fb16 bit\:30fb\:30e2\:30ce\:30e9\:30eb) \:306b\:30ab\:30fc\:30cd\:30eb\:3067\:66f8\:3044\:3066\:304b\:3089\:6e21\:3059\:3002\:679a\:3054\:3068\:306b -i \:3067\:6e21\:3059\:3068\:3001StartProcess \:306f
     \:30b3\:30de\:30f3\:30c9\:30e9\:30a4\:30f3\:304c 4 \:5343\:5b57\:4f59\:308a\:3092\:8d85\:3048\:308b\:3068 (\:5b9f\:5728\:3059\:308b\:306e\:306b) "Program ... not found" \:3067\:5931\:6557\:3059\:308b
     (2026-10-11 \:5b9f\:6e2c: 47 \:679a\:3067 11,700 \:5b57\:30024,112 \:5b57\:306f\:901a\:308a 6,211 \:5b57\:3067\:5931\:6557)\:3002\:3053\:308c\:3067\:5f15\:6570\:306f\:679a\:6570\:306b\:3088\:3089\:305a\:6570\:767e\:5b57 *)
  awav = FileNameJoin[{tmp, "audio.wav"}];
