(* JSON \:306f UTF-8 \:306e\:30d0\:30a4\:30c8\:5217\:3067\:8aad\:307f\:66f8\:304d\:3059\:308b (rule 30: ExportString \:306e\:7d50\:679c\:3092\:518d\:30a8\:30f3\:30b3\:30fc\:30c9\:3057\:306a\:3044) *)
iSWReadJSON[path_String] := Module[{b, v},
  If[! FileExistsQ[path], Return[$Failed]];
  b = Quiet[ReadByteArray[path]];
  If[! ByteArrayQ[b], Return[$Failed]];
  v = Quiet[Check[ImportByteArray[b, "RawJSON"], $Failed]];
  If[AssociationQ[v] || ListQ[v], v, $Failed]];

iSWWriteJSON[path_String, value_] := Module[{b, s},
  (* None \:306f JSON \:306b\:306a\:3089\:306a\:3044 (\:66f8\:304d\:51fa\:3057\:3054\:3068\:9ed9\:3063\:3066\:5931\:6557\:3059\:308b) \:306e\:3067 null \:306b\:3059\:308b *)
  b = Quiet[Check[ExportByteArray[value /. None -> Null, "RawJSON"], $Failed]];
  If[! ByteArrayQ[b], Return[$Failed]];
  s = Quiet[OpenWrite[path, BinaryFormat -> True]];
  If[Head[s] =!= OutputStream, Return[$Failed]];
  WithCleanup[BinaryWrite[s, b], Quiet[Close[s]]];
  path];

iSWAudioSeconds[file_String] := Module[{a = Quiet[Audio[file]]},
  If[TrueQ[Quiet[AudioQ[a]]], iSWSeconds[Quiet[Duration[a]]], $Failed]];

(* ---- \:30b9\:30e9\:30a4\:30c9\:306e\:753b\:50cf (<deck>_slides/NN.png)\:3002\:63cf\:753b\:306e\:30cf\:30c3\:30b7\:30e5\:304c\:540c\:3058\:306a\:3089\:4f5c\:308a\:76f4\:3055\:306a\:3044 ---- *)

iSWVideoImageName[i_Integer] := StringPadLeft[ToString[i], 2, "0"] <> ".png";

iSWVideoImages[nb_NotebookObject] := Module[{dir, base, outdir, deck, saved, st, digest, files = $Failed, ext, imgs, src},
  {dir, base} = iSWDeckBaseName[nb];
  outdir = FileNameJoin[{dir, base <> "_slides"}];
  deck = Quiet[NotebookFileName[nb]];
  saved = StringQ[deck] && FileExistsQ[deck] && ! iSWUnsavedQ[nb];
  If[saved,
    digest = Quiet[iSWDeckDigest[deck]];
    st = iSWDeckStateRead[deck];
    If[StringQ[digest] && digest === Lookup[st, "ImagesSlidesDigest", None] &&
        IntegerQ[Lookup[st, "ImagesCount", None]] && st["ImagesCount"] > 0,
      With[{fs = Table[FileNameJoin[{outdir, iSWVideoImageName[i]}], {i, st["ImagesCount"]}]},
        If[AllTrue[fs, FileExistsQ], files = fs; src = "Reused"]]]];
  If[files === $Failed,
    iSWStatus[nb, If[saved, iSL["\:30b9\:30e9\:30a4\:30c9\:306e\:753b\:50cf\:3092\:4f5c\:3063\:3066\:3044\:307e\:3059...", "Rendering the slide images..."],
      iSL["\:672a\:4fdd\:5b58\:306a\:306e\:3067 FE \:306e\:4e2d\:3067\:753b\:50cf\:3092\:63cf\:304d\:307e\:3059 (\:4fdd\:5b58\:3059\:308b\:3068\:5225\:30d7\:30ed\:30bb\:30b9\:3067\:63cf\:3051\:307e\:3059)...",
        "Unsaved: rendering the images inside the FE (save first to render in a separate process)..."]]];
    ext = iSWTryExternal[nb, "SlideDeckExportImages", outdir];
    If[MatchQ[ext, {__String}] && AllTrue[ext, FileExistsQ],
      files = ext; src = "External",
      If[saved, iSWStatus[nb, iSL["FE \:306e\:4e2d\:3067\:30b9\:30e9\:30a4\:30c9\:306e\:753b\:50cf\:3092\:63cf\:3044\:3066\:3044\:307e\:3059...",
        "Rendering the slide images inside the FE..."] <> iSWExternalSeatNote[]]];
      imgs = SlideDeckImages[iSWDeckSource[nb]];
      If[MatchQ[imgs, {__Image}],
        If[! DirectoryQ[outdir], Quiet[CreateDirectory[outdir, CreateIntermediateDirectories -> True]]];
        files = MapIndexed[Export[FileNameJoin[{outdir, iSWVideoImageName[First[#2]]}], #1] &, imgs];
        src = "FE"]];
    If[MatchQ[files, {__String}] && saved,
      $iSWDeckDigestCache = KeyDrop[$iSWDeckDigestCache, deck];
      With[{d = Quiet[iSWDeckDigest[deck]]},
        If[StringQ[d], iSWDeckStateWrite[deck, <|"ImagesSlidesDigest" -> d, "ImagesCount" -> Length[files]|>]]]]];
  If[! MatchQ[files, {__String}],
    Return[iSWVideoFail["SlideVideoImages", "\:30b9\:30e9\:30a4\:30c9\:306e\:753b\:50cf\:3092\:4f5c\:308c\:307e\:305b\:3093\:3067\:3057\:305f\:3002", "Could not render the slide images."]]];
  <|"Files" -> files, "Source" -> src|>];

(* ---- \:30ed\:30fc\:30ab\:30eb\:306e\:58f0: \:518d\:751f\:3068\:540c\:3058\:30ad\:30e3\:30c3\:30b7\:30e5 (iSWVoiceFileInDir \:3068\:540c\:3058\:540d\:524d) \:306b\:3001\:58f0\:3092\:660e\:793a\:3057\:3066\:5408\:6210 ---- *)
iSWVideoLocalFile[dir_String, k_Integer, voice_String, speech_String] := Module[{file},
  file = iSWVoiceCacheFile[dir, k, voice, speech];
  If[FileExistsQ[file] && TrueQ[Quiet[FileByteCount[file]] > 1000], Return[file]];
  If[! DirectoryQ[dir], Quiet[CreateDirectory[dir, CreateIntermediateDirectories -> True]]];
  Quiet[SourceVault`SourceVaultVoiceSpeak[speech, "Voice" -> voice, "OutputFile" -> file]];
  If[FileExistsQ[file], file, $Failed]];

(* ---- \:679a\:306e\:4e26\:3073\:3068\:9577\:3055\:3002\:6642\:523b\:306f 48 kHz \:306e\:6a19\:672c\:3067\:5207\:308a\:63c3\:3048\:308b (\:6620\:50cf\:306e\:679a\:306e\:9577\:3055\:3068\:58f0\:306e\:9577\:3055\:3092\:540c\:3058\:6570\:3067\:5207\:308b) ---- *)
iSWVideoSegments[images_List, audio_Association, include_List, titles_List] := Module[
  {lead, gap, silent, tail, segs, t = 0.},
  lead = Replace[$SlideTalkVideoLeadIn, Except[_?NumericQ] -> 0.5];
  gap = Replace[$SlideVoiceGap, Except[_?NumericQ] -> 0.8];
  silent = Replace[$iSWVoiceSilentSeconds, Except[_?NumericQ] -> 3.];
  tail = Replace[$SlideTalkVideoTail, Except[_?NumericQ] -> 1.5];
  segs = Map[Function[k, Module[{f = Lookup[audio, k, None], s},
      s = If[StringQ[f], iSWAudioSeconds[f], $Failed];
      <|"Slide" -> k, "Image" -> images[[k]],
        "Title" -> If[k <= Length[titles], ToString[titles[[k]]], ""],
        "Audio" -> If[NumericQ[s] && s > 0, f, None],
        "AudioSeconds" -> If[NumericQ[s] && s > 0, N[s], 0.],
        "Lead" -> N[lead],
        "Duration" -> If[NumericQ[s] && s > 0, N[lead + s + gap], N[silent]]|>]],
    Select[include, IntegerQ[#] && 1 <= # <= Length[images] &]];
  If[segs === {}, Return[{}]];
  segs[[-1, "Duration"]] = segs[[-1, "Duration"]] + N[tail];
  segs = Map[Append[#, "Duration" -> Round[48000 #["Duration"]]/48000.] &, segs];
  Map[Function[sg, With[{st = t}, t += sg["Duration"]; Append[sg, "Start" -> st]]], segs]];

(* ---- ffmpeg ---- *)
iSWFFmpegProgress[file_String] := Module[{t, v},
  t = Quiet[Check[ReadString[file], ""]];
  If[! StringQ[t], Return[0.]];
  v = StringCases[t, "out_time_us=" ~~ d : DigitCharacter .. :> d];
  If[v === {}, v = StringCases[t, "out_time_ms=" ~~ d : DigitCharacter .. :> d]];
  If[v === {}, 0., N[ToExpression[Last[v]]/10^6]]];

(* \:66f8\:304d\:51fa\:3057\:3092\:59cb\:3081\:308b (ffmpeg \:306f\:5f85\:305f\:306a\:3044)\:3002ffmpeg \:306b\:306f ASCII \:306e\:30d1\:30b9\:3060\:3051\:3092\:6e21\:3059: \:753b\:50cf\:306f\:4f5c\:696d\:30d5\:30a9\:30eb\:30c0\:3078\:5199\:3057\:3001
   \:58f0\:306f\:307e\:3068\:3081\:305f 1 \:672c\:306e wav \:3092\:4f5c\:696d\:30d5\:30a9\:30eb\:30c0\:306b\:66f8\:304f *)
(* 1 \:679a\:306e\:58f0 -> 48 kHz \:30e2\:30ce\:30e9\:30eb\:306e 16 bit \:6574\:6570\:5217 (\:8aad\:3081\:306a\:3051\:308c\:3070 {}) *)
iSWVideoSamples[file_String, rate_Integer] := Module[{a = Quiet[Import[file]]},
  If[! TrueQ[Quiet[AudioQ[a]]], Return[{}]];
  If[AudioChannels[a] > 1, a = AudioChannelMix[a, "Mono"]];
  If[AudioSampleRate[a] =!= rate, a = AudioResample[a, rate]];
  Round[32767. Clip[First[AudioData[a]], {-1., 1.}]]];

(* \:5168\:90e8\:306e\:679a\:306e\:58f0\:3092\:3001\:679a\:306e\:9577\:3055 (\:524d\:7f6e\:304d + \:58f0 + \:9593\:3001\:6a19\:672c\:3067\:5207\:308a\:63c3\:3048\:6e08\:307f) \:3069\:304a\:308a\:306b 1 \:672c\:306e wav \:3078\:66f8\:304f\:3002
   1 \:679a\:305a\:3064\:8aad\:3093\:3067\:66f8\:304d\:8db3\:3059\:306e\:3067\:300130 \:5206\:306e\:767a\:8868\:3067\:3082\:5927\:304d\:306a\:914d\:5217\:3092\:6301\:305f\:306a\:3044 *)
iSWVideoWriteAudio[segs_List, path_String] := Module[{rate = 48000, counts, total, s, data, lead, ok = True},
  counts = Round[rate #["Duration"]] & /@ segs;
  total = Total[counts];
  s = Quiet[OpenWrite[path, BinaryFormat -> True]];
  If[Head[s] =!= OutputStream, Return[$Failed]];
  WithCleanup[
    BinaryWrite[s, ToCharacterCode["RIFF"], "Byte"];
    BinaryWrite[s, 36 + 2 total, "UnsignedInteger32", ByteOrdering -> -1];
    BinaryWrite[s, ToCharacterCode["WAVEfmt "], "Byte"];
    BinaryWrite[s, 16, "UnsignedInteger32", ByteOrdering -> -1];
    BinaryWrite[s, {1, 1}, "UnsignedInteger16", ByteOrdering -> -1];
    BinaryWrite[s, {rate, 2 rate}, "UnsignedInteger32", ByteOrdering -> -1];
    BinaryWrite[s, {2, 16}, "UnsignedInteger16", ByteOrdering -> -1];
    BinaryWrite[s, ToCharacterCode["data"], "Byte"];
    BinaryWrite[s, 2 total, "UnsignedInteger32", ByteOrdering -> -1];
    Do[
      data = If[StringQ[segs[[i, "Audio"]]], iSWVideoSamples[segs[[i, "Audio"]], rate], {}];
      lead = If[data === {}, 0, Min[counts[[i]], Round[rate segs[[i, "Lead"]]]]];
      (* PadRight \:306f\:9577\:3059\:304e\:308c\:3070\:5207\:308a\:3001\:77ed\:3051\:308c\:3070 0 (\:7121\:97f3) \:3067\:57cb\:3081\:308b *)
      data = PadRight[Join[ConstantArray[0, lead], data], counts[[i]]];
      If[BinaryWrite[s, data, "Integer16", ByteOrdering -> -1] === $Failed, ok = False],
      {i, Length[segs]}],
    Quiet[Close[s]]];
  If[ok && FileExistsQ[path], path, $Failed]];

iSWVideoComposeStart[segs_List, out_String, meta_Association] := Module[
