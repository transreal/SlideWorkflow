      <|"Detail" -> "ffmpeg: " <> exe <> If[FileExistsQ[exe], "",
        iSL[" (\:898b\:3064\:304b\:308a\:307e\:305b\:3093\:3002$SlideFFmpegPath \:306b ffmpeg.exe \:306e\:5b8c\:5168\:306a\:30d1\:30b9\:3092\:8a2d\:5b9a\:3057\:3066\:304f\:3060\:3055\:3044)",
