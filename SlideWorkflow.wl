iSWPosterTalkWriteCell[nb_NotebookObject, n_Integer, text_String] := Module[{ranges, cells, styles, span, pIdx, tIdx, qIdx, cell},
  ranges = iSWSlideRanges[nb];
  If[ranges === {}, Return[$Failed]];
  cells = Cells[nb]; styles = iSWCellStyles[nb];
  span = Which[n === 0, Range[1, ranges[[1, 1]] - 1],
    1 <= n <= Length[ranges], Range[ranges[[n, 1]], Min[ranges[[n, 2]], Length[styles]]],
    True, Return[$Failed]];
  cell = iContentCell[{"PosterTalk", text}];
  pIdx = SelectFirst[span, iSWPosterTalkCellFEQ[styles[[#]], cells[[#]]] &, None];
  tIdx = Select[span, Intersection[Flatten[{styles[[#]]}], {"SlideTalk", "SlidePosterTalk"}] =!= {} &];
  qIdx = SelectFirst[span, MemberQ[Flatten[{styles[[#]]}], "SlideQA"] &, None];
  Which[
    IntegerQ[pIdx], SelectionMove[cells[[pIdx]], All, Cell]; NotebookWrite[nb, cell, All],
    n === 0, SelectionMove[cells[[ranges[[1, 1]]]], Before, Cell]; NotebookWrite[nb, cell],
    tIdx =!= {}, SelectionMove[cells[[Last[tIdx]]], After, Cell]; NotebookWrite[nb, cell],
    IntegerQ[qIdx], SelectionMove[cells[[qIdx]], Before, Cell]; NotebookWrite[nb, cell],
    True, SelectionMove[cells[[Last[span]]], After, Cell]; NotebookWrite[nb, cell]];
  n];
