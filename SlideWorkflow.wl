    Return[$Failed]];
  plan = iSWTalkLangPlanOf[nb];
  texts = plan["Texts"];
  (* v1.59: \:9332\:97f3\:3067\:306f SlideTalkVideo \:304c\:6c7a\:3081\:305f\:539f\:7a3f\:3092\:305d\:306e\:307e\:307e\:8aad\:3080 *)
  If[TrueQ[OptionValue["Record"]] && AssociationQ[$iSWVideoRecord] && AssociationQ[$iSWVideoRecord["Texts"]],
