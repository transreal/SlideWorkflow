(* \:8cea\:7591\:306e\:7b54\:3048\:5411\:3051: \:767a\:8868\:306e\:6587\:8108\:306b\:8aad\:307f\:306e\:4e00\:89a7\:3092\:6dfb\:3048\:308b (\:539f\:7a3f\:3092\:7d4c\:306a\:3044\:7b54\:3048\:306f\:7f6e\:304d\:63db\:3048\:3089\:308c\:306a\:3044\:306e\:3067\:3001\:3053\:3053\:306f\:52aa\:529b\:76ee\:6a19) *)
