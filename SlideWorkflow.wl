        " \:679a (\:524d\:63d0\:3068\:3057\:3066\:7701\:3044\:305f " <> ToString[Length[Lookup[p["Plan"], "Assumed", {}]]] <> " \:30ce\:30fc\:30c9\:3001\:843d\:3068\:3057\:305f " <>
