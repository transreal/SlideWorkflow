      StringRiffle[(#[[1]] <> "=" <> #[[2]]) & /@ Take[r, UpTo[150]], "\:3001"]]];

(* \:767a\:8868\:6642\:9593\:306e\:898b\:7a4d\:3082\:308a (iSWTalkDuration) \:304c\:5408\:6210\:6e08\:307f\:306e\:97f3\:58f0\:3092\:63a2\:3059\:3068\:304d\:306e\:8f9e\:66f8\:3002SlideTalkDuration[nb] \:304c Block \:3067\:5165\:308c\:308b *)
$iSWDurationReadings = Automatic;
