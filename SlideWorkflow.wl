    If[AssociationQ[link], kg = link["Graph"]]];
  res = SourceVault`SourceVaultKGSave[kg];
  If[! StringQ[res],
    Return[Failure["SaveFailed", <|"MessageTemplate" -> "could not save knowledge graph `1`",
      "MessageParameters" -> {graphId}|>]]];
