  Quiet[SlideEnsureDeckStyles[nb]];
  If[! ListQ[styles] || Length[styles] =!= Length[cells], Return[0]];
  Do[If[MemberQ[Flatten[{styles[[i]]}], "SlideTalk"] && iSWTalkCellKindFE[cells[[i]]] === "Poster",
      With[{c = Quiet[NotebookRead[cells[[i]]]]},
