           \:300c\:5c4a\:304f\:307e\:3067\:5ef6\:9577\:300d\:3060\:3068\:8aad\:307f\:7d42\:308f\:308a\:5f8c\:306b\:9577\:3044\:7121\:97f3\:304c\:51fa\:308b (\:5b9f\:6e2c 2026-08-26) *)
        If[pos > $iSWPlayState["LastPos"] + 0.01,
