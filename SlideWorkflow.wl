    $iSWVideoRecord = None;
    If[Head[nb] === NotebookObject,
      iSWStatus[nb, iSL["\:9332\:97f3\:3092\:6b62\:3081\:307e\:3057\:305f\:3002\:9332\:308c\:305f\:679a\:306f\:6b8b\:3063\:3066\:3044\:308b\:306e\:3067\:3001\:3082\:3046\:4e00\:5ea6\:300c\:52d5\:753b\:4f5c\:6210\:300d\:3092\:62bc\:3059\:3068\:7d9a\:304d\:304b\:3089\:9332\:308a\:307e\:3059",
        "Recording stopped. The recorded slides are kept; press Video again to continue."]]]]];

iSWVideoEstimate[texts_Association] :=
  N[Total[StringLength /@ Select[Values[texts], StringQ]]/5.6 + 3 Length[texts]];

Options[SlideTalkVideo] = {"Output" -> Automatic, "Voice" -> Automatic, "Model" -> Automatic,
  "Live" -> Automatic, "Parallel" -> Automatic, "Interactive" -> Automatic};

SlideTalkVideo[opts : OptionsPattern[]] := With[{nb = iSWResolveTargetNb[]},
  If[Head[nb] === NotebookObject, SlideTalkVideo[nb, opts],
    iSWVideoFail["NoNotebook", "\:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:304c\:898b\:3064\:304b\:308a\:307e\:305b\:3093\:3002", "No notebook found."]]];

SlideTalkVideo[nb_NotebookObject, opts : OptionsPattern[]] := Module[
  {interactive, voice, model, engine, mode, plan = None, texts, lack, choice, lang, img, images, count,
   readings, keys, include, dir, vkey, speech, files, missing, res = None, failedKeys = {}, titles, out, meta, i = 0},
