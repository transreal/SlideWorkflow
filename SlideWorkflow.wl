(* \:300c\:53cd\:6620\:300d: KG \:306e\:7121\:3044\:30c7\:30c3\:30ad\:306a\:3089\:3001\:65e2\:5b58\:306e\:30b9\:30e9\:30a4\:30c9\:304b\:3089 KG \:3092\:4f5c\:308b (\:78ba\:304b\:3081\:3066\:304b\:3089)\:3002KG \:304c\:3042\:308c\:3070\:5f93\:6765\:3069\:304a\:308a\:539f\:7a3f\:3068 KG \:3092\:5408\:308f\:305b\:308b *)
iSWS2KNoGraphQ[nb_NotebookObject] := Module[{story, g},
  If[! TrueQ[Quiet[iSWKGEnsure[]]] || iSWSlideRanges[nb] === {}, Return[False]];
  story = Quiet @ Check[Fold[Join[#2, #1] &, <||>, iSWParseStoryText /@ iSWStyleTexts[nb, "SlideStory"]], <||>];
  g = If[AssociationQ[story], Lookup[story, "Graph", None], None];
  ! StringQ[g] || StringTrim[g] === "" || ! AssociationQ[Quiet[iSWKGResolve[g]]]];

iSWS2KSyncAction[nb_NotebookObject] := Module[{n = Length[iSWSlideRanges[nb]], ok, res},
  ok = ChoiceDialog[iSL[
      "\:3053\:306e\:30c7\:30c3\:30ad\:306b\:306f\:77e5\:8b58\:30b0\:30e9\:30d5\:304c\:3042\:308a\:307e\:305b\:3093\:3002\n\n\:65e2\:5b58\:306e " <> ToString[n] <> " \:679a\:306e\:30b9\:30e9\:30a4\:30c9\:304b\:3089\:77e5\:8b58\:30b0\:30e9\:30d5\:3092\:4f5c\:308a\:307e\:3059 (\:679a\:306e\:9806\:3068\:898b\:51fa\:3057\:3092\:305d\:306e\:307e\:307e\:5199\:3059)\:3002" <>
        "\:30b9\:30e9\:30a4\:30c9\:306e\:4e2d\:8eab\:306f\:5909\:3048\:305a\:3001\:984c\:76ee\:30bb\:30eb\:306b\:5bfe\:5fdc\:306e\:30bf\:30b0\:3092\:3001\:524d\:7f6e\:304d\:306b\:6307\:793a\:30bb\:30eb\:3068 Story \:30bb\:30eb (Source: \:30b9\:30e9\:30a4\:30c9) \:3092\:8db3\:3057\:307e\:3059\:3002\n" <>
        "\:8868\:7d19\:306f\:6839\:306e\:8981\:7d04\:306b\:3001\:300c\:6700\:5f8c\:5c3e\:300d\:306e\:679a\:304b\:3089\:5f8c\:308d\:306f\:5165\:308c\:307e\:305b\:3093\:3002\:30d7\:30e9\:30a4\:30d0\:30b7\:30fc\:30ec\:30d9\:30eb\:306f\:6307\:793a\:30bb\:30eb\:306e PrivacyLevel: (\:7121\:3051\:308c\:3070 0.5)\:3002",
      "This deck has no knowledge graph.\n\nBuild one from the existing " <> ToString[n] <> " slides (their order and headings are kept). " <>
        "The slides are not changed; the title cells get a mapping tag and the prelude gets a Directive and a Story cell (Source: slides)."],
    {iSL["\:4f5c\:308b", "Build"] -> True, iSL["\:3084\:3081\:308b", "Cancel"] -> False}];
  If[ok =!= True, Return[<|"Status" -> "Cancelled"|>]];
  iSWStatus[nb, iSL["\:65e2\:5b58\:306e\:30b9\:30e9\:30a4\:30c9\:304b\:3089\:77e5\:8b58\:30b0\:30e9\:30d5\:3092\:4f5c\:3063\:3066\:3044\:307e\:3059\:2026", "Building the knowledge graph from the slides..."]];
  res = SlideGraphFromSlides[nb];
  If[FailureQ[res],
    iSWStatus[nb, ToString[Lookup[Last[res], "MessageTemplate", res]]]; iSWStatusClearLater[nb]; Return[res]];
  iSWStatus[nb, iSL[
    "\:65e2\:5b58\:306e\:30b9\:30e9\:30a4\:30c9\:304b\:3089\:77e5\:8b58\:30b0\:30e9\:30d5\:3092\:4f5c\:308a\:307e\:3057\:305f: " <> ToString[res["Slides"]] <> " \:679a \:2192 " <> ToString[res["Nodes"]] <> " \:30ce\:30fc\:30c9" <>
      If[res["Parts"] > 0, " (\:90e8 " <> ToString[res["Parts"]] <> ")", " (\:90e8\:306a\:3057: \:5fc5\:8981\:306a\:3089\:300c\:968e\:5c64\:5316\:300d)"] <> "\:3001KG \:540d " <> res["GraphId"] <>
      "\:3001PL " <> ToString[res["PrivacyLevel"]] <> "\:3002\:539f\:7a3f\:3082\:5408\:308f\:305b\:308b\:306a\:3089\:3001\:3082\:3046\:4e00\:5ea6\:300c\:53cd\:6620\:300d",
    "Built the knowledge graph from the slides: " <> ToString[res["Slides"]] <> " slides -> " <> ToString[res["Nodes"]] <> " nodes, graph " <>
      res["GraphId"] <> ". Press Sync again to align the talks"]];
  iSWStatusClearLater[nb];
  res];

iSWS2KSlidesSourceQ[nb_] := TrueQ[Quiet[iSWBuildSourceMode[Lookup[SlideGraphSpec[nb], "Source", ""]] === "Slides"]];

(* \:300cKG\:69cb\:7bc9\:300d: Source: \:30b9\:30e9\:30a4\:30c9 \:306e\:30c7\:30c3\:30ad\:306f\:30b9\:30e9\:30a4\:30c9\:304b\:3089\:5199\:3057\:76f4\:3059 (\:63a8\:6572\:3067\:8db3\:3055\:308c\:305f\:9805\:76ee\:3068\:5468\:8fba\:77e5\:8b58\:306f\:6b8b\:3059) *)
iSWS2KRefreshAction[nb_NotebookObject] := Module[{res},
  iSWStatus[nb, iSL["\:30b9\:30e9\:30a4\:30c9\:304b\:3089\:77e5\:8b58\:30b0\:30e9\:30d5\:3092\:5199\:3057\:76f4\:3057\:3066\:3044\:307e\:3059\:2026", "Re-mirroring the knowledge graph from the slides..."]];
  res = SlideGraphFromSlides[nb, "Refresh" -> True];
  iSWStatus[nb, If[FailureQ[res], ToString[Lookup[Last[res], "MessageTemplate", res]],
    iSL["\:30b9\:30e9\:30a4\:30c9\:304b\:3089\:5199\:3057\:76f4\:3057\:307e\:3057\:305f: " <> ToString[res["Nodes"]] <> " \:30ce\:30fc\:30c9 (KG \:540d " <> res["GraphId"] <> ")",
      "Re-mirrored from the slides: " <> ToString[res["Nodes"]] <> " nodes (graph " <> res["GraphId"] <> ")"]]];
  iSWStatusClearLater[nb];
  res];

