iSWPosterLine[line0_String] := Module[{line, m, k, v, lk, n},
  line = StringReplace[line0, (" " | "\t") ~~ "#" ~~ ___ ~~ EndOfString -> ""];
  m = StringCases[line, StartOfString ~~ k0 : Except[":" | "\:ff1a"] .. ~~ (":" | "\:ff1a") ~~ v0___ ~~ EndOfString :>
    {StringTrim[k0], StringTrim[v0]}, 1];
  If[m === {}, Return[None]];
