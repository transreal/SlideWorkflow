iSWReadingCheckPrompt[talks_List, known_List] :=
  "\:3042\:306a\:305f\:306f\:65e5\:672c\:8a9e\:306e\:97f3\:58f0\:5408\:6210\:306e\:6821\:6b63\:4fc2\:3067\:3059\:3002\:4e0b\:306e\:767a\:8868\:539f\:7a3f\:3092\:97f3\:58f0 (gpt-realtime \:306e\:3088\:3046\:306a LLM \:306e\:97f3\:58f0\:30e2\:30c7\:30eb\:3084\:97f3\:58f0\:5408\:6210\:30a8\:30f3\:30b8\:30f3) \:3067\:8aad\:307f\:4e0a\:3052\:308b\:3068\:304d\:3001" <>
  "\:6f22\:5b57\:306e\:8aad\:307f\:3092\:9593\:9055\:3048\:3084\:3059\:3044\:8a9e\:3092\:9078\:3073\:3001\:6b63\:3057\:3044\:8aad\:307f\:3092\:793a\:3057\:3066\:304f\:3060\:3055\:3044\:3002\n\n" <>
  "\:9078\:3076\:8a9e:\n" <>
  "- \:5c02\:9580\:7528\:8a9e (\:7269\:7406\:30fb\:6570\:5b66\:30fb\:5de5\:5b66\:306a\:3069\:3002\:4f8b: \:97f3\:5834=\:304a\:3093\:3070\:3001\:529b\:5834=\:308a\:304d\:3070\:3001\:632f\:5e45=\:3057\:3093\:3077\:304f\:3001K\:6bbb=\:30b1\:30fc\:304b\:304f\:3001\:4fc2\:6570=\:3051\:3044\:3059\:3046)\n" <>
  "- \:540c\:3058\:5b57\:3067\:8aad\:307f\:304c\:5909\:308f\:308a\:3001\:8aa4\:8aad\:3057\:3084\:3059\:3044\:8a9e (\:4f8b: \:624b\:9320=\:3066\:3058\:3087\:3046 \:3092\:300c\:3057\:3085\:3058\:3087\:3046\:300d\:3068\:8aa4\:8aad\:3057\:3084\:3059\:3044)\:3002" <>
  "\:6587\:8108\:3067\:8aad\:307f\:304c\:5909\:308f\:308b 1\:301c2 \:6587\:5b57\:306e\:8a9e (\:7bc0\:30fb\:8179\:30fb\:5834\:30fb\:76f8\:30fb\:6bbb \:306a\:3069) \:306f\:3001\:539f\:7a3f\:306e\:4e2d\:306e\:524d\:5f8c\:3092\:542b\:3081\:305f\:53e5\:3067\:66f8\:304f (\:4f8b: \:5b9a\:5e38\:6ce2\:306e\:7bc0=\:3066\:3044\:3058\:3087\:3046\:306f\:306e\:3075\:3057)\n" <>
  "- \:4eba\:540d\:30fb\:5730\:540d\:30fb\:793e\:540d\:30fb\:88fd\:54c1\:540d\:306a\:3069\:3001\:8aad\:307f\:304c\:4e00\:3064\:306b\:6c7a\:307e\:3089\:306a\:3044\:56fa\:6709\:540d\:8a5e\:3068\:3001\:65e5\:672c\:8a9e\:3067\:306e\:8aad\:307f\:65b9\:304c\:6c7a\:307e\:3063\:3066\:3044\:308b\:82f1\:5b57\:306e\:7565\:8a9e\n" <>
  "\:9078\:3070\:306a\:3044\:8a9e: \:666e\:901a\:306e\:8a9e\:3067\:8aad\:307f\:9593\:9055\:3048\:306b\:304f\:3044\:3082\:306e\:3002\:82f1\:8a9e\:306e\:8a9e\:53e5\:305d\:306e\:3082\:306e (\:82f1\:8a9e\:3068\:3057\:3066\:8aad\:3081\:3070\:3088\:3044\:3082\:306e)\:3002\n\n" <>
  "\:8aad\:307f\:306f\:3072\:3089\:304c\:306a\:3067\:66f8\:304f (\:5916\:6765\:8a9e\:30fb\:82f1\:5b57\:306e\:90e8\:5206\:306f\:30ab\:30bf\:30ab\:30ca\:3067\:3088\:3044)\:3002\:6f22\:5b57\:3092\:6b8b\:3055\:306a\:3044\:3002\n" <>
  "Word \:306b\:306f\:539f\:7a3f\:306b\:51fa\:3066\:304f\:308b\:8868\:8a18\:3092\:4e00\:5b57\:4e00\:53e5\:305d\:306e\:307e\:307e\:66f8\:304f\:3002\n\n" <>
  If[known === {}, "", "\:767b\:9332\:6e08\:307f\:306a\:306e\:3067\:6319\:3052\:306a\:3044\:8a9e: " <> StringRiffle[First /@ known, "\:3001"] <> "\n\n"] <>
  "=== \:539f\:7a3f ===\n" <>
  StringRiffle[Map[Function[t, "--- \:30b9\:30e9\:30a4\:30c9 " <> ToString[t["Slide"]] <> ": " <> iSWQAOneLine[t["Title"]] <> "\n" <>
    StringTake[t["Talk"], UpTo[3000]]], talks], "\n\n"] <>
  "\n\n\:51fa\:529b (\:53b3\:5b88): JSON \:30aa\:30d6\:30b8\:30a7\:30af\:30c8 1 \:3064\:3060\:3051\:3002\:8aac\:660e\:6587\:30fb\:30b3\:30fc\:30c9\:30d5\:30a7\:30f3\:30b9\:7121\:3057:\n" <>
  "{\"Readings\": [{\"Word\": \"\:539f\:7a3f\:306e\:8868\:8a18\", \"Reading\": \"\:3088\:307f\", \"Slide\": <\:756a\:53f7>, \"Why\": \"\:77ed\:3044\:7406\:7531\"}]}\n" <>
  "\:8aad\:307f\:9593\:9055\:3048\:3084\:3059\:3044\:8a9e\:304c\:7121\:3051\:308c\:3070 {\"Readings\": []}";

iSWReadingCheckParse[resp_, talks_List, known_List] := Module[{json, d, rows, all, kk = First /@ known},
  all = StringRiffle[Lookup[talks, "Talk", ""], "\n"];
  json = If[StringQ[resp] && ! StringStartsQ[resp, "Error" | "[ERROR]"], iSWRefineExtractJSON[resp], $Failed];
  d = If[StringQ[json], Quiet @ Check[Developer`ReadRawJSONString[json], $Failed], $Failed];
  rows = If[AssociationQ[d], Replace[Lookup[d, "Readings", {}], Except[_List] -> {}], {}];
  rows = Cases[rows, r_Association :> <|
    "Word" -> StringTrim[ToString[Lookup[r, "Word", ""]]],
    "Reading" -> StringTrim[StringReplace[ToString[Lookup[r, "Reading", ""]], Whitespace -> ""]],
    "Slide" -> Lookup[r, "Slide", None],
    "Why" -> StringTrim[StringReplace[ToString[Lookup[r, "Why", ""]], {"\n" -> " ", "#" -> ""}]]|>];
  Select[rows, #["Word"] =!= "" && #["Reading"] =!= "" && #["Word"] =!= #["Reading"] &&
    StringContainsQ[all, #["Word"]] && ! MemberQ[kk, #["Word"]] && ! iSWHasKanjiQ[#["Reading"]] &&
    ! StringContainsQ[#["Word"], "=" | "#"] &]];

(* \:8aad\:307f\:30bb\:30eb\:3078\:66f8\:304d\:8db3\:3059\:3002\:8aad\:307f\:30bb\:30eb\:304c\:7121\:3051\:308c\:3070\:6307\:793a\:30bb\:30eb\:306e\:5f8c (\:7121\:3051\:308c\:3070\:6700\:521d\:306e\:30b9\:30e9\:30a4\:30c9\:306e\:524d) \:306b\:4f5c\:308b *)
iSWReadingAppendToDeck[nb_NotebookObject, text_String] := Module[{cs, anchor},
  Quiet[SlideEnsureDeckStyles[nb]];
  cs = Quiet[Cells[nb, CellStyle -> "SlideReading"]];
  If[ListQ[cs] && cs =!= {},
    With[{cur = StringTrim[iSWMetaCellText[NotebookRead[First[cs]]]]},
      NotebookWrite[First[cs], Cell[If[cur === "", text, cur <> "\n" <> text], "SlideReading"], None]],
    anchor = Quiet[Cells[nb, CellStyle -> "Directive"]];
    Which[
      ListQ[anchor] && anchor =!= {}, SelectionMove[Last[anchor], After, Cell],
      ListQ[anchor = Quiet[Cells[nb, CellStyle -> "SlideShowNavigationBar"]]] && anchor =!= {},
        SelectionMove[First[anchor], Before, Cell],
      True, SelectionMove[nb, After, Notebook]];
    NotebookWrite[nb, Cell[iSWReadingCellTemplate[] <> text, "SlideReading"]]];
  True];

SlideReadingCheck[] := With[{nb = iSWNotebook[]}, If[nb === $Failed, $Failed, SlideReadingCheck[nb]]];
SlideReadingCheck[nb_NotebookObject] := Module[{outline, n, talks, known, batches},
  If[! iSWRequireLLM[], Return[$Failed]];
  If[iSWReadingCheckBusyQ[],
    iSWStatus[nb, iSL["\:8aad\:307f\:30c1\:30a7\:30c3\:30af\:306e\:6700\:4e2d\:3067\:3059\:3002\:7d42\:308f\:308b\:307e\:3067\:5f85\:3063\:3066\:304f\:3060\:3055\:3044", "Checking readings; wait until it finishes"]];
    Return[<|"Status" -> "Busy"|>]];
  outline = iTalkDeckOutline[iSWDeckTextSource[nb]];
  If[outline === $Failed,
    iSWStatus[nb, iSL["\:30b9\:30e9\:30a4\:30c9\:304c\:898b\:3064\:304b\:308a\:307e\:305b\:3093", "No slides found"]]; iSWStatusClearLater[nb];
    Return[$Failed]];
  n = outline["Count"];
  talks = Select[Table[<|"Slide" -> i, "Title" -> outline["Titles"][[i]],
      "Talk" -> StringTrim[ToString[outline["Talks"][[i]]]]|>, {i, n}],
    #["Talk"] =!= "" && iSWJaTextQ[#["Talk"]] &];
  If[talks === {},
    iSWStatus[nb, iSL["\:65e5\:672c\:8a9e\:306e\:539f\:7a3f (\:30c8\:30fc\:30af\:30bb\:30eb) \:304c\:3042\:308a\:307e\:305b\:3093", "No Japanese talks found"]]; iSWStatusClearLater[nb];
    Return[<|"Status" -> "NoTalk"|>]];
  known = Replace[Quiet[iSWReadingRules[nb]], Except[_List] -> {}];
  batches = Partition[talks, UpTo[$iSWReadingCheckBatch]];
  $iSWReadingCheckRun = <|"Busy" -> True, "Since" -> AbsoluteTime[], "Found" -> <||>, "Failed" -> 0|>;
  iSWReadingCheckChain[nb, <|"Batches" -> batches, "Known" -> known|>, 1];
  <|"Status" -> "Submitted", "Slides" -> Length[talks], "Batches" -> Length[batches]|>];

iSWReadingCheckChain[nb_, ctx_Association, idx_Integer] := If[idx > Length[ctx["Batches"]],
  iSWReadingCheckFinish[nb],
  Module[{talks = ctx["Batches"][[idx]], known, prompt},
    $iSWReadingCheckRun["Since"] = AbsoluteTime[];
    iSWStatus[nb, iSL["\:8aad\:307f\:30c1\:30a7\:30c3\:30af " <> ToString[idx] <> "/" <> ToString[Length[ctx["Batches"]]] <> "\[Ellipsis]",
      "Checking readings " <> ToString[idx] <> "/" <> ToString[Length[ctx["Batches"]]] <> "..."]];
    known = Join[ctx["Known"], KeyValueMap[#1 -> #2["Reading"] &, $iSWReadingCheckRun["Found"]]];
    prompt = iSWReadingCheckPrompt[talks, known];
    With[{n2 = nb, c = ctx, i2 = idx, t2 = talks, k2 = known},
      NBAccess`$NBLLMQueryFunc[prompt,
        Function[resp, Module[{rows = iSWReadingCheckParse[resp, t2, k2]},
          If[! StringQ[resp] || StringStartsQ[resp, "Error" | "[ERROR]"],
            $iSWReadingCheckRun["Failed"] = $iSWReadingCheckRun["Failed"] + 1];
          Do[If[! KeyExistsQ[$iSWReadingCheckRun["Found"], r["Word"]],
              $iSWReadingCheckRun["Found"] = Append[$iSWReadingCheckRun["Found"], r["Word"] -> r]],
            {r, rows}];
          iSWReadingCheckChain[n2, c, i2 + 1]]],
        n2, Fallback -> iSWFallback[]]]]];

iSWReadingCheckFinish[nb_] := Module[{rows = Values[$iSWReadingCheckRun["Found"]], failed = $iSWReadingCheckRun["Failed"], text},
  $iSWReadingCheckRun["Busy"] = False;
  If[rows === {},
    iSWGraphApplyNote[nb, If[failed > 0,
      iSL["\:8aad\:307f\:30c1\:30a7\:30c3\:30af: LLM \:306e\:5fdc\:7b54\:3092\:8aad\:3081\:307e\:305b\:3093\:3067\:3057\:305f (" <> ToString[failed] <> " \:56de)\:3002\:3082\:3046\:4e00\:5ea6\:62bc\:3057\:3066\:304f\:3060\:3055\:3044",
        "Reading check: could not read the LLM reply (" <> ToString[failed] <> "); try again"],
      iSL["\:8aad\:307f\:30c1\:30a7\:30c3\:30af: \:8aad\:307f\:9593\:9055\:3048\:3084\:3059\:3044\:8a9e\:306f\:898b\:3064\:304b\:308a\:307e\:305b\:3093\:3067\:3057\:305f", "Reading check: no words likely to be misread"]]];
    Return[<|"Status" -> "None", "Failed" -> failed|>]];
  text = "# \:8aad\:307f\:30c1\:30a7\:30c3\:30af " <> DateString[{"Year", "-", "Month", "-", "Day", " ", "Hour", ":", "Minute"}] <>
    " \:306e\:6848 (\:78ba\:304b\:3081\:3066\:3001\:8981\:3089\:306a\:3044\:884c\:306f\:6d88\:3059\:304b\:5148\:982d\:306b # \:3092\:4ed8\:3051\:308b)\n" <>
    StringRiffle[Map[Function[r, r["Word"] <> " = " <> r["Reading"] <>
      If[IntegerQ[r["Slide"]] || r["Why"] =!= "",
        "\t# " <> If[IntegerQ[r["Slide"]], iSL["\:30b9\:30e9\:30a4\:30c9 ", "slide "] <> ToString[r["Slide"]] <> If[r["Why"] =!= "", ": ", ""], ""] <> r["Why"],
        ""]], rows], "\n"];
  Quiet @ Check[iSWReadingAppendToDeck[nb, text], Null];
  iSWGraphApplyNote[nb, iSL["\:8aad\:307f\:30c1\:30a7\:30c3\:30af: " <> ToString[Length[rows]] <> " \:8a9e\:306e\:8aad\:307f\:306e\:6848\:3092\:8aad\:307f\:30bb\:30eb\:306b\:66f8\:304d\:307e\:3057\:305f\:3002\:78ba\:304b\:3081\:3066\:304b\:3089\:518d\:751f\:3057\:3066\:304f\:3060\:3055\:3044" <>
      If[failed > 0, " (\:5fdc\:7b54\:3092\:8aad\:3081\:306a\:304b\:3063\:305f\:56de " <> ToString[failed] <> ")", ""],
    "Reading check: wrote " <> ToString[Length[rows]] <> " suggested readings to the readings cell; review them before playing"]];
  <|"Status" -> "Written", "Words" -> Length[rows], "Failed" -> failed|>];

(* ---- \:5408\:6210 (\:30ad\:30e3\:30c3\:30b7\:30e5\:4ed8\:304d) ---- *)

iSWVoiceCacheDir[nb_] := Module[{dir, base},
  {dir, base} = iSWDeckBaseName[nb];
  FileNameJoin[{dir, base <> "_voice"}]];

iSWVoiceCacheFile[dir_String, n_Integer, voice_String, text_String] :=
  FileNameJoin[{dir,
    "slide-" <> IntegerString[n, 10, 3] <> "-" <>
      StringReplace[voice, Except[WordCharacter | "-" | "_"] -> "_"] <> "-" <>
      StringTake[Hash[{voice, text}, "SHA256", "HexString"], 8] <> ".wav"}];

