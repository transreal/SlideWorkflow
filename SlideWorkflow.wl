  $iSWPlayState["Record"] = TrueQ[OptionValue["Record"]];
  If[engine === "Realtime",
    (* v1.52: \:62bc\:3057\:305f\:3068\:304d\:306e\:300c\:5fdc\:7b54on/off\:300d\:306b\:5f93\:3046 ($SlidePlayAnswering)\:3002off \:306a\:3089\:8aad\:307f\:4e0a\:3052\:3060\:3051 *)
    (* v1.59: \:9332\:97f3\:306e\:3068\:304d\:306f\:8cea\:554f\:3092\:53d7\:3051\:306a\:3044 (\:8aad\:307f\:4e0a\:3052\:3060\:3051) *)
    $iSWPlayState["Answering"] = If[TrueQ[OptionValue["Record"]], False, iSWPlayWantsAnswering[]];
    $iSWPlayState["MutedUserBridge"] = False;
