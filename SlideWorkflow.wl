(* ---- \:8aad\:307f\:30c1\:30a7\:30c3\:30af: \:539f\:7a3f\:3092 LLM \:306b\:898b\:305b\:3001\:8aad\:307f\:9593\:9055\:3048\:3084\:3059\:3044\:8a9e\:3068\:8aad\:307f\:306e\:6848\:3092\:8aad\:307f\:30bb\:30eb\:306b\:66f8\:304d\:8db3\:3059 ---- *)
$iSWReadingCheckBatch = 20;
