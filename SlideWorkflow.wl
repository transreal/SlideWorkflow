iSWCleanRows[rows_] := Module[{rs, w},
  rs = Select[Replace[rows, Except[_List] -> {}], ListQ];
  rs = Map[Function[r, Map[Function[c, With[{s = StringTrim[Which[StringQ[c], c, NumericQ[c], ToString[c], True, ""]]},
