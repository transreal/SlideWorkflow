$iSWRelatedLast = None;
iSWRelatedApply[nb_, gid_String, resp_, web_, maxC_Integer, then_, pl_] := Module[{qs, rows = {}, merged, kg, saved},
  $iSWRefineBusy = False;
  qs = iSWRelatedQueries[resp];
  Do[
