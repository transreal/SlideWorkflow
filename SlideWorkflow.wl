iSWPosterDeckData[src_] := Module[{nbExpr, data, sd, recs, path},
  path = Which[StringQ[src], src, Head[src] === NotebookObject, Quiet[NotebookFileName[src]], True, None];
  nbExpr = Quiet @ Check[iAsNotebook[Replace[src, nbo_NotebookObject :> iSWDeckSource[nbo]]], $Failed];
  If[Head[nbExpr] =!= Notebook, Return[$Failed]];
  data = Quiet @ Check[iSlideSplit[nbExpr, iFlattenVisibleCells], $Failed];
  If[! AssociationQ[data], Return[$Failed]];
  sd = FirstCase[data["Options"], HoldPattern[StyleDefinitions -> s_] :> s, $SlideStyleDefinitions];
  recs = MapIndexed[Function[{cells, i},
    Module[{tc = iSWPosterTitleCell[cells], title = "", node = None, crumb, deckTitle = iSWPosterDeckTitleText[cells]},
      (* KGNode (\:751f\:6210\:3057\:305f\:679a) \:304b KGSync (\:624b\:4f5c\:308a\:30fb\:904e\:53bb\:306e\:30c7\:30c3\:30ad\:306e\:679a\:3001v1.58) *)
      If[tc =!= None, title = StringTrim[iSWSlideCellText[tc]];
        node = With[{tg = iSWPosterCellTags[tc]}, Replace[iSWKGNodeOfTags[tg], None :> iSWSyncNodeOfTags[tg]]]];
      crumb = With[{c = SelectFirst[cells, MatchQ[#, Cell[_, "SlideCrumb", ___]] &, None]},
        If[c === None, "", StringTrim[iSWSlideCellText[c]]]];
      <|"Slide" -> First[i], "Title" -> title, "Node" -> node, "Crumb" -> crumb,
        (* v1.58: \:984c\:76ee\:30bb\:30eb\:304c\:7a7a\:306e\:679a\:3082\:8868\:7d19 (\:904e\:53bb\:306e\:30c7\:30c3\:30ad\:306e\:8868\:7d19\:306f\:30bf\:30a4\:30c8\:30eb\:7528\:306e\:5927\:304d\:306a\:5b57\:3092\:4f7f\:308f\:306a\:3044) *)
        "TitleSlide" -> (title === "" && (deckTitle =!= "" || tc =!= None)), "DeckTitle" -> deckTitle,
        "HasFigure" -> AnyTrue[cells, iVisualCellQ], "Cells" -> cells|>]], data["Slides"]];
  <|"Slides" -> recs, "StyleDefinitions" -> sd, "Path" -> If[StringQ[path], path, None]|>];

(* ---- KG \:306e\:90e8 ---- *)
iSWPosterTree[kg_Association] := Quiet @ Check[
  If[TrueQ[SourceVault`SourceVaultKGTocQ[kg]], SourceVault`SourceVaultKGTocTree[kg], SourceVault`SourceVaultKGOrderedTree[kg]], $Failed];
(* \:6839\:306e\:76f4\:4e0b\:306e\:7956\:5148 (\:90e8)\:3002\:6839\:81ea\:8eab\:3068\:6728\:306b\:7121\:3044\:30ce\:30fc\:30c9\:306f None *)
iSWPosterPartOf[tree_Association, id_] := Module[{x = id, root = tree["Root"], parent = tree["Parent"], guard = 0},
  If[! StringQ[x] || x === root || ! KeyExistsQ[parent, x], Return[None]];
  While[KeyExistsQ[parent, x] && parent[x] =!= root && guard < 500, x = parent[x]; guard++];
  If[KeyExistsQ[parent, x] && parent[x] === root, x, None]];
iSWPosterAncestorUnder[tree_Association, id_, top_] := Module[{x = id, parent = tree["Parent"], guard = 0},
  If[! StringQ[x], Return[None]];
  If[x === top, Return[top]];
  While[KeyExistsQ[parent, x] && parent[x] =!= top && guard < 500, x = parent[x]; guard++];
  If[KeyExistsQ[parent, x] && parent[x] === top, x, None]];
iSWPosterDescendants[tree_Association, id_] := Module[{out = {}, stack = {id}, x, guard = 0},
  While[stack =!= {} && guard < 5000, guard++; x = First[stack]; stack = Rest[stack]; AppendTo[out, x];
    stack = Join[Lookup[tree["Children"], x, {}], stack]];
  out];
iSWPosterGist[n_Association, lang_] := SelectFirst[Map[SourceVault`SourceVaultKGText[n, #, lang] &, {"Gist", "Summary", "Role", "Lead"}],
  StringQ[#] && StringTrim[#] =!= "" &, ""];
iSWPosterGist[___] := "";
iSWPosterNewBlock[id_, title_, gist_, nodes_, slides_] :=
  <|"Id" -> id, "Ids" -> {id}, "Title" -> title, "Gist" -> gist, "Nodes" -> nodes, "Slides" -> slides|>;

(* \:90e8\:306b\:7d50\:3070\:308c\:306a\:3044\:679a\:306f\:3001\:30c7\:30c3\:30ad\:9806\:3067\:76f4\:524d\:306e (\:7121\:3051\:308c\:3070\:6700\:521d\:306e) \:30d6\:30ed\:30c3\:30af\:3078 *)
iSWPosterAttachLoose[blocks_List, r_Association] := Module[{b = blocks, k},
  If[b === {}, Return[{iSWPosterNewBlock["blk1", r["Title"], "", {}, {r}]}]];
  k = SelectFirst[Reverse[Range[Length[b]]], Max[Lookup[b[[#, "Slides"]], "Slide", 0]] < r["Slide"] &, 1];
  b[[k, "Slides"]] = SortBy[Append[b[[k, "Slides"]], r], #["Slide"] &];
  b];

iSWPosterBlocksFromKG[recs_List, ctx_Association] := Module[{tree = ctx["Tree"], index = ctx["Index"], lang = ctx["Lang"], root, parts,
    groups = <||>, loose = {}, skipped = {}, blocks},
  root = tree["Root"];
  parts = Lookup[tree["Children"], root, {}];
  Do[Module[{n = r["Node"], p},
      Which[
        TrueQ[r["TitleSlide"]], Null,
        StringQ[n] && (n === root || n === "agenda" || StringStartsQ[n, "glossary"]), AppendTo[skipped, r["Slide"]],
        True, p = If[StringQ[n], iSWPosterPartOf[tree, n], None];
          If[p === None, AppendTo[loose, r], groups[p] = Append[Lookup[groups, p, {}], r]]]],
    {r, recs}];
  blocks = Map[Function[p, With[{n = Lookup[index, p, <||>]},
    iSWPosterNewBlock[p, SourceVault`SourceVaultKGText[n, "Label", lang], iSWPosterGist[n, lang],
      iSWPosterDescendants[tree, p], Lookup[groups, p, {}]]]], parts];
  blocks = Select[blocks, #["Slides"] =!= {} &];
  (* \:90e8\:81ea\:8eab\:306e\:679a (\:9053\:6a19 = \:5b50\:306e\:984c\:76ee\:306e\:4e00\:89a7) \:306f\:3001\:307b\:304b\:306b\:679a\:304c\:3042\:308c\:3070\:30d6\:30ed\:30c3\:30af\:306e\:984c\:76ee\:3067\:8db3\:308a\:308b\:306e\:3067\:6570\:3048\:306a\:3044 (\:4f75\:5408\:30fb\:5206\:5272\:306e\:679a\:6570\:306b\:3082\:5165\:308c\:306a\:3044) *)
  blocks = Map[Function[b, With[{body = Select[b["Slides"], #["Node"] =!= b["Id"] &]}, If[body =!= {}, Append[b, "Slides" -> body], b]]], blocks];
  Do[blocks = iSWPosterAttachLoose[blocks, r], {r, loose}];
  <|"Blocks" -> blocks, "Skipped" -> skipped, "Loose" -> Lookup[loose, "Slide", {}]|>];

(* KG \:306e\:7121\:3044\:30c7\:30c3\:30ad: \:30d1\:30f3\:304f\:305a\:300c\:7b2ck\:90e8 \:2026\:300d\:3067\:675f\:306d\:3001\:7121\:3051\:308c\:3070 per \:679a\:305a\:3064\:7b49\:5206 *)
iSWPosterCrumbKey[r_Association] := With[{c = Lookup[r, "Crumb", ""]},
  If[StringQ[c] && c =!= "", StringTrim[First[StringSplit[c, " \:203a " | " > " | "\:203a"]]], ""]];
iSWPosterBlocksFromCrumbs[recs_List] := Module[{body = Select[recs, ! TrueQ[#["TitleSlide"]] &], keys, groups},
  If[body === {} || AllTrue[body, iSWPosterCrumbKey[#] === "" &], Return[None]];
  keys = DeleteDuplicates[iSWPosterCrumbKey /@ body];
  groups = GroupBy[body, iSWPosterCrumbKey];
  MapIndexed[iSWPosterNewBlock["blk" <> ToString[First[#2]], If[#1 === "", groups[#1][[1, "Title"]], #1], "", {}, groups[#1]] &, keys]];
iSWPosterBlocksEven[recs_List, per_Integer] := With[{body = Select[recs, ! TrueQ[#["TitleSlide"]] &]},
  MapIndexed[iSWPosterNewBlock["blk" <> ToString[First[#2]], #1[[1, "Title"]], "", {}, #1] &, Partition[body, UpTo[Max[1, per]]]]];

(* ---- \:30d6\:30ed\:30c3\:30af\:6570\:306e\:8abf\:6574: \:591a\:3051\:308c\:3070\:96a3\:3069\:3046\:3057\:3092\:4f75\:5408\:3001\:5c11\:306a\:3051\:308c\:3070\:76ee\:6b21\:306e\:5b50\:306e\:5883\:3067\:5272\:308b ----
   \:3069\:3061\:3089\:3082\:300c\:4e26\:3073\:3092\:5d29\:3055\:305a\:3001\:679a\:6570\:306e\:6700\:5927\:304c\:6700\:5c0f\:306b\:306a\:308b\:9023\:7d9a\:3057\:305f k \:7d44\:300d(\:7dda\:5f62\:5206\:5272\:306e DP) \:3067\:6c7a\:3081\:308b\:3002\:8caa\:6b32\:306b\:5c0f\:3055\:3044\:7d44\:3092\:8db3\:3059\:3068\:9023\:9396\:3057\:3066\:504f\:308b *)
iSWPosterPartition[sizes_List, k_Integer] := Module[{n = Length[sizes], pre, cost, cut, best, p, bounds = {}, end},
  If[n === 0, Return[{}]];
  If[k >= n, Return[Table[{i, i}, {i, n}]]];
  If[k <= 1, Return[{{1, n}}]];
  pre = Prepend[Accumulate[N[sizes]], 0.];
  cost = ConstantArray[Infinity, {n + 1, k + 1}]; cut = ConstantArray[0, {n + 1, k + 1}];
  Do[cost[[i + 1, 2]] = pre[[i + 1]], {i, 0, n}];
  Do[Do[best = Infinity;
      Do[With[{c = Max[cost[[p + 1, j]], pre[[i + 1]] - pre[[p + 1]]]}, If[c < best, best = c; cut[[i + 1, j + 1]] = p]], {p, j - 1, i - 1}];
      cost[[i + 1, j + 1]] = best, {i, j, n}], {j, 2, k}];
  end = n;
  Do[p = cut[[end + 1, j + 1]]; PrependTo[bounds, {p + 1, end}]; end = p, {j, k, 2, -1}];
  PrependTo[bounds, {1, end}];
  bounds];
iSWPosterMergeTwo[a_Association, c_Association] := <|"Id" -> a["Id"], "Ids" -> Join[a["Ids"], c["Ids"]],
  "Title" -> a["Title"] <> " / " <> c["Title"], "Gist" -> If[a["Gist"] =!= "", a["Gist"], c["Gist"]],
  "Nodes" -> Join[a["Nodes"], c["Nodes"]], "Slides" -> Join[a["Slides"], c["Slides"]]|>;
iSWPosterMergeBlocks[blocks_List, target_Integer] := Module[{bounds},
  If[Length[blocks] <= target || target < 1, Return[blocks]];
  bounds = iSWPosterPartition[Map[Max[1, Length[#["Slides"]]] &, blocks], target];
  Map[Fold[iSWPosterMergeTwo, blocks[[#[[1]]]], blocks[[#[[1]] + 1 ;; #[[2]]]]] &, bounds]];
(* \:30d6\:30ed\:30c3\:30af\:306e\:679a\:3092\:3001\:90e8\:306e\:76f4\:4e0b\:306e\:5b50\:3054\:3068\:306e\:9023\:7d9a\:3057\:305f\:4e26\:3073 (run) \:306b\:5206\:3051\:308b\:3002\:5b50\:306e\:7121\:3044\:679a (\:90e8\:81ea\:8eab\:306e\:9053\:6a19\:306a\:3069) \:306f\:76f4\:524d\:306e run \:3078 *)
iSWPosterRuns[blk_Association, ctx_Association] := Module[{slides = blk["Slides"], tree = ctx["Tree"], keys, runs = {}, cur = None},
  keys = If[AssociationQ[tree] && KeyExistsQ[tree["Children"], blk["Id"]],
    Map[With[{a = iSWPosterAncestorUnder[tree, #["Node"], blk["Id"]]}, If[a === blk["Id"], None, a]] &, slides],
    ConstantArray[None, Length[slides]]];
  Do[Module[{k = keys[[i]]},
      If[k =!= None && k =!= cur, cur = k; AppendTo[runs, {k, {}}]];
      If[runs === {}, AppendTo[runs, {None, {}}]];
      runs[[-1, 2]] = Append[runs[[-1, 2]], slides[[i]]]],
    {i, Length[slides]}];
  If[Length[runs] >= 2, runs, Map[{None, #} &, Partition[slides, UpTo[Max[1, Ceiling[Length[slides]/2]]]]]]];
(* 1 \:30d6\:30ed\:30c3\:30af\:3092 k \:500b\:306b\:5272\:308b: run \:3092\:9023\:7d9a\:3057\:305f k \:7d44\:306b (\:7dda\:5f62\:5206\:5272)\:30021 run \:3060\:3051\:306e\:7d44\:306f\:5b50\:306e\:984c\:76ee\:30fb\:4e00\:884c\:8981\:7d04\:30fb\:90e8\:5206\:6728\:3092\:6301\:3061\:3001\:8907\:6570\:306a\:3089\:300c\:984c\:76ee (j)\:300d *)
iSWPosterSplitOne[blk_Association, k_Integer, ctx_Association] := Module[{runs, bounds, tree = ctx["Tree"], mk},
  If[Length[blk["Slides"]] < 2 || k < 2, Return[{blk}]];
  runs = iSWPosterRuns[blk, ctx];
  If[Length[runs] < 2, Return[{blk}]];
  bounds = iSWPosterPartition[Map[Length[#[[2]]] &, runs], Min[k, Length[runs]]];
  mk[{a_, b_}, j_] := Module[{rs = runs[[a ;; b]], key, n},
    key = If[a === b && StringQ[rs[[1, 1]]], rs[[1, 1]], None];
    n = If[StringQ[key], Lookup[ctx["Index"], key, <||>], <||>];
    iSWPosterNewBlock[If[StringQ[key], key, blk["Id"] <> "_" <> ToString[j]],
      If[StringQ[key] && SourceVault`SourceVaultKGText[n, "Label", ctx["Lang"]] =!= "", SourceVault`SourceVaultKGText[n, "Label", ctx["Lang"]],
        blk["Title"] <> " (" <> ToString[j] <> ")"],
      If[StringQ[key], iSWPosterGist[n, ctx["Lang"]], If[j === 1, blk["Gist"], ""]],
      If[AssociationQ[tree], Flatten[Map[If[StringQ[#[[1]]], iSWPosterDescendants[tree, #[[1]]], {}] &, rs]], {}],
      Flatten[rs[[All, 2]], 1]]];
  MapIndexed[mk[#1, First[#2]] &, bounds]];
iSWPosterSplitBlocks[blocks_List, target_Integer, ctx_Association] := Module[{b = blocks, order, done = False, guard = 0, need},
  While[(need = target - Length[b]) > 0 && ! done && guard < 60, guard++;
    done = True;
    order = Ordering[-Map[Length[#["Slides"]] &, b]];
    Do[With[{parts = iSWPosterSplitOne[b[[k]], need + 1, ctx]},
        If[Length[parts] >= 2, b = Join[b[[;; k - 1]], parts, b[[k + 1 ;;]]]; done = False; Break[]]],
      {k, order}]];
  b];

(* ---- \:30d6\:30ed\:30c3\:30af\:306e\:679a (\:30d1\:30cd\:30eb) \:306e\:9078\:629e: \:5fc5\:305a\:51fa\:3059 > \:56f3\:306e\:3042\:308b\:679a > \:91cd\:8981\:5ea6 > \:30c7\:30c3\:30ad\:9806\:3002\:5916\:3057\:305f\:679a\:306f Folded ---- *)
iSWPosterNodeOf[ctx_Association, r_Association] := Lookup[ctx["Index"], Replace[r["Node"], Except[_String] -> ""], <||>];
iSWPosterPanelScore[ctx_Association, r_Association, blk_Association] := With[{n = iSWPosterNodeOf[ctx, r]},
  {If[TrueQ[Lookup[n, "Pinned", False]], 3., 0.] + If[TrueQ[r["HasFigure"]], 2., 0.] +
     Replace[Lookup[n, "Importance", 0.5], Except[_?NumericQ] -> 0.5] -
     If[r["Node"] === blk["Id"], 1.5, 0.], -r["Slide"]}];   (* \:90e8\:81ea\:8eab\:306e\:679a (\:9053\:6a19) \:306f\:5f8c\:56de\:3057 *)
iSWPosterPanelReason[ctx_Association, r_Association] := With[{n = iSWPosterNodeOf[ctx, r]},
  Which[TrueQ[Lookup[n, "Pinned", False]], "Pinned", TrueQ[r["HasFigure"]], "Figure",
    NumericQ[Lookup[n, "Importance", None]], "Importance", True, "Order"]];
iSWPosterPickPanels[blk_Association, maxP_Integer, ctx_Association] := Module[{slides = blk["Slides"], chosen, folded, rec},
  rec[r_] := <|"Slide" -> r["Slide"], "Node" -> r["Node"], "Title" -> r["Title"], "Reason" -> iSWPosterPanelReason[ctx, r]|>;
  (* \:90e8\:81ea\:8eab\:306e\:679a (\:9053\:6a19 = \:5b50\:306e\:984c\:76ee\:306e\:4e00\:89a7) \:306f\:3001\:307b\:304b\:306b\:679a\:304c\:3042\:308c\:3070\:30d6\:30ed\:30c3\:30af\:306e\:984c\:76ee\:3067\:8db3\:308a\:308b\:306e\:3067\:51fa\:3055\:306a\:3044 *)
  With[{body = Select[slides, #["Node"] =!= blk["Id"] &]}, If[body =!= {}, slides = body]];
  If[Length[slides] <= maxP,
    chosen = slides; folded = {},
    chosen = SortBy[Take[ReverseSortBy[slides, iSWPosterPanelScore[ctx, #, blk] &], maxP], #["Slide"] &];
    folded = Select[slides, ! MemberQ[Lookup[chosen, "Slide"], #["Slide"]] &]];
  Join[blk, <|"Panels" -> Map[rec, chosen], "Folded" -> Map[<|"Slide" -> #["Slide"], "Title" -> #["Title"]|> &, folded]|>]];

(* ---- \:5217 (facet) \:306e\:5272\:308a\:5f53\:3066: Column k: > \:30ce\:30fc\:30c9\:306e Facet > (\:914d\:7f6e\:3067\:8fba\:304b\:3089) ---- *)
iSWPosterBlockMatchesQ[blk_Association, token_String] := Module[{t = ToLowerCase[StringTrim[token]], n},
  If[t === "", Return[False]];
  n = Quiet @ Check[ToExpression[t], $Failed];
  (IntegerQ[n] && n === blk["Index"]) || MemberQ[ToLowerCase /@ blk["Ids"], t] ||
    StringContainsQ[ToLowerCase[blk["Title"]], t]];
iSWPosterFacetIndex[v_, facets_List, nf_Integer] := Which[
  IntegerQ[v] && 1 <= v <= nf, v,
  StringQ[v] && StringTrim[v] =!= "",
    With[{p = FirstPosition[facets, f_String /; ToLowerCase[StringTrim[f]] === ToLowerCase[StringTrim[v]] ||
        StringContainsQ[ToLowerCase[f], ToLowerCase[StringTrim[v]]] || StringContainsQ[ToLowerCase[StringTrim[v]], ToLowerCase[f]], None, {1}, Heads -> False]},
      If[ListQ[p], First[p], With[{n = Quiet @ Check[ToExpression[StringTrim[v]], $Failed]}, If[IntegerQ[n] && 1 <= n <= nf, n, None]]]],
  True, None];
iSWPosterAssignFacets[blocks_List, spec_Association, ctx_Association] := Module[{b = blocks, nf, facets = spec["Facets"], colSpec = spec["Column"]},
  nf = Max[Length[facets], If[spec["Layout"] === "Pairs", spec["Columns"], 0], Max[0, Keys[colSpec]]];
  nf = Min[nf, spec["Columns"]];
  b = Map[Append[#, "Facet" -> None] &, b];
  If[nf < 2, Return[b]];
  Do[
    Do[If[b[[i, "Facet"]] === None && AnyTrue[iSWPosterSplitList[colSpec[k]], iSWPosterBlockMatchesQ[b[[i]], #] &],
        b[[i, "Facet"]] = k], {k, Sort[Select[Keys[colSpec], IntegerQ[#] && 1 <= # <= nf &]]}];
    If[b[[i, "Facet"]] === None,
      With[{f = iSWPosterFacetIndex[Lookup[Lookup[ctx["Index"], b[[i, "Id"]], <||>], "Facet", None], facets, nf]},
        If[IntegerQ[f], b[[i, "Facet"]] = f]]],
    {i, Length[b]}];
  b];

(* ---- \:90e8\:3069\:3046\:3057\:306e\:5bfe\:5fdc (\:8fba\:306e\:91cd\:307f\:306e\:548c) ---- *)
$iSWPosterLinkKinds = {"Contrasts", "LeadsTo", "Derives", "Motivates", "RelatedTo", "Supports", "Explains", "Precedes"};
iSWPosterBlockWeights[blocks_List, kg_] := Module[{sets, edges, w = <||>, kinds = <||>, n = Length[blocks]},
  If[! AssociationQ[kg], Return[<|"Weights" -> <||>, "Kinds" -> <||>|>]];
  sets = Map[Association[Thread[DeleteDuplicates[Join[#["Nodes"], Select[Lookup[#["Slides"], "Node", None], StringQ]]] -> True]] &, blocks];
  edges = Select[Lookup[kg, "Edges", {}], AssociationQ[#] && MemberQ[$iSWPosterLinkKinds, Lookup[#, "EdgeKind", ""]] &];
  Do[Module[{f = e["From"], t = e["To"], wt = Replace[Lookup[e, "Weight", 0.5], Except[_?NumericQ] -> 0.5], bi, bj},
      bi = Select[Range[n], KeyExistsQ[sets[[#]], f] &]; bj = Select[Range[n], KeyExistsQ[sets[[#]], t] &];
      Do[If[i =!= j,
          w[{i, j}] = Lookup[w, Key[{i, j}], 0.] + wt;
          kinds[{i, j}] = Append[Lookup[kinds, Key[{i, j}], {}], e["EdgeKind"]]], {i, bi}, {j, bj}]],
    {e, edges}];
  <|"Weights" -> w, "Kinds" -> kinds|>];
iSWPosterPairWeight[w_Association, i_, j_] := Lookup[w, Key[{i, j}], 0.] + Lookup[w, Key[{j, i}], 0.];
iSWPosterLinkKind[kinds_Association, i_, j_] := With[{ks = Join[Lookup[kinds, Key[{i, j}], {}], Lookup[kinds, Key[{j, i}], {}]]},
  If[ks === {}, "RelatedTo", First[Commonest[ks]]]];

(* \:5217\:304c\:6c7a\:307e\:3063\:3066\:3044\:306a\:3044\:3068\:304d (C = 2): \:8fba\:306e\:91cd\:307f\:306e\:964d\:9806\:306b\:8caa\:6b32\:306b\:7d44\:306b\:3057\:3001From \:5074\:3092\:5de6\:306b\:3002\:76f8\:624b\:306e\:7121\:3044\:3082\:306e\:306f\:6570\:304c\:91e3\:308a\:5408\:3046\:3088\:3046\:9806\:306b *)
iSWPosterFacetsByEdges[n_Integer, w_Association] := Module[{facet = ConstantArray[None, n], pairs, cnt = {0, 0}},
  pairs = SortBy[Select[Tuples[Range[n], 2], #[[1]] < #[[2]] && Lookup[w, Key[#], 0.] + Lookup[w, Key[Reverse[#]], 0.] > 0 &],
    {-(Lookup[w, Key[#], 0.] + Lookup[w, Key[Reverse[#]], 0.]), #[[1]]} &];
  Do[With[{i = p[[1]], j = p[[2]]},
      If[facet[[i]] === None && facet[[j]] === None,
        If[Lookup[w, Key[{i, j}], 0.] >= Lookup[w, Key[{j, i}], 0.], facet[[i]] = 1; facet[[j]] = 2, facet[[i]] = 2; facet[[j]] = 1]]],
    {p, pairs}];
  cnt = {Count[facet, 1], Count[facet, 2]};
  Do[If[facet[[i]] === None, If[cnt[[1]] <= cnt[[2]], facet[[i]] = 1; cnt[[1]]++, facet[[i]] = 2; cnt[[2]]++]], {i, n}];
  facet];

(* \:5217\:3054\:3068\:306e\:914d\:7f6e\:3002alignQ \:306a\:3089\:524d\:306e\:5217\:3067\:6700\:3082\:5f37\:304f\:7d50\:3070\:308c\:305f\:30d6\:30ed\:30c3\:30af\:3068\:540c\:3058\:6bb5 (Pairs)\:3001\:305d\:3046\:3067\:306a\:3051\:308c\:3070\:4e0a\:304b\:3089\:9806 *)
iSWPosterPlaceColumns[blocks_List, C_Integer, wts_Association, alignQ_] := Module[
  {b = blocks, n = Length[blocks], facet, w = wts["Weights"], kinds = wts["Kinds"], cols, occ = <||>, pos, links = {}, R = 0, rowOf = <||>},
  facet = Lookup[#, "Facet", None] & /@ b;
  Which[
    AllTrue[facet, # === None &] && C === 2 && alignQ, facet = iSWPosterFacetsByEdges[n, w],
    AllTrue[facet, # === None &], Return[$Failed]];
  (* \:5217\:306e\:6c7a\:307e\:3063\:3066\:3044\:306a\:3044\:30d6\:30ed\:30c3\:30af\:306f\:3001\:305d\:306e\:6642\:70b9\:3067\:3044\:3061\:3070\:3093\:5c11\:306a\:3044\:5217\:3078 (\:540c\:6570\:306a\:3089\:5de6) *)
  Do[If[facet[[i]] === None, facet[[i]] = First[Ordering[Table[Count[facet, c], {c, C}], 1]]], {i, n}];
  facet = Map[Clip[#, {1, C}] &, facet];
  cols = Table[Select[Range[n], facet[[#]] === c &], {c, C}];
  pos = ConstantArray[{0, 0}, n];
  Do[With[{k = cols[[1, r]]}, rowOf[k] = r; occ[{r, 1}] = k; pos[[k]] = {r, 1}], {r, Length[cols[[1]]]}];
  R = Length[cols[[1]]];
  Do[Module[{prev = cols[[c - 1]], best = None, bw = 0., r},
      Do[With[{k = cols[[c, m]]},
        best = None; bw = 0.;
        If[alignQ,
          Do[With[{x = iSWPosterPairWeight[w, p, k]}, If[x > bw && ! KeyExistsQ[occ, {rowOf[p], c}], bw = x; best = p]], {p, prev}]];
        r = If[best =!= None, rowOf[best], SelectFirst[Range[Max[R, 1] + 1], ! KeyExistsQ[occ, {#, c}] &]];
        rowOf[k] = r; occ[{r, c}] = k; pos[[k]] = {r, c}; R = Max[R, r];
        If[best =!= None, AppendTo[links, <|"From" -> b[[best, "Id"]], "To" -> b[[k, "Id"]], "Kind" -> iSWPosterLinkKind[kinds, best, k], "Weight" -> bw|>]]],
        {m, Length[cols[[c]]]}]],
    {c, 2, C}];
  <|"Blocks" -> MapThread[Join[#1, <|"Facet" -> #2, "Position" -> #3|>] &, {b, facet, pos}], "Rows" -> Max[R, 1], "Links" -> links|>];

iSWPosterPlace[blocks_List, spec_Association, wts_Association] := Module[{b = blocks, n = Length[blocks], C = spec["Columns"], layout = spec["Layout"], R, pos, r},
  If[n === 0, Return[<|"Blocks" -> {}, "Rows" -> 1, "Links" -> {}|>]];
  r = Which[
    layout === "Pairs" || AnyTrue[b, IntegerQ[Lookup[#, "Facet", None]] &],
      iSWPosterPlaceColumns[b, C, wts, layout === "Pairs"],
    True, $Failed];
  If[AssociationQ[r], Return[iSWPosterApplyGrid[r, spec]]];
  If[layout === "Rows",
    R = Ceiling[n/C]; pos = Table[{Ceiling[k/C], k - (Ceiling[k/C] - 1) C}, {k, n}],
    R = Ceiling[n/C]; pos = Table[{k - (Ceiling[k/R] - 1) R, Ceiling[k/R]}, {k, n}]];
  iSWPosterApplyGrid[<|"Blocks" -> MapThread[Join[#1, <|"Facet" -> None, "Position" -> #2|>] &, {b, pos}],
    "Rows" -> R, "Links" -> {}|>, spec]];

(* Grid: \:306e\:6307\:5b9a = \:305d\:306e\:5347\:306b\:3042\:308b\:30d6\:30ed\:30c3\:30af\:3068\:5165\:308c\:66ff\:3048\:308b *)
iSWPosterApplyGrid[placed_Association, spec_Association] := Module[{b = placed["Blocks"], R = placed["Rows"], C = spec["Columns"], i, j},
  Do[With[{token = key, cell = spec["Grid"][key]},
      If[MatchQ[cell, {_Integer, _Integer}] && 1 <= cell[[2]] <= C && cell[[1]] >= 1,
        i = SelectFirst[Range[Length[b]], iSWPosterBlockMatchesQ[b[[#]], token] &, None];
        If[i =!= None,
          j = SelectFirst[Range[Length[b]], b[[#, "Position"]] === cell &, None];
          If[j =!= None, b[[j, "Position"]] = b[[i, "Position"]]];
          b[[i, "Position"]] = cell; R = Max[R, cell[[1]]]]]],
    {key, Keys[spec["Grid"]]}];
  <|"Blocks" -> b, "Rows" -> R, "Links" -> placed["Links"]|>];

(* ---- \:8a08\:753b ---- *)
Options[SlidePosterPlan] = {"Blocks" -> Automatic, "Columns" -> Automatic, "Layout" -> Automatic, "Panels" -> Automatic,
  "Facets" -> Automatic, "Grid" -> Automatic, "PanelMode" -> Automatic, "Size" -> Automatic, "Orientation" -> Automatic,
  "Scale" -> Automatic, "Spec" -> Automatic, "Graph" -> Automatic};
SlidePosterPlan[opts : OptionsPattern[]] := SlidePosterPlan[iSWResolveTargetNb[], opts];
SlidePosterPlan[src_?iSWNotOptionQ, OptionsPattern[]] := Module[
  {spec, deck, recs, kg, tree, ctx, built, blocks, target, wts, placed, warnings = {}, nParts, facetsOf, header},
  spec = If[AssociationQ[OptionValue["Spec"]], Join[SlidePosterSpec[src], OptionValue["Spec"]], SlidePosterSpec[src]];
  Do[With[{v = OptionValue[k]}, If[v =!= Automatic, spec[k] = v]],
    {k, {"Blocks", "Columns", "Layout", "Panels", "Facets", "Grid", "PanelMode", "Size", "Orientation", "Scale"}}];
  spec["Columns"] = iSWPosterInt[spec["Columns"], 2]; spec["Panels"] = iSWPosterInt[spec["Panels"], 4];
  spec["Layout"] = iSWPosterLayoutName[spec["Layout"]]; spec["PanelMode"] = iSWPosterPanelModeName[spec["PanelMode"]];
  If[! ListQ[spec["Facets"]], spec["Facets"] = Select[StringTrim /@ StringSplit[ToString[spec["Facets"]], "|" | "\:ff5c"], # =!= "" &]];
  If[! AssociationQ[spec["Grid"]], spec["Grid"] = iSWPosterGridSpec[spec["Grid"]]];
  If[! IntegerQ[spec["Blocks"]], spec["Blocks"] = Automatic];
  spec["SizePt"] = iSWPosterSizePt[spec["Size"], spec["Orientation"]];
  deck = iSWPosterDeckData[src];
  If[deck === $Failed, Return[Failure["NoDeck", <|"MessageTemplate" -> "cannot read the slides of `1`", "MessageParameters" -> {ToString[Short[src]]}|>]]];
  recs = deck["Slides"];
  If[Select[recs, ! TrueQ[#["TitleSlide"]] &] === {},
    Return[Failure["NoSlides", <|"MessageTemplate" -> "the deck has no slides to lay out"|>]]];
  (* KG: "Graph" \:3067\:660e\:793a (graphId | KG) \:304b\:3001\:30c7\:30c3\:30ad\:306e Story \:30bb\:30eb (Graph:) / \:984c\:76ee\:304b\:3089 *)
  kg = If[iSWKGEnsure[], Quiet @ Check[iSWKGResolve[Replace[OptionValue["Graph"], Automatic -> src]], $Failed], $Failed];
  If[! AssociationQ[kg], kg = None];
  tree = If[AssociationQ[kg], iSWPosterTree[kg], $Failed];
  If[AssociationQ[kg] && ! AssociationQ[tree], AppendTo[warnings, "NoTree: the KG has no ordered tree; grouping by crumbs"]; kg = None];
  ctx = <|"KG" -> kg, "Tree" -> If[AssociationQ[tree], tree, None],
    "Index" -> If[AssociationQ[kg], Association[Map[#["Id"] -> # &, Lookup[kg, "Nodes", {}]]], <||>],
    "Lang" -> If[AssociationQ[kg], Lookup[kg, "Language", "ja"], "ja"]|>;
  built = If[AssociationQ[kg], iSWPosterBlocksFromKG[recs, ctx], None];
  blocks = If[AssociationQ[built] && built["Blocks"] =!= {}, built["Blocks"], None];
  If[blocks === None, blocks = iSWPosterBlocksFromCrumbs[recs]];
  If[blocks === None, blocks = iSWPosterBlocksEven[recs, spec["Panels"]]];
  nParts = Length[blocks];
  target = Replace[spec["Blocks"], Automatic -> Clip[nParts, {Min[3, Max[1, Length[Select[recs, ! TrueQ[#["TitleSlide"]] &]]]], 10}]];
  If[Length[blocks] > target, blocks = iSWPosterMergeBlocks[blocks, target]];
  If[Length[blocks] < target, blocks = iSWPosterSplitBlocks[blocks, target, ctx]];
  If[Length[blocks] =!= target, AppendTo[warnings, "BlockCount: " <> ToString[Length[blocks]] <> " blocks (requested " <> ToString[target] <> ")"]];
  blocks = MapIndexed[Join[#1, <|"Index" -> First[#2]|>] &, blocks];
  blocks = Map[iSWPosterPickPanels[#, spec["Panels"], ctx] &, blocks];
  blocks = iSWPosterAssignFacets[blocks, spec, ctx];
  wts = iSWPosterBlockWeights[blocks, kg];
  placed = iSWPosterPlace[blocks, spec, wts];
  If[spec["Layout"] === "Pairs" && placed["Links"] === {} && AllTrue[placed["Blocks"], Lookup[#, "Facet", None] === None &],
    AppendTo[warnings, "NoPairs: no edges or facets to pair the blocks; laid out in reading order"]];
  With[{folded = Total[Length[#["Folded"]] & /@ placed["Blocks"]]},
    If[folded > 0, AppendTo[warnings, "Folded: " <> ToString[folded] <> " slides are listed by title only (raise Panels: or pin them)"]]];
  facetsOf = With[{f = spec["Facets"], C = spec["Columns"]}, If[f === {}, {}, PadRight[Take[f, UpTo[C]], C, ""]]];
  header = <|"Title" -> If[spec["Title"] =!= "", spec["Title"], With[{t = SelectFirst[Lookup[recs, "DeckTitle", ""], # =!= "" &, ""]}, t]],
    "Subtitle" -> spec["Subtitle"], "Author" -> spec["Author"], "Affiliation" -> spec["Affiliation"],
    "Event" -> spec["Event"], "Date" -> spec["Date"], "Abstract" -> spec["Abstract"], "QR" -> spec["QR"]|>;
  <|"ObjectClass" -> "SlidePosterPlan", "Size" -> spec["SizePt"], "Columns" -> spec["Columns"], "Rows" -> placed["Rows"],
    "Header" -> header, "Facets" -> facetsOf,
    "Blocks" -> Map[KeyDrop[#, "Slides"] &, placed["Blocks"]],
    "Links" -> placed["Links"],
    "Footer" -> <|"References" -> Quiet @ Check[iSWReferencesList[src], {}], "Note" -> spec["Footer"]|>,
    "Spec" -> spec, "Warnings" -> warnings, "GraphId" -> If[AssociationQ[kg], Lookup[kg, "GraphId", None], None],
    "Language" -> If[AssociationQ[kg], iSWKGLangCode[Lookup[kg, "Language", "ja"]], iSWKGLangCode[Lookup[Quiet @ Check[iSWDirectiveMeta[src], <||>], "Language", "ja"]]],
    "Skipped" -> If[AssociationQ[built], built["Skipped"], {}],
    "Deck" -> <|"Path" -> deck["Path"], "StyleDefinitions" -> deck["StyleDefinitions"],
      "CacheId" -> iSWPosterCachePut[Association[Map[#["Slide"] -> #["Cells"] &, recs]]],
      "Source" -> If[Head[src] === NotebookObject, src, None]|>|>];

iSWPosterPlanQ[x_] := AssociationQ[x] && Lookup[x, "ObjectClass", ""] === "SlidePosterPlan";
(* \:679a\:306e\:30bb\:30eb\:5217\:306f\:8a08\:753b\:306b\:5165\:308c\:305a (\:56f3\:306e\:753b\:50cf\:3067\:8868\:793a\:304c\:91cd\:304f\:306a\:308b) \:30bb\:30c3\:30b7\:30e7\:30f3\:5185\:306e\:30ad\:30e3\:30c3\:30b7\:30e5\:306b\:7f6e\:304f\:3002\:6d88\:3048\:3066\:3044\:308c\:3070\:30c7\:30c3\:30ad\:304b\:3089\:8aad\:307f\:76f4\:3059 *)
If[! AssociationQ[$iSWPosterDeckCache], $iSWPosterDeckCache = <||>];
iSWPosterCachePut[cells_Association] := With[{id = CreateUUID["poster-"]},
  $iSWPosterDeckCache[id] = cells;
  If[Length[$iSWPosterDeckCache] > 4, $iSWPosterDeckCache = KeyDrop[$iSWPosterDeckCache, First[Keys[$iSWPosterDeckCache]]]];
  id];
iSWPosterDeckCells[plan_Association] := Module[{id = Lookup[plan["Deck"], "CacheId", None], src, d},
  If[StringQ[id] && KeyExistsQ[$iSWPosterDeckCache, id], Return[$iSWPosterDeckCache[id]]];
  src = Replace[plan["Deck"]["Path"], None -> plan["Deck"]["Source"]];
  d = If[src === None, $Failed, iSWPosterDeckData[src]];
  If[AssociationQ[d], Association[Map[#["Slide"] -> #["Cells"] &, d["Slides"]]], <||>]];
iSWPosterFacetLabel[plan_Association, blk_Association] := With[{f = Lookup[blk, "Facet", None], labels = Lookup[plan, "Facets", {}]},
  Which[! IntegerQ[f], "", labels =!= {} && 1 <= f <= Length[labels] && labels[[f]] =!= "", labels[[f]], True, ToString[f]]];
iSWPosterPlanDataset[plan_Association] := Dataset[Map[Function[blk,
  <|iSL["\:756a\:53f7", "No"] -> blk["Index"],
    iSL["\:6bb5,\:5217", "Row,Col"] -> StringRiffle[ToString /@ blk["Position"], ","],
    iSL["\:5217", "Facet"] -> iSWPosterFacetLabel[plan, blk],
    iSL["\:30d6\:30ed\:30c3\:30af", "Block"] -> blk["Title"],
    iSL["\:547c\:3073\:65b9", "Say"] -> iSWPosterBlockRef[blk, Lookup[plan, "Language", "ja"]],
    iSL["\:679a", "Panels"] -> StringRiffle[Map[ToString[#["Slide"]] <> " " <> #["Title"] &, blk["Panels"]], " / "],
    iSL["\:307b\:304b\:306b", "Folded"] -> StringRiffle[Map[ToString[#["Slide"]] <> " " <> #["Title"] &, blk["Folded"]], " / "]|>],
  SortBy[plan["Blocks"], #["Position"] &]]];
SlidePosterPlanView[opts : OptionsPattern[SlidePosterPlan]] := SlidePosterPlanView[iSWResolveTargetNb[], opts];
SlidePosterPlanView[src_?iSWNotOptionQ, opts : OptionsPattern[SlidePosterPlan]] :=
  With[{p = If[iSWPosterPlanQ[src], src, SlidePosterPlan[src, opts]]}, If[iSWPosterPlanQ[p], iSWPosterPlanDataset[p], p]];

(* ---- \:30d1\:30cd\:30eb\:306e\:63cf\:753b: \:679a\:306e\:30bb\:30eb\:5217\:3092\:30d1\:30cd\:30eb\:5e45\:3067\:518d\:7d44\:7248 (\:9ad8\:3055\:306f\:5185\:5bb9\:306a\:308a) ---- *)
(* \:56f3\:3092\:30d1\:30cd\:30eb\:306b\:53ce\:3081\:308b: \:5e45 fitW\:30fb\:9ad8\:3055 fitH \:306e\:7bb1\:306b\:7e26\:6a2a\:6bd4\:3092\:4fdd\:3063\:3066\:5165\:308c\:308b (\:7a93\:3088\:308a\:5e83\:3044\:56f3\:306f\:63cf\:753b\:3067\:5207\:308c\:3001\:7e26\:9577\:306e\:56f3\:306f\:5347\:3092\:98df\:3046)\:3002
   \:7e26\:6a2a\:6bd4\:306f RasterBox \:306e\:753b\:7d20\:6570 > ImageSize \:306e {w, h} > \:7121\:3051\:308c\:3070 16:10 \:3068\:307f\:306a\:3059 *)
iSWPosterBoxAspect[box_, size_] := With[{r = FirstCase[box, RasterBox[_, {{0, 0}, {w_?NumericQ, h_?NumericQ}}, ___] :> h/Max[w, 1], None, Infinity]},
  Which[NumericQ[r], r, MatchQ[size, {_?NumericQ, _?NumericQ}], size[[2]]/Max[size[[1]], 1], True, 0.625]];
iSWPosterFitSize[box_, size_, fitW_, fitH_] := With[{a = iSWPosterBoxAspect[box, size]}, With[{w = Min[fitW, fitH/Max[a, 0.05]]}, {w, w a}]];
(* GraphicsBox \:306f HoldAll \:306a\:306e\:3067\:3001\:5927\:304d\:3055\:3092\:5148\:306b\:8a55\:4fa1\:3057\:3066\:304b\:3089\:7bb1\:306b\:5165\:308c\:308b (\:76f4\:306b\:66f8\:304f\:3068\:672a\:8a55\:4fa1\:306e\:307e\:307e\:7bb1\:306b\:6b8b\:308a\:3001\:56f3\:304c\:70b9\:306b\:306a\:308b) *)
iSWPosterFitFigures[cells_List, fitW_?NumericQ, fitH_?NumericQ] := cells /.
  (g : GraphicsBox[a___, (ImageSize -> s_), b___] :> With[{sz = iSWPosterFitSize[g, s, fitW, fitH]}, GraphicsBox[a, ImageSize -> sz, b]]);
(* \:8a70\:3081\:308b: \:88dc\:8db3 (ItemParagraph \:7cfb)\:30fb\:7528\:8a9e\:306e\:884c\:30fb\:30d1\:30f3\:304f\:305a\:306f\:51fa\:3055\:306a\:3044 (\:9762\:7a4d\:304c\:9650\:3089\:308c\:308b\:3002\:984c\:76ee\:30fb\:5c0e\:5165\:6587\:30fb\:8981\:70b9\:30fb\:56f3\:30fb\:51fa\:5178\:304c\:6b8b\:308b) *)
iSWPosterCompactQ[cell_Cell] := MatchQ[cell, Cell[_, "ItemParagraph" | "SubitemParagraph" | "SubsubitemParagraph" | "SlideCrumb", ___]] ||
  ! FreeQ[Cases[Rest[List @@ cell], (CellTags -> t_) :> t, 1], "SlideTermNote"];
iSWPosterPanelImage[cells_List, w_?NumericQ, k_?NumericQ, sd_] := iSWPosterPanelImage[cells, w, k, sd, <||>];
iSWPosterFigCellQ[c_] := MatchQ[c, Cell[BoxData[_], ___]] && ! FreeQ[c, GraphicsBox[___, ImageSize -> _, ___]];
(* \:679a\:306e\:56f3\:306e\:30bb\:30eb\:3092\:96c6\:3081\:3066 2 \:3064\:305a\:3064\:6a2a\:306b\:4e26\:3079\:305f\:6bb5 (GridBox \:306e\:30bb\:30eb) \:306b\:3057\:3001\:6700\:521d\:306e\:56f3\:304c\:3042\:3063\:305f\:4f4d\:7f6e\:306b\:7f6e\:304f (v1.57: \:56f3\:304c\:7e26\:306b\:7a4d\:307e\:308c\:3066\:679a\:304c\:9577\:3044\:3068\:304d\:3002
   \:56f3\:306f\:7b87\:6761\:66f8\:304d\:3092\:631f\:3093\:3067\:96e2\:308c\:3066\:3044\:308b\:3053\:3068\:304c\:591a\:3044\:306e\:3067\:3001\:96a3\:63a5\:306b\:9650\:3089\:306a\:3044)\:3002\:5404\:56f3\:306f\:534a\:5206\:306e\:5e45\:306b\:5408\:308f\:305b\:308b\:3002\:56f3\:304c 1 \:3064\:306a\:3089\:4f55\:3082\:3057\:306a\:3044 *)
iSWPosterPairFigureCells[cells_List, fitW2_?NumericQ, fitH_?NumericQ] := Module[{figs, pos, rows, rest},
  figs = Select[cells, iSWPosterFigCellQ];
  If[Length[figs] < 2, Return[cells]];
  pos = First[FirstPosition[cells, _?iSWPosterFigCellQ, {1}, {1}, Heads -> False]];
  figs = First[iSWPosterFitFigures[{#}, fitW2, fitH]] & /@ figs;
  rows = Map[Function[row, If[Length[row] === 1, row[[1]],
      Cell[BoxData[GridBox[{First[#[[1]]] & /@ row},
          GridBoxAlignment -> {"Columns" -> {{Left}}, "Rows" -> {{Top}}}, GridBoxSpacings -> {"Columns" -> {{0.8}}}]],
        Sequence @@ Rest[List @@ row[[1]]]]]], Partition[figs, UpTo[2]]];
  rest = Select[Take[cells, pos - 1], ! iSWPosterFigCellQ[#] &];
  Join[rest, rows, Select[Drop[cells, pos - 1], ! iSWPosterFigCellQ[#] &]]];
(* opts: "FigureWidth" = \:56f3\:306e\:5e45\:306e\:4e0a\:9650 px (\:65e2\:5b9a\:306f\:7a93\:5e45 - 24\:3002\:7a93\:5e45\:306f\:30bb\:30eb\:306e\:5de6\:53f3\:4f59\:767d\:306e\:3076\:3093\:5e83\:3081\:306b\:53d6\:308b\:306e\:3067\:3001\:56f3\:306f\:5217\:306e\:5e45\:3067\:6b62\:3081\:308b)\:3001
         "ExtraFigH" = \:56f3\:306e\:9ad8\:3055\:306e\:4e0a\:9650\:306b\:8db3\:3059 px (\:5217\:306e\:4e0b\:304c\:7a7a\:3044\:3066\:3044\:308b\:3068\:304d\:56f3\:3092\:5927\:304d\:304f\:3057\:3066\:57cb\:3081\:308b)\:3001
         "FigureColumns" = 2 \:306a\:3089\:96a3\:308a\:5408\:3046\:56f3\:3092\:6a2a\:306b\:4e26\:3079\:308b (\:6700\:3082\:9ad8\:3044\:5217\:306e\:679a) *)
iSWPosterPanelImage[cells_List, w_?NumericQ, k_?NumericQ, sd_, opts_Association] := Module[{filtered, img, extra, fitW, fitH},
  filtered = Select[iRasterFilterCells[cells, Automatic], ! iSWPosterCompactQ[#] &];
  If[filtered === {}, Return[$Failed]];
  extra = Max[0, Lookup[opts, "ExtraFigH", 0]];
  fitW = Min[w - 24, Lookup[opts, "FigureWidth", w - 24]];
  fitH = Min[0.72 fitW, 330] + extra;
  (* \:5148\:306b\:5168\:90e8\:306e\:56f3\:3092\:5217\:306e\:5e45\:306b\:5408\:308f\:305b\:3001\:305d\:306e\:5f8c\:3067\:5bfe\:306b\:3059\:308b (\:9006\:3060\:3068\:5bfe\:306b\:3057\:305f\:56f3\:304c\:5217\:5e45\:3044\:3063\:3071\:3044\:306b\:623b\:3055\:308c\:3066\:6bb5\:304c\:5de6\:53f3\:3067\:5207\:308c\:305f)\:3002
     \:6a2a\:306b\:4e26\:3079\:305f\:6bb5\:306f 1 \:5272\:306e\:4f59\:88d5\:3092\:53d6\:308b (\:30bb\:30eb\:306e\:4f59\:767d\:306f Input \:3068 Item \:3067\:9055\:3046) *)
  filtered = iSWPosterFitFigures[filtered, fitW, fitH];
  If[Lookup[opts, "FigureColumns", 1] === 2, filtered = iSWPosterPairFigureCells[filtered, (0.9 fitW - 16)/2, fitH]];
  img = Quiet @ Check[Rasterize[
    Notebook[filtered, StyleDefinitions -> sd, ScreenStyleEnvironment -> "SlideShow",
      WindowSize -> {Round[w], Round[w*9/16]}, Background -> White],
    "Image", ImageResolution -> Round[72 k], Background -> White], $Failed];
  If[! ImageQ[img], Return[$Failed]];
  Quiet @ Check[ImageCrop[img], img]];

(* \:30d1\:30cd\:30eb\:306e\:753b\:50cf\:3092\:30d6\:30ed\:30c3\:30af\:306e\:4e2d\:306b 2 \:5217\:306e masonry (\:77ed\:3044\:5217\:3078\:9806\:306b) \:3067\:7f6e\:304f\:3002\:623b\:308a\:5024: {{x, yTop, w, h}..} (pt\:3001\:5de6\:4e0a\:539f\:70b9\:3001y \:306f\:4e0b\:5411\:304d) \:3068\:9ad8\:3055 *)
(* \:30d1\:30cd\:30eb\:306e\:5217\:6570: 1 \:679a \:2192 1 \:5217 (\:5e45 0.62)\:30012 \:2192 2 \:5217\:30013 \:2192 3 \:5217 (\:6a2a\:4e26\:3073)\:30014 \:4ee5\:4e0a \:2192 2 \:5217 (2\:00d72)\:3002\:77ed\:3044\:5217\:3078\:9806\:306b\:7a4d\:3080 *)
iSWPosterPanelColumns[n_Integer] := Switch[n, 1, 1, 2, 2, 3, 3, _, 2];
iSWPosterPanelWidth[innerW_, nCols_Integer, gap_] := If[nCols === 1, innerW*0.62, (innerW - (nCols - 1) gap)/nCols];
iSWPosterMasonry[imgs_List, colW_?NumericQ, nCols_Integer, k_?NumericQ, gap_?NumericQ, scale_?NumericQ] := Module[
  {n = Length[imgs], hs = ConstantArray[0., Max[1, nCols]], out = {}, x, y, w, h, d, c},
  Do[
    d = ImageDimensions[imgs[[i]]];
    w = Min[colW, d[[1]]*scale/k];
    h = w*d[[2]]/Max[d[[1]], 1];
    c = First[Ordering[hs, 1]];
    x = (c - 1) (colW + gap); y = hs[[c]];
    AppendTo[out, {x, y, w, h}];
    hs[[c]] += h + gap,
    {i, n}];
  <|"Boxes" -> out, "Height" -> Max[Max[hs] - gap, 0.]|>];

(* ---- v1.57: \:30d6\:30ed\:30c3\:30af\:5185\:306e\:914d\:7f6e\:306e\:6700\:9069\:5316 ----
   \:5217\:6570\:3068\:5e45\:3092\:56fa\:5b9a\:305b\:305a\:3001\:5019\:88dc (\:63cf\:3051\:305f\:679a\:6570\:306b\:5fdc\:3058\:3066 1\:301c3 \:5217\:30011 \:679a\:306a\:3089\:5e45 62% / 80% / 100%) \:3092\:5b9f\:969b\:306b\:7d44\:7248\:3057\:3066\:9ad8\:3055\:3092\:6e2c\:308a\:3001\:5347\:306b\:5165\:308c\:305f\:3068\:304d\:306b
   \:6587\:5b57\:304c\:6700\:3082\:5927\:304d\:304f\:8aad\:3081\:3001\:304b\:3064\:9762\:7a4d\:3092\:4f7f\:3046\:5019\:88dc\:3092\:9078\:3076 (score = \:5230\:9054\:500d\:7387 \:00d7 (0.5 + 0.5 \:9762\:7a4d\:7387))\:3002\:9078\:3093\:3060\:914d\:7f6e\:3067\:5347\:306e\:9ad8\:3055\:306b\:5408\:308f\:305b\:3066\:500d\:7387\:3092
   \:4e0a\:3052\:4e0b\:3052\:3057\:3066\:7d44\:307f\:76f4\:3059 (\:6587\:5b57\:306e\:9ad8\:3055\:306f\:500d\:7387\:306e 2 \:4e57\:3067\:52b9\:304f\:306e\:3067 Sqrt \:3067\:5bc4\:305b\:308b\:30012 \:56de\:307e\:3067)\:3002\:305d\:308c\:307e\:3067\:306f\:3001\:306f\:307f\:51fa\:3057\:305f\:5206\:3092\:4e00\:5f8b\:306b\:7e2e\:3081\:3066\:3044\:305f\:306e\:3067
   \:5e45\:3082\:4e00\:7dd2\:306b\:7e2e\:3093\:3067\:53f3\:5074\:304c\:7a7a\:3044\:3066\:3044\:305f\:3002\:5019\:88dc\:306e\:6bd4\:8f03\:306f\:4f4e\:89e3\:50cf\:5ea6 (k = 1) \:3067\:63cf\:3044\:3066\:901f\:304f\:3059\:308b\:3002\:63cf\:3051\:305f\:679a\:6570\:3067\:5217\:6570\:3092\:6c7a\:3081\:308b\:306e\:3067\:5217\:304c\:7a7a\:304b\:306a\:3044\:3002
   \:8a2d\:5b9a\:30bb\:30eb\:306e PanelColumns: \:3067\:5217\:6570\:3092\:56fa\:5b9a\:3067\:304d\:308b\:3002\:500d\:7387\:306e\:7bc4\:56f2\:306f\:8a2d\:5b9a\:30bb\:30eb\:306e Scale \:306b\:5bfe\:3057\:3066 $SlidePosterScaleRange *)
$SlidePosterScaleRange = {0.6, 1.6};
$iSWPosterPanelCache = <||>;
$iSWPosterLastLayouts = <||>;
SetAttributes[iSWPosterCached, HoldRest];
iSWPosterCached[key_, expr_] := If[KeyExistsQ[$iSWPosterPanelCache, key], $iSWPosterPanelCache[key], $iSWPosterPanelCache[key] = expr];
iSWPosterLayoutCandidates[n_Integer, forced_] := Module[{c},
  c = Switch[n, 1, {{1, 0.62}, {1, 0.8}, {1, 1.}}, 2, {{2, 1.}}, 3, {{3, 1.}, {2, 1.}}, _, {{2, 1.}, {3, 1.}}];
  If[IntegerQ[forced] && 1 <= forced <= 3,
    With[{sel = Select[c, #[[1]] === forced &]}, If[sel =!= {}, sel, {{Min[forced, Max[n, 1]], 1.}}]],
    c]];
iSWPosterCandWidth[innerW_, {nCols_, frac_}, gap_] := (innerW*frac - (nCols - 1) gap)/nCols;
iSWPosterBoxesArea[boxes_List] := Total[#[[3]] #[[4]] & /@ boxes];
(* \:5217\:3054\:3068\:306b\:5e45\:304c\:9055\:3046\:914d\:7f6e (\:679a i \:3092\:5217 i \:306b\:3001\:91cd\:306d\:306a\:3044)\:3002\:623b\:308a\:5024\:306f iSWPosterMasonry \:3068\:540c\:3058\:5f62 *)
iSWPosterRowBoxes[imgs_List, widths_List, ks_List, gap_?NumericQ, scale_?NumericQ] := Module[{x = 0., out = {}, hs = {}, d, w, h},
  Do[
    d = ImageDimensions[imgs[[i]]];
    w = Min[widths[[i]], d[[1]]*scale/ks[[i]]];
    h = w*d[[2]]/Max[d[[1]], 1];
    AppendTo[out, {x, 0., w, h}]; AppendTo[hs, h];
    x += widths[[i]] + gap,
    {i, Min[Length[imgs], Length[widths]]}];
  <|"Boxes" -> out, "Height" -> Max[hs, 0.]|>];
(* \:5e45\:306e\:914d\:5206: \:7b49\:5e45\:3067\:63cf\:3044\:305f\:3068\:304d\:306e\:9762\:7a4d (w\:00d7h) \:306b\:6bd4\:4f8b\:3055\:305b\:3066\:5217\:306e\:9ad8\:3055\:3092\:63c3\:3048\:308b\:3002\:305f\:3060\:3057\:5404\:5217\:306f\:7a7a\:304d\:5e45\:306e 22\:301c60% *)
iSWPosterProportionalWidths[areas_List, total_?NumericQ] := Module[{n = Length[areas], w, lo, hi, fixed, rest, free, out},
  If[n < 2 || Total[areas] <= 0, Return[None]];
  lo = 0.22 total; hi = 0.6 total;
  w = total*areas/Total[areas]; fixed = ConstantArray[False, n];
  Do[
    rest = Pick[Range[n], fixed, False];
    If[rest === {}, Break[]];
    free = total - Total[Pick[w, fixed]];
    w[[rest]] = free*areas[[rest]]/Max[Total[areas[[rest]]], 10.^-6];
    out = Select[rest, w[[#]] < lo || w[[#]] > hi &];
    If[out === {}, Break[]];
    Do[w[[i]] = Clip[w[[i]], {lo, hi}]; fixed[[i]] = True, {i, out}],
