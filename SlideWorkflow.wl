      "Searching related work (" <> ToString[i] <> "/" <> ToString[Length[qs]] <> ": " <> qs[[i]] <> ")..."]];
    rows = Join[rows, iSWRelatedSearchLocal[qs[[i]]]];
    If[TrueQ[web], rows = Join[rows, iSWRelatedSearchWeb[qs[[i]]]]],
