      MessageDialog[iSL["\:97f3\:58f0\:4f1a\:8a71\:3092\:958b\:59cb\:3067\:304d\:307e\:305b\:3093\:3067\:3057\:305f:\n",
        "Could not start the realtime bridge:\n"] <> iSWFailureText[bridge]];
      Return[$Failed]]];
  $iSWPlayState["Status"] = "Playing";
  iSWPlayLabelPause[];
  iSWRemoteAutoStart[];
  Quiet[SetSelectedNotebook[nb]];
  (* v1.37: \:767a\:8868\:306e\:8a18\:9332 (\:9032\:884c\:30fb\:8cea\:554f\:30fb\:30ab\:30e1\:30e9) \:3092\:59cb\:3081\:308b\:3002\:65e2\:306b\:59cb\:307e\:3063\:3066\:3044\:308c\:3070\:305d\:306e\:307e\:307e\:7d9a\:3051\:308b *)
  Quiet[iSWTalkRecEnsure[nb]];
  If[(SlideTalkMode[] === "Poster" || IntegerQ[OptionValue["StartSlide"]]) && start =!= feN, Quiet[iSWSlideGoTo[nb, start]]];
