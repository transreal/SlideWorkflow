    Return[iSWVideoFail["SlideVideoIO", "\:58f0\:3092\:307e\:3068\:3081\:305f wav \:3092\:66f8\:3051\:307e\:305b\:3093\:3067\:3057\:305f\:3002", "Could not write the combined voice track."]]];
  total = Total[segs[[All, "Duration"]]];
