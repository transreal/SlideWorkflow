SlideReadingAdd[rs : {___Rule}] := Module[{f = SlideReadingFile[], lines},
  lines = StringSplit[StringReplace[iSWReadingReadFile[f], "\r\n" -> "\n"], "\n", All];
  If[lines =!= {} && Last[lines] === "", lines = Most[lines]];
  Do[With[{k = StringTrim[ToString[r[[1]]]], v = StringTrim[ToString[r[[2]]]]},
      If[k =!= "" && v =!= "",
        With[{pos = SelectFirst[Range[Length[lines]],
            With[{p = iSWReadingParse[lines[[#]]]}, p =!= {} && p[[1, 1]] === k] &, None]},
          If[IntegerQ[pos], lines[[pos]] = k <> " = " <> v, AppendTo[lines, k <> " = " <> v]]]]],
    {r, rs}];
  If[iSWReadingWriteFile[f, StringRiffle[lines, "\n"] <> "\n"] === $Failed, Return[$Failed]];
  Association[iSWReadingGlobalRules[]]];

iSWReadingCellTemplate[] := iSL[
  "# \:8aad\:307f: \:8aad\:307f\:4e0a\:3052 (gpt-realtime\:30fb\:30ed\:30fc\:30ab\:30eb\:306e\:58f0) \:306e\:3068\:304d\:3060\:3051\:8a9e\:3092\:4eee\:540d\:306b\:7f6e\:304d\:63db\:3048\:308b\:3002\:30b9\:30e9\:30a4\:30c9\:30fb\:5b57\:5e55\:30fb\:539f\:7a3f\:306f\:5909\:3048\:306a\:3044\n" <>
    "# 1 \:884c 1 \:8a9e\:300c\:8a9e = \:3088\:307f\:300d\:3002# \:304b\:3089\:884c\:672b\:306f\:30b3\:30e1\:30f3\:30c8\:3002\:5168\:30c7\:30c3\:30ad\:5171\:901a\:306e\:8aad\:307f (SlideReadingFile[]) \:3088\:308a\:512a\:5148\:3059\:308b\n" <>
    "# \:4f8b: \:5b9a\:5e38\:6ce2\:306e\:7bc0 = \:3066\:3044\:3058\:3087\:3046\:306f\:306e\:3075\:3057\n",
