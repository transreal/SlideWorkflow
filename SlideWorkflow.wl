iSWVideoComposePoll[job_Association] := Module[{p = job["Process"], st, code, err, ok},
  st = Quiet[ProcessStatus[p]];
  If[st === "Running",
    Return[<|"Status" -> "Running", "Seconds" -> iSWFFmpegProgress[job["ProgressFile"]], "Total" -> job["Total"]|>]];
  code = Quiet[ProcessInformation[p, "ExitCode"]];
  err = Quiet[Check[ReadString[ProcessConnection[p, "StandardError"], EndOfBuffer], ""]];
  ok = code === 0 && FileExistsQ[job["TempOut"]] && TrueQ[Quiet[FileByteCount[job["TempOut"]]] > 1000];
  If[ok,
    Quiet[CreateDirectory[DirectoryName[job["Output"]], CreateIntermediateDirectories -> True]];
    ok = Quiet[Check[CopyFile[job["TempOut"], job["Output"], OverwriteTarget -> True], $Failed]] =!= $Failed];
  Quiet[DeleteDirectory[job["Temp"], DeleteContents -> True]];
  If[ok, <|"Status" -> "Done", "File" -> job["Output"]|>,
    <|"Status" -> "Failed", "ExitCode" -> code,
      "Error" -> If[StringQ[err], StringTake[StringTrim[err], UpTo[600]], ""]|>]];

iSWVideoPercent[r_Association] :=
  ToString[Round[100 Min[1., N[Lookup[r, "Seconds", 0]]/Max[1., N[Lookup[r, "Total", 1]]]]]] <> "%";

(* \:4ed5\:4e0a\:3052: \:6642\:523b\:8868 (\:30c1\:30e3\:30d7\:30bf\:30fc\:306e\:5143) \:3092 mp4 \:306e\:96a3\:306b\:66f8\:304f *)
iSWVideoFinalize[job_Association, res_Association] := Module[{meta = job["Meta"], tl, tlFile},
  tlFile = iSWVideoTimelineFile[job["Output"]];
  tl = <|"Video" -> job["Output"], "Deck" -> Lookup[meta, "Deck", ""], "Title" -> Lookup[meta, "Title", ""],
    "Voice" -> Lookup[meta, "Voice", None], "Model" -> Lookup[meta, "Model", None],
    "Engine" -> Lookup[meta, "Engine", None], "Language" -> Lookup[meta, "Language", None],
    "Mode" -> Lookup[meta, "Mode", "Slides"], "Duration" -> job["Total"],
    "CreatedAt" -> DateString[Now, "ISODateTime"],
    "SlidesDigest" -> Lookup[meta, "SlidesDigest", None], "TalkDigest" -> Lookup[meta, "TalkDigest", None],
    "Slides" -> Map[<|"Slide" -> #["Slide"], "Title" -> #["Title"], "Start" -> #["Start"],
        "Duration" -> #["Duration"], "Narrated" -> StringQ[#["Audio"]]|> &, job["Segments"]]|>;
  Quiet[iSWWriteJSON[tlFile, tl]];
  $iSWVideoLast = <|"Status" -> "Done", "File" -> job["Output"], "Duration" -> job["Total"],
    "Slides" -> Length[job["Segments"]], "Timeline" -> tlFile,
    "Engine" -> Lookup[meta, "Engine", None], "Voice" -> Lookup[meta, "Voice", None],
    "Model" -> Lookup[meta, "Model", None], "Missing" -> Lookup[meta, "Missing", {}],
    "Seconds" -> Round[AbsoluteTime[] - job["StartedAt"], 0.1]|>];

(* \:30dc\:30bf\:30f3\:304b\:3089: \:72b6\:614b\:884c\:306b\:9032\:307f\:5177\:5408\:3092\:51fa\:3057\:306a\:304c\:3089\:5f85\:3064 *)
iSWVideoCompose[nb_, images_List, include_List, files_Association, titles_List, out_String, meta_Association] :=
  Module[{audio, segs, job, r},
    audio = Select[files, StringQ[#] && FileExistsQ[#] &];
    segs = iSWVideoSegments[images, audio, include, titles];
    job = iSWVideoComposeStart[segs, out, Join[meta, <|"Missing" -> Complement[Keys[files], Keys[audio]]|>]];
    If[FailureQ[job], Return[job]];
    iSWStatus[nb, iSL["\:52d5\:753b\:3092\:66f8\:304d\:51fa\:3057\:3066\:3044\:307e\:3059 0%", "Encoding the video 0%"]];
    While[(r = iSWVideoComposePoll[job])["Status"] === "Running",
      iSWStatus[nb, iSL["\:52d5\:753b\:3092\:66f8\:304d\:51fa\:3057\:3066\:3044\:307e\:3059 ", "Encoding the video "] <> iSWVideoPercent[r] <>
        " (" <> iSWClock[r["Seconds"]] <> " / " <> iSWClock[job["Total"]] <> ")"];
      Pause[1]];
    If[r["Status"] =!= "Done",
      iSWStatus[nb, iSL["\:52d5\:753b\:306e\:66f8\:304d\:51fa\:3057\:306b\:5931\:6557\:3057\:307e\:3057\:305f", "Video encoding failed"]];
      iSWStatusClearLater[nb];
      $iSWVideoLast = <|"Status" -> "Failed", "Error" -> r["Error"]|>;
      Return[iSWVideoFail["SlideVideoEncodeFailed", "ffmpeg \:306e\:66f8\:304d\:51fa\:3057\:306b\:5931\:6557\:3057\:307e\:3057\:305f (\:7d42\:4e86\:30b3\:30fc\:30c9 " <> ToString[r["ExitCode"]] <> ")\:3002",
        "ffmpeg failed (exit code " <> ToString[r["ExitCode"]] <> ").", <|"Detail" -> r["Error"]|>]]];
    r = iSWVideoFinalize[job, r];
    iSWStatus[nb, iSL["\:52d5\:753b\:304c\:3067\:304d\:307e\:3057\:305f: ", "Video ready: "] <> FileNameTake[out] <> " (" <> iSWClock[job["Total"]] <> ")"];
    iSWStatusClearLater[nb];
    r];

(* \:9332\:97f3\:306e\:518d\:751f (ScheduledTask) \:306e\:7d42\:308f\:308a\:304b\:3089: \:66f8\:304d\:51fa\:3057\:3092\:59cb\:3081\:3066\:3001\:898b\:5f35\:308a\:306e\:30bf\:30b9\:30af\:3067\:4ed5\:4e0a\:3052\:308b *)
iSWVideoJobTick[] := Module[{job = $iSWVideoJob, r, nb},
  If[! AssociationQ[job],
    If[Head[$iSWVideoJobTask] === TaskObject, Quiet[TaskRemove[$iSWVideoJobTask]]];
    $iSWVideoJobTask = None; Return[Null]];
  nb = Lookup[job["Meta"], "Notebook", None];
  r = iSWVideoComposePoll[job];
  If[r["Status"] === "Running",
    If[Head[nb] === NotebookObject, iSWStatus[nb, iSL["\:9332\:97f3\:304b\:3089\:52d5\:753b\:3092\:66f8\:304d\:51fa\:3057\:3066\:3044\:307e\:3059 ", "Encoding the recorded video "] <> iSWVideoPercent[r]]];
    Return[Null]];
  $iSWVideoJob = None;
  If[Head[$iSWVideoJobTask] === TaskObject, Quiet[TaskRemove[$iSWVideoJobTask]]];
  $iSWVideoJobTask = None;
  If[r["Status"] === "Done",
    iSWVideoFinalize[job, r];
    If[Head[nb] === NotebookObject,
      iSWStatus[nb, iSL["\:9332\:97f3\:304b\:3089\:52d5\:753b\:304c\:3067\:304d\:307e\:3057\:305f: ", "The recorded video is ready: "] <> FileNameTake[job["Output"]] <>
        " (" <> iSWClock[job["Total"]] <> ")" <>
        If[$iSWVideoLast["Missing"] =!= {}, iSL["\:3002\:58f0\:306e\:7121\:3044\:679a ", ". Slides without voice: "] <> ToString[Length[$iSWVideoLast["Missing"]]], ""]]],
    $iSWVideoLast = <|"Status" -> "Failed", "Error" -> r["Error"]|>;
    If[Head[nb] === NotebookObject, iSWStatus[nb, iSL["\:9332\:97f3\:304b\:3089\:52d5\:753b\:3092\:66f8\:304d\:51fa\:305b\:307e\:305b\:3093\:3067\:3057\:305f (SlideTalkVideoStatus[] \:3092\:78ba\:8a8d)", "Could not encode the recorded video (see SlideTalkVideoStatus[])"]]]];
  Null];

iSWVideoJobWatch[job_Association] := (
  $iSWVideoJob = job;
  If[Head[$iSWVideoJobTask] === TaskObject, Quiet[TaskRemove[$iSWVideoJobTask]]];
  $iSWVideoJobTask = Quiet[SessionSubmit[ScheduledTask[If[! iSWFEHeldQ[], iSWVideoJobTick[]], 2]]]);

(* gpt-live-1: \:539f\:7a3f\:3092\:8aad\:307f\:4e0a\:3052\:306a\:304c\:3089 1 \:679a\:305a\:3064\:9332\:308b\:3002\:9332\:308c\:3066\:3044\:306a\:3044\:6700\:521d\:306e\:679a\:304b\:3089 *)
iSWVideoRecordStart[nb_NotebookObject, spec_Association] := Module[{need, res},
  need = Select[spec["Keys"], ! FileExistsQ[spec["Files"][#]] &];
  If[need === {},
    Return[iSWVideoCompose[nb, spec["Images"], spec["Include"], spec["Files"], spec["Titles"], spec["Output"], spec["Meta"]]]];
  If[! iSWSlideShowQ[nb], Quiet[SlideToggleScreenEnvironment[nb]]];
  $iSWVideoRecord = Join[spec, <|"Notebook" -> nb, "StartedAt" -> AbsoluteTime[]|>];
  res = SlidePlay[nb, "Translate" -> False, "Record" -> True, "StartSlide" -> First[need]];
  If[$iSWPlayState["Status"] =!= "Playing",
    $iSWVideoRecord = None;
    Return[If[FailureQ[res], res,
      iSWVideoFail["SlideVideoRecordFailed", "\:9332\:97f3\:306e\:305f\:3081\:306e\:8aad\:307f\:4e0a\:3052\:3092\:59cb\:3081\:3089\:308c\:307e\:305b\:3093\:3067\:3057\:305f\:3002", "Could not start the narration to record."]]]];
  <|"Status" -> "Recording", "From" -> First[need], "Slides" -> Length[need], "Output" -> spec["Output"]|>];

(* \:518d\:751f\:306e\:7d42\:308f\:308a (iSWPlayFinish) \:304b\:3089\:547c\:3070\:308c\:308b\:3002\:91cd\:3044\:51e6\:7406\:306f\:3057\:306a\:3044: ffmpeg \:3092\:8d77\:3053\:3057\:3066\:898b\:5f35\:308a\:306b\:6e21\:3059\:3060\:3051 *)
iSWVideoRecordDone[] := Module[{spec = $iSWVideoRecord, nb, audio, segs, job},
  If[! AssociationQ[spec], Return[Null]];
  $iSWVideoRecord = None;
  nb = spec["Notebook"];
  audio = Select[spec["Files"], StringQ[#] && FileExistsQ[#] &];
  segs = iSWVideoSegments[spec["Images"], audio, spec["Include"], spec["Titles"]];
  job = iSWVideoComposeStart[segs, spec["Output"],
    Join[spec["Meta"], <|"Missing" -> Complement[Keys[spec["Files"]], Keys[audio]]|>]];
  If[FailureQ[job],
    $iSWVideoLast = <|"Status" -> "Failed", "Error" -> iSWFailureText[job]|>;
    If[Head[nb] === NotebookObject, iSWStatus[nb, iSL["\:9332\:97f3\:304b\:3089\:52d5\:753b\:3092\:4f5c\:308c\:307e\:305b\:3093\:3067\:3057\:305f: ", "Could not make the video from the recording: "] <> iSWFailureText[job]]];
    Return[Null]];
  If[Head[nb] === NotebookObject, iSWStatus[nb, iSL["\:9332\:97f3\:304b\:3089\:52d5\:753b\:3092\:66f8\:304d\:51fa\:3057\:3066\:3044\:307e\:3059 0%", "Encoding the recorded video 0%"]]];
  iSWVideoJobWatch[job];
  Null];

(* \:505c\:6b62\:3067\:9332\:97f3\:3092\:3084\:3081\:305f\:3068\:304d\:3002\:9332\:308c\:305f\:679a\:306f\:6b8b\:308b *)
iSWVideoRecordAbort[] := If[AssociationQ[$iSWVideoRecord],
