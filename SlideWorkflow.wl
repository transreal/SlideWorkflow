(* \:7d20\:6750 1 \:518a\:5206\:306e\:90e8\:5206\:30b0\:30e9\:30d5\:3002firstQ \:306a\:3089\:6700\:521d\:306e\:30ce\:30fc\:30c9\:306f root (Claim)\:3001\:305d\:3046\:3067\:306a\:3051\:308c\:3070\:90e8 (Section\:3001Id idp<>"root")\:3002
