(* HTTP \:306e\:5dee\:3057\:8fbc\:307f\:53e3 (\:30c6\:30b9\:30c8\:7528)\:3002\:8981\:6c42 <|Method, URL, Headers, Body, TimeConstraint|> ->
   <|StatusCode, Headers (\:5c0f\:6587\:5b57\:306e\:540d\:524d), BodyBytes|> *)
iSWYTHTTP[req_Association] :=
  If[$SlideYouTubeHTTPHandler === None || $SlideYouTubeHTTPHandler === Automatic,
    iSWYTRealHTTP[req], $SlideYouTubeHTTPHandler[req]];

iSWYTRealHTTP[req_Association] := Module[{spec, resp, body},
  spec = <|Method -> Lookup[req, "Method", "GET"], "Headers" -> Normal[Lookup[req, "Headers", <||>]]|>;
  body = Lookup[req, "Body", None];
  If[ByteArrayQ[body] || StringQ[body], spec["Body"] = body];
  resp = TimeConstrained[
    Quiet[Check[URLRead[HTTPRequest[req["URL"], spec], FollowRedirects -> False], $Failed]],
    Lookup[req, "TimeConstraint", 300], $Failed];
  If[Head[resp] =!= HTTPResponse, Return[<|"StatusCode" -> 0, "Headers" -> <||>, "BodyBytes" -> None|>]];
  <|"StatusCode" -> resp["StatusCode"],
    "Headers" -> KeyMap[ToLowerCase, Association[Replace[Quiet[resp["Headers"]], Except[_List] -> {}]]],
    "BodyBytes" -> Quiet[resp["BodyByteArray"]]|>];

iSWYTJSON[resp_Association] := With[{b = Lookup[resp, "BodyBytes", None]},
  If[ByteArrayQ[b] && Length[b] > 0,
    Replace[Quiet[Check[ImportByteArray[b, "RawJSON"], <||>]], Except[_Association] -> <||>], <||>]];
iSWYTJSON[_] := <||>;

iSWYTErrorText[resp_, json_] := Module[{e = Lookup[json, "error", None]},
  Which[
    AssociationQ[e], ToString[Lookup[e, "code", ""]] <> " " <> ToString[Lookup[e, "message", ""]] <>
      With[{rs = Lookup[e, "errors", {}]}, If[ListQ[rs] && rs =!= {} && AssociationQ[First[rs]],
        " (" <> ToString[Lookup[First[rs], "reason", ""]] <> ")", ""]],
    StringQ[e], e <> " " <> ToString[Lookup[json, "error_description", ""]],
    True, "HTTP " <> ToString[Lookup[resp, "StatusCode", 0]]]];

iSWYTForm[url_String, fields_List] := iSWYTHTTP[<|"Method" -> "POST", "URL" -> url,
  "Headers" -> <|"Content-Type" -> "application/x-www-form-urlencoded"|>,
  "Body" -> StringRiffle[(#[[1]] <> "=" <> URLEncode[ToString[#[[2]]]]) & /@ fields, "&"],
  "TimeConstraint" -> 60|>];

iSWYTCredSet[key_String, val_String] := iSWCredAvailableQ[] && TrueQ[Quiet[NBAccess`NBSetCredential[key, val]]];
