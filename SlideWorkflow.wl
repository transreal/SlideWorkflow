(* SourceVault.wl \:304c\:8aad\:307f\:8fbc\:3080\:304c\:3001SlideWorkflow \:5358\:4f53\:3067\:3082\:96a3\:306e SourceVault_knowledgegraph.wl \:3092\:62fe\:3046 *)
iSWKGEnsure[] := Module[{dir, f},
