(* \:30d1\:30b9\:30ef\:30fc\:30c9: \:30aa\:30d7\:30b7\:30e7\:30f3 > SystemCredential > (FE \:306a\:3089) \:30c0\:30a4\:30a2\:30ed\:30b0\:3067\:4fdd\:5b58\:3002mp4 \:3068\:540c\:3058\:8cc7\:683c\:60c5\:5831\:540d *)
iSWUploadPassword[p_Association, pwOpt_, interactiveOpt_] := Module[{credName = iSWUploadCredentialName[p], pw = pwOpt, interactive},
  interactive = Replace[interactiveOpt, Automatic :> TrueQ[$Notebooks]];
  If[StringQ[pw], Return[pw]];
  If[pw =!= None,
    If[! iSWCredAvailableQ[], Return[iSWCredNBAccessFailure[]]];
    pw = iSWCredGet[credName];
    If[pw === None && TrueQ[interactive],
      With[{r = SlideUploadCredential[p["URL"]]},
        If[AssociationQ[r] && TrueQ[r["Configured"]], pw = iSWCredGet[credName]]]]];
  If[StringQ[pw], pw,
    Failure["SlideUploadCredentialMissing",
      <|"MessageTemplate" -> "sftp \:306e\:30d1\:30b9\:30ef\:30fc\:30c9\:304c\:672a\:8a2d\:5b9a\:3067\:3059: " <> credName <> "\:3002SlideUploadCredential[\"" <> credName <>
          "\"] (\:30c0\:30a4\:30a2\:30ed\:30b0) \:304b SlideUploadCredential[url, password] \:3067\:4fdd\:5b58\:3057\:3066\:304f\:3060\:3055\:3044\:3002",
        "Credential" -> credName|>]]];

Options[SlidePosterUpload] = {
  "UploadURL" -> Automatic, "PosterURL" -> Automatic, "File" -> Automatic,
  "Method" -> Automatic, "Password" -> Automatic, "User" -> Automatic,
  "Force" -> False, "Verify" -> True, "Interactive" -> Automatic};
SlidePosterUpload[opts : OptionsPattern[]] := With[{nb = iSWResolveTargetNb[]},
  If[Head[nb] === NotebookObject, SlidePosterUpload[nb, opts],
    Failure["NoNotebook", <|"MessageTemplate" -> "target notebook not found"|>]]];
SlidePosterUpload[src : Except[_Rule | _RuleDelayed], opts : OptionsPattern[]] := Module[
  {meta, uploadURL, posterURL, p, local, deckPath, bytes, fileName, remoteURL, head, pw, methods, res, t0, verify},
  meta = If[OptionValue["UploadURL"] === Automatic || OptionValue["PosterURL"] === Automatic, iSWUploadMetaOf[src], <||>];
  posterURL = Replace[OptionValue["PosterURL"], Automatic :> Lookup[meta, "PosterURL", ""]];
  posterURL = If[StringQ[posterURL], StringTrim[posterURL], ""];
  uploadURL = Replace[OptionValue["UploadURL"], Automatic :>
    With[{pu = Lookup[meta, "PosterUploadURL", ""]}, If[StringQ[pu] && StringTrim[pu] =!= "", pu, Lookup[meta, "UploadURL", ""]]]];
  If[! StringQ[uploadURL] || StringTrim[uploadURL] === "",
    Return[Failure["SlideUploadURLMissing",
      <|"MessageTemplate" -> "\:30dd\:30b9\:30bf\:30fc\:306e\:914d\:7f6e\:5148\:304c\:3042\:308a\:307e\:305b\:3093\:3002\:30c7\:30c3\:30ad\:5148\:982d\:306e\:6307\:793a\:30bb\:30eb (Directive) \:306b  PosterHost: sftp://user@host/dir  (\:7121\:3051\:308c\:3070 Host:) \:306e\:884c\:3092\:66f8\:3044\:3066\:304f\:3060\:3055\:3044\:3002"|>]]];
  p = iSWUploadTarget[uploadURL, OptionValue["User"]];
  If[FailureQ[p], Return[p]];
  local = Replace[OptionValue["File"], Automatic :> iSWPosterFileOf[src]];
  If[! StringQ[local],
    Return[Failure["SlidePosterFileMissing", <|"MessageTemplate" -> "\:30a2\:30c3\:30d7\:30ed\:30fc\:30c9\:3059\:308b\:30dd\:30b9\:30bf\:30fc\:306e PDF \:3092\:7279\:5b9a\:3067\:304d\:307e\:305b\:3093\:3002\"File\" -> path \:3067\:6307\:5b9a\:3057\:3066\:304f\:3060\:3055\:3044\:3002"|>]]];
  deckPath = Which[
    Head[src] === NotebookObject, Replace[Quiet[NotebookFileName[src]], Except[_String] -> None],
    StringQ[src] && ToLowerCase[FileExtension[src]] === "nb" && FileExistsQ[src], src,
    True, None];
  If[! FileExistsQ[local],
    Return[Failure["SlidePosterFileMissing",
      <|"MessageTemplate" -> "\:30dd\:30b9\:30bf\:30fc\:306e PDF \:304c\:3042\:308a\:307e\:305b\:3093: " <> local <> " (\:30d1\:30ec\:30c3\:30c8\:306e\:300c\:30dd\:30b9\:30bf\:30fc\:300d\:3067\:4f5c\:6210\:3057\:3066\:304b\:3089\:767b\:9332\:3057\:3066\:304f\:3060\:3055\:3044)", "File" -> local|>]]];
  If[StringQ[deckPath] && ! TrueQ[OptionValue["Force"]] && iSWPosterStaleQ[deckPath, local],
    Return[Failure["SlidePosterStale",
      <|"MessageTemplate" -> "\:30dd\:30b9\:30bf\:30fc\:306e PDF \:304c\:30b9\:30e9\:30a4\:30c9\:3088\:308a\:53e4\:3044\:307e\:307e\:3067\:3059\:3002\:30d1\:30ec\:30c3\:30c8\:306e\:300c\:30dd\:30b9\:30bf\:30fc\:300d\:3067\:4f5c\:308a\:76f4\:3057\:3066\:304b\:3089\:3001\:3082\:3046\:4e00\:5ea6\:300c\:767b\:9332\:300d\:3057\:3066\:304f\:3060\:3055\:3044\:3002\:53e4\:3044 PDF \:306f\:30a2\:30c3\:30d7\:30ed\:30fc\:30c9\:3057\:3066\:3044\:307e\:305b\:3093\:3002",
        "File" -> local|>]]];
  bytes = FileByteCount[local];
  fileName = If[posterURL =!= "", iSWURLFileName[posterURL], ""];
  If[fileName === "", fileName = FileNameTake[local]];
  remoteURL = iSWUploadRemoteURL[p, fileName];
  If[! TrueQ[OptionValue["Force"]] && posterURL =!= "",
    head = iSWURLHead[posterURL];
    If[AssociationQ[head] && head["StatusCode"] === 200 && head["ContentLength"] === bytes,
      Return[<|"Status" -> "Unchanged", "Method" -> None, "File" -> local, "Bytes" -> bytes, "Remote" -> remoteURL,
        "PosterURL" -> posterURL, "Verified" -> True, "RemoteBytes" -> bytes, "Seconds" -> 0.|>]]];
  pw = iSWUploadPassword[p, OptionValue["Password"], OptionValue["Interactive"]];
  If[FailureQ[pw], Return[pw]];
  methods = Flatten[{Replace[OptionValue["Method"], Automatic :> Replace[$SlideUploadMethod, Automatic -> {"Native", "curl"}]]}];
  t0 = AbsoluteTime[];
  res = iSWUploadUnavailable["None", "\:8ee2\:9001\:624b\:6bb5\:304c\:3042\:308a\:307e\:305b\:3093"];
  Do[
    res = iSWUploadWith[m, local, remoteURL, p, pw];
    If[! (FailureQ[res] && Lookup[Last[res], "Class", ""] === "Unavailable"), Break[]],
    {m, methods}];
  If[FailureQ[res], Return[res]];
  verify = If[TrueQ[OptionValue["Verify"]] && posterURL =!= "", iSWURLHead[posterURL], None];
  <|"Status" -> "Uploaded", "Method" -> res["Method"], "File" -> local, "Bytes" -> bytes,
    "Remote" -> remoteURL, "PosterURL" -> posterURL,
    "Verified" -> Which[verify === None, None,
      AssociationQ[verify] && verify["StatusCode"] === 200 && verify["ContentLength"] === bytes, True,
      True, False],
    "RemoteBytes" -> If[AssociationQ[verify], verify["ContentLength"], None],
    "Seconds" -> Round[AbsoluteTime[] - t0, 0.1]|>];

(* \:300c\:767b\:9332\:300d\:306e\:72b6\:614b\:884c\:306b\:51fa\:3059\:30dd\:30b9\:30bf\:30fc\:306e\:4e00\:8a00 *)
iSWPosterUploadNote[pu_] := Which[
  pu === None, "",
  FailureQ[pu] && First[pu] === "SlidePosterStale", iSL["  \:30dd\:30b9\:30bf\:30fc\:306f\:53e4\:3044\:307e\:307e (\:30a2\:30c3\:30d7\:30ed\:30fc\:30c9\:305b\:305a)", "  poster is stale (not uploaded)"],
  FailureQ[pu] && First[pu] === "SlidePosterFileMissing", iSL["  \:30dd\:30b9\:30bf\:30fc PDF \:306a\:3057 (\:300c\:30dd\:30b9\:30bf\:30fc\:300d\:3067\:4f5c\:6210)", "  no poster PDF (press Poster)"],
  FailureQ[pu], iSL["  \:30dd\:30b9\:30bf\:30fc\:306e\:30a2\:30c3\:30d7\:30ed\:30fc\:30c9\:5931\:6557", "  poster upload FAILED"],
  Lookup[pu, "Status", ""] === "Unchanged", iSL["  \:30dd\:30b9\:30bf\:30fc\:306f\:914d\:4fe1\:6e08\:307f (\:5909\:66f4\:306a\:3057)", "  poster already published (unchanged)"],
  True, iSL["  \:30dd\:30b9\:30bf\:30fc\:3092\:30a2\:30c3\:30d7\:30ed\:30fc\:30c9 ", "  poster uploaded "] <> iSWFormatBytes[Lookup[pu, "Bytes", 0]] <>
    Switch[Lookup[pu, "Verified", None], True, iSL[" \:914d\:4fe1\:78ba\:8a8dOK", " verified"], False, iSL[" \:914d\:4fe1\:672a\:78ba\:8a8d", " NOT verified"], _, ""]];

(* ===================== v1.58: \:65e2\:5b58\:306e\:30b9\:30e9\:30a4\:30c9\:304b\:3089\:77e5\:8b58\:30b0\:30e9\:30d5 (\:904e\:53bb\:306e\:30c7\:30c3\:30ad\:3092 SlideWorkflow \:6e96\:62e0\:306b) =====================
   SlideStory \:3092\:66f8\:304b\:305a\:306b\:4f5c\:3063\:305f\:904e\:53bb\:306e\:30c7\:30c3\:30ad (\:4f8b: \:8a08\:7b97\:3068\:81ea\:7136 00\:301c24\:3001Machine Learning) \:306f\:3001\:7b4b\:3092\:8003\:3048\:3066\:4f5c\:308a\:8fbc\:3093\:3067\:3042\:308b\:3002KG \:304b\:3089\:679a\:3092
   \:4f5c\:308a\:76f4\:3059\:306e\:3067\:306f\:306a\:304f\:3001\:679a\:306e\:9806\:3068\:898b\:51fa\:3057\:306e\:69cb\:6210\:3092\:305d\:306e\:307e\:307e KG \:306b\:5199\:3059\:3002\:30b9\:30e9\:30a4\:30c9\:306e\:4e2d\:8eab\:306b\:306f\:624b\:3092\:5165\:308c\:305a\:3001\:984c\:76ee\:30bb\:30eb\:306b KGSync:<id>
   (\:300c\:751f\:6210\:300d\:306e\:7f6e\:304d\:63db\:3048\:5bfe\:8c61\:306b\:306a\:3089\:306a\:3044\:5bfe\:5fdc\:30bf\:30b0) \:3068\:3001\:524d\:7f6e\:304d\:306b\:6307\:793a\:30bb\:30eb\:30fbStory \:30bb\:30eb (Graph: / Source: \:30b9\:30e9\:30a4\:30c9 / \:984c\:76ee\:306e\:4e26\:3073) \:3092\:8db3\:3059\:3060\:3051\:3002
   - \:898b\:51fa\:3057: Title\:30fbChapter (\:30c7\:30c3\:30ad\:306e\:984c) > Section > Subsection > Subsubsection\:3002\:679a\:306e\:5148\:982d 3 \:30bb\:30eb\:4ee5\:5185\:306e\:6700\:521d\:306e\:898b\:51fa\:3057\:304c\:305d\:306e\:679a\:306e\:984c\:76ee
   - \:898b\:51fa\:3057\:306e\:7121\:3044\:679a\:3068\:3001\:540c\:3058\:984c\:76ee\:304c\:7d9a\:304f\:679a\:306f\:300c\:7d9a\:304d\:300d= \:540c\:3058\:30ce\:30fc\:30c9 (\:8981\:70b9\:306f\:307e\:3068\:3081\:3066\:6301\:3064)
   - \:898b\:51fa\:3057\:304c 2 \:6bb5\:4ee5\:4e0a\:3042\:308c\:3070\:4e0a\:306e\:6bb5\:3092\:90e8 (Section \:30ce\:30fc\:30c9)\:30011 \:6bb5\:306a\:3089\:6839\:306e\:4e0b\:306b\:5e73\:3089\:306b\:4e26\:3079\:308b (\:90e8\:304c\:8981\:308b\:306a\:3089\:300c\:968e\:5c64\:5316\:300d)
   - \:984c\:76ee\:304c\:7a7a\:306e\:679a (\:8868\:7d19) \:306f\:6839\:306e\:8981\:7d04\:3078\:3002\:984c\:76ee\:304c $SlideGraphTailTitles (\:6700\:5f8c\:5c3e \:306a\:3069) \:306e\:679a\:304b\:3089\:5f8c\:308d (\:30e1\:30e2\:30fb\:30b3\:30fc\:30c9) \:306f\:5165\:308c\:306a\:3044
   - \:65e2\:306b KGNode / KGSync \:306e\:30bf\:30b0\:304c\:3042\:308b\:984c\:76ee\:306f\:3001\:305d\:306e\:30ce\:30fc\:30c9 Id \:3092\:4f7f\:3046 (\:5199\:3057\:76f4\:3057\:3066\:3082 Id \:304c\:5909\:308f\:3089\:306a\:3044)
   - \:5199\:3057\:76f4\:3057 (Refresh) \:306f\:3001\:63a8\:6572\:30fb\:610f\:5473\:4ed8\:3051\:3067\:8db3\:3055\:308c\:305f\:9805\:76ee\:3068\:5468\:8fba\:77e5\:8b58 (Layer \:304c Paper \:4ee5\:5916) \:3092\:6b8b\:3057\:3001\:30b9\:30e9\:30a4\:30c9\:304b\:3089\:53d6\:308c\:308b\:9805\:76ee\:3060\:3051\:7f6e\:304d\:63db\:3048\:308b
   - Story \:304c Source: \:30b9\:30e9\:30a4\:30c9 \:306e\:30c7\:30c3\:30ad\:3067\:306f\:3001\:30d1\:30ec\:30c3\:30c8\:306e\:300c\:751f\:6210\:300d\:3092\:6b62\:3081\:308b (\:65e2\:5b58\:306e\:30b9\:30e9\:30a4\:30c9\:304c\:6b63) *)

$SlideGraphTailTitles = {"\:6700\:5f8c\:5c3e", "Appendix", "\:4ed8\:9332"};
$iSWS2KHeadingRank = <|"Title" -> 0, "Chapter" -> 0, "Section" -> 1, "Subsection" -> 2, "Subsubsection" -> 3|>;
$iSWS2KSkipStyles = {"SlideShowNavigationBar", "SlideTalk", "SlidePosterTalk", "SlideQA", "SlidePrompt", "SlideCrumb", "Note",
  "Directive", "SlideStory", "References", "SlidePoster", "SlideReading", "SlideDictionary", "SlideAdjust", "Print", "Message", "Echo"};
$iSWS2KSubStyles = {"Subitem", "Subsubitem", "SubitemNumbered", "SubsubitemNumbered", "ItemParagraph", "SubitemParagraph", "SubsubitemParagraph"};

iSWS2KStyle[Cell[_, s_String, ___]] := s;
iSWS2KStyle[_] := None;
iSWS2KText[c_] := With[{t = Quiet[iSWSlideCellText[c]]},
  If[StringQ[t], StringTrim[StringReplace[t, (WhitespaceCharacter ..) -> " "]], ""]];
iSWS2KClip[s_String, n_Integer] := If[StringLength[s] <= n, s, StringTake[s, n - 1] <> "\:2026"];
iSWS2KTags[c_Cell] := Flatten[Cases[Rest[List @@ c], (CellTags -> t_) :> {t}, 1]];
iSWS2KTags[_] := {};
iSWS2KContent[cells_List] := Select[cells, ! MemberQ[$iSWS2KSkipStyles, iSWS2KStyle[#]] &];

(* \:679a\:306e\:984c\:76ee = \:5148\:982d 3 \:30bb\:30eb\:4ee5\:5185\:306e\:6700\:521d\:306e\:898b\:51fa\:3057 (\:7121\:3051\:308c\:3070 None = \:7d9a\:304d) *)
iSWS2KHeading[cells_List] := Module[{c},
  c = SelectFirst[Take[iSWS2KContent[cells], UpTo[3]], KeyExistsQ[$iSWS2KHeadingRank, iSWS2KStyle[#]] &, None];
  If[c === None, None,
    <|"Style" -> iSWS2KStyle[c], "Rank" -> $iSWS2KHeadingRank[iSWS2KStyle[c]], "Text" -> iSWS2KText[c], "Tags" -> iSWS2KTags[c]|>]];

iSWS2KSlide[cells_List, k_Integer] := Module[{content = iSWS2KContent[cells], head, txt, firstItem},
  head = iSWS2KHeading[cells];
  txt[styles_List] := Select[iSWS2KText /@ Select[content, MemberQ[styles, iSWS2KStyle[#]] &], # =!= "" &];
  (* \:5c0e\:5165\:6587 = \:6700\:521d\:306e\:7b87\:6761\:66f8\:304d\:3088\:308a\:524d\:306e Text (\:7b87\:6761\:66f8\:304d\:306e\:5f8c\:308d\:306e Text \:306f\:6ce8\:8a18) *)
  firstItem = Replace[FirstPosition[content, Cell[_, "Item" | "ItemNumbered", ___], {Length[content] + 1}, {1}, Heads -> False], {i_} :> i];
  <|"Slide" -> k, "Heading" -> head,
    "Texts" -> txt[{"Text", "SlideText", "Quote"}], "Items" -> txt[{"Item", "ItemNumbered"}], "Subs" -> txt[$iSWS2KSubStyles],
    "LeadText" -> First[Select[iSWS2KText /@ Select[Take[content, firstItem - 1], MemberQ[{"Text", "SlideText", "Quote"}, iSWS2KStyle[#]] &], # =!= "" &], ""],
    "Talk" -> StringRiffle[Select[iSWS2KText /@ Select[cells, iSWTalkOriginalCellQ], # =!= "" &], " "],
    "Figures" -> Count[cells, _?iVisualCellQ], "Code" -> Count[content, Cell[_, "Input" | "Code", ___]],
    "DeckTitle" -> Quiet[iSWPosterDeckTitleText[cells]]|>];

iSWS2KCoverQ[r_Association] := (AssociationQ[r["Heading"]] && r["Heading"]["Text"] === "") ||
  (r["Heading"] === None && StringQ[r["DeckTitle"]] && r["DeckTitle"] =!= "");
iSWS2KTailQ[r_Association] := AssociationQ[r["Heading"]] && MemberQ[$SlideGraphTailTitles, r["Heading"]["Text"]];
iSWS2KFallbackLabel[r_Association] := iSWS2KClip[First[Join[r["Texts"], r["Items"], {"\:30b9\:30e9\:30a4\:30c9 " <> ToString[r["Slide"]]}]], 30];

(* \:984c\:76ee\:306e\:5207\:308c\:76ee\:3067\:679a\:3092\:307e\:3068\:3081\:308b (\:898b\:51fa\:3057\:306e\:7121\:3044\:679a\:3068\:540c\:3058\:984c\:76ee\:304c\:7d9a\:304f\:679a\:306f\:7d9a\:304d) *)
iSWS2KRuns[recs_List] := Module[{runs = {}, cur = None},
  Do[With[{h = r["Heading"]},
      Which[
        AssociationQ[h] && h["Text"] =!= "" && (cur === None || h["Text"] =!= cur["Label"] || h["Rank"] =!= cur["Rank"]),
          If[cur =!= None, AppendTo[runs, cur]];
          cur = <|"Label" -> h["Text"], "Rank" -> h["Rank"], "Style" -> h["Style"], "Slides" -> {r}, "Tags" -> h["Tags"]|>,
        cur === None,
          cur = <|"Label" -> iSWS2KFallbackLabel[r], "Rank" -> None, "Style" -> None, "Slides" -> {r}, "Tags" -> {}|>,
        True, cur["Slides"] = Append[cur["Slides"], r]]],
    {r, recs}];
  If[cur =!= None, AppendTo[runs, cur]];
  runs];

iSWS2KFields[run_Association] := Module[{sl = run["Slides"], texts, items, subs, lead, pts, talk, all},
  texts = Flatten[Lookup[sl, "Texts"]]; items = Flatten[Lookup[sl, "Items"]]; subs = Flatten[Lookup[sl, "Subs"]];
  lead = FirstCase[Lookup[sl, "LeadText", ""], t_String /; t =!= "", If[items === {} && texts =!= {}, First[texts], ""]];
  (* \:7b87\:6761\:66f8\:304d\:304c\:3042\:308c\:3070\:8981\:70b9 = \:7b87\:6761\:66f8\:304d\:3001\:5c0e\:5165\:6587\:4ee5\:5916\:306e Text \:306f\:6ce8\:8a18 (Details)\:3002\:7121\:3051\:308c\:3070\:8981\:70b9 = \:5c0e\:5165\:6587\:4ee5\:5916\:306e Text *)
  pts = If[items =!= {}, items, DeleteCases[texts, lead, {1}, 1]];
  If[items =!= {}, subs = Join[subs, DeleteCases[texts, lead, {1}, 1]]];
  lead = iSWS2KClip[lead, 200];
  talk = StringRiffle[Select[Lookup[sl, "Talk"], # =!= "" &], " "];
  all = StringRiffle[Join[{run["Label"]}, texts, items, subs], "\n"];
  <|"Lead" -> lead, "Points" -> (iSWS2KClip[#, 160] & /@ Take[pts, UpTo[8]]), "Details" -> (iSWS2KClip[#, 160] & /@ Take[subs, UpTo[8]]),
    "Talk" -> talk, "Text" -> iSWS2KClip[all, 4000],
    "Source" -> <|"Kind" -> "Slides", "Slides" -> Lookup[sl, "Slide"], "Figures" -> Total[Lookup[sl, "Figures"]], "Code" -> Total[Lookup[sl, "Code"]]|>|>];

iSWS2KTagId[tags_] := Replace[iSWKGNodeOfTags[tags], None :> iSWSyncNodeOfTags[tags]];
iSWS2KLang[strs_List] := Module[{s = StringJoin[Select[strs, StringQ]], n, cjk},
  n = Max[1, StringLength[s]];
  cjk = StringCount[s, RegularExpression["[\\x{3040}-\\x{30ff}\\x{4e00}-\\x{9fff}]"]];
  If[cjk/n > 0.05, "ja", "en"]];

(* \:5199\:3057\:76f4\:3057\:306e\:5bfe\:8c61\:304b: \:540c\:3058 Id \:306e KG \:304c\:3001\:3053\:306e\:30c7\:30c3\:30ad\:304b\:3089\:4f5c\:3063\:305f\:3082\:306e (Sources \:306e deck \:304c\:540c\:3058) *)
iSWS2KSameDeckQ[kg_Association, path_] := AnyTrue[Replace[Lookup[kg, "Sources", {}], Except[_List] -> {}],
  AssociationQ[#] && Lookup[#, "Kind", ""] === "SlideDeck" && (! StringQ[path] || Lookup[#, "Locator", ""] === path) &];

(* ---- \:672c\:4f53: \:679a\:306e\:8a18\:9332 \:2192 KG ---- *)
Options[SlideGraphFromSlides] = {"Graph" -> Automatic, "Title" -> Automatic, "Language" -> Automatic, "PrivacyLevel" -> Automatic,
  "Refresh" -> Automatic, "Overwrite" -> False, "Save" -> True, "Write" -> True, "Output" -> Automatic, "InPlace" -> False,
  "DeckPath" -> Automatic};   (* DeckPath: KG \:306e\:51fa\:6240\:3068\:3057\:3066\:8a18\:9332\:3059\:308b\:30c7\:30c3\:30ad (\:30d5\:30a1\:30a4\:30eb\:5909\:63db\:3067\:306f\:66f8\:304d\:5148\:306e _sw.nb) *)

iSWS2KBuild[recs0_List, meta_Association, opt_Association] := Module[
  {recs = recs0, tailAt, covers, body, runs, ranks, partRank, root, title, lang, pl, gid, nodes = {}, edges = {}, ids = <||>,
   parent, lastAt = <||>, curPart = None, used = {}, mkId, prev = None, refreshQ, kg, keep, path = meta["Path"], rootRun = None},
  tailAt = SelectFirst[Range[Length[recs]], iSWS2KTailQ[recs[[#]]] &, None];
  If[IntegerQ[tailAt], recs = Take[recs, tailAt - 1]];
  (* \:5148\:982d\:306e\:8868\:7d19 (\:984c\:76ee\:304c\:7a7a\:30fb\:30bf\:30a4\:30c8\:30eb\:30b9\:30e9\:30a4\:30c9) \:306f\:6839\:306e\:8981\:7d04\:3078 *)
  covers = TakeWhile[recs, iSWS2KCoverQ];
  body = Drop[recs, Length[covers]];
  If[body === {}, Return[Failure["NoSlides", <|"MessageTemplate" -> "\:8868\:7d19\:3068\:300c\:6700\:5f8c\:5c3e\:300d\:4ee5\:964d\:3092\:9664\:304f\:3068\:3001KG \:306b\:3059\:308b\:679a\:304c\:3042\:308a\:307e\:305b\:3093\:3002"|>]]];
  runs = iSWS2KRuns[body];
  (* \:30c7\:30c3\:30ad\:306e\:984c (Title / Chapter) \:3067\:59cb\:307e\:308b\:6700\:521d\:306e\:307e\:3068\:307e\:308a\:306f\:6839 *)
  If[runs =!= {} && First[runs]["Rank"] === 0, rootRun = First[runs]; runs = Rest[runs]];
  ranks = DeleteDuplicates[DeleteCases[Lookup[runs, "Rank", None], None | 0]];
  partRank = If[Length[ranks] >= 2, Min[ranks], None];
  title = FirstCase[{opt["Title"], Lookup[meta, "Title", ""], If[AssociationQ[rootRun], rootRun["Label"], ""], Lookup[meta, "BaseName", ""]},
    s_String /; StringTrim[s] =!= "" && s =!= "Automatic" :> StringTrim[s], "deck"];
  (* \:8a00\:8a9e\:306f\:898b\:51fa\:3057\:3060\:3051\:3067\:306a\:304f\:672c\:6587\:3082\:898b\:308b (\:82f1\:8a9e\:306e\:898b\:51fa\:3057 + \:65e5\:672c\:8a9e\:306e\:672c\:6587\:306e\:30c7\:30c3\:30ad\:304c\:3042\:308b) *)
  lang = Replace[opt["Language"], Automatic :> iSWS2KLang[Join[{title}, Lookup[runs, "Label", {}],
    Flatten[Lookup[body, "Texts", {}]], Flatten[Lookup[body, "Items", {}]]]]];
  lang = iSWKGLangCode[lang];
  pl = Replace[opt["PrivacyLevel"], Automatic :> Lookup[meta, "PrivacyLevel", 0.5]];
  If[! NumericQ[pl], pl = 0.5];
  gid = Replace[opt["Graph"], Automatic :> Lookup[meta, "Graph", None]];
  If[! StringQ[gid] || StringTrim[gid] === "", gid = iSWKGDefaultGraphId[Lookup[meta, "BaseName", title]]];
  (* \:540c\:3058 Id \:306e KG: \:3053\:306e\:30c7\:30c3\:30ad\:306e\:3082\:306e = \:5199\:3057\:76f4\:3057\:3001\:5225\:306e\:30c7\:30c3\:30ad\:306e\:3082\:306e = Id \:3092\:305a\:3089\:3059 (Overwrite \:306a\:3089\:4e0a\:66f8\:304d) *)
  prev = If[TrueQ[opt["Save"]] || opt["Refresh"] =!= False, Quiet @ Check[SourceVault`SourceVaultKGLoad[gid], $Failed], $Failed];
  (* \:3053\:306e\:30c7\:30c3\:30ad\:306e KG = Story \:306e Graph: \:304c\:3053\:306e Id\:3001\:307e\:305f\:306f KG \:306e\:51fa\:6240\:304c\:3053\:306e\:30c7\:30c3\:30ad *)
  refreshQ = AssociationQ[prev] && (TrueQ[opt["Refresh"]] || (opt["Refresh"] === Automatic &&
    ((StringQ[Lookup[meta, "Graph", None]] && meta["Graph"] === gid) || iSWS2KSameDeckQ[prev, path])));
  If[AssociationQ[prev] && ! refreshQ && ! TrueQ[opt["Overwrite"]],
    Module[{k = 2, g2},
      While[k < 50 && AssociationQ[Quiet @ Check[SourceVault`SourceVaultKGLoad[g2 = gid <> "-" <> ToString[k]], $Failed]], k++];
      gid = g2; prev = $Failed]];
  If[! refreshQ, prev = $Failed];
  (* Id: \:984c\:76ee\:30bb\:30eb\:306b\:65e2\:306b\:3042\:308b KGNode / KGSync \:3092\:4f7f\:3046\:3002\:7121\:3051\:308c\:3070 s<\:6700\:521d\:306e\:679a> *)
  mkId[run_] := Module[{t = iSWS2KTagId[run["Tags"]], id},
    id = If[StringQ[t] && t =!= "", t, "s" <> ToString[First[run["Slides"]]["Slide"]]];
    While[MemberQ[used, id], id = id <> "_2"];
    AppendTo[used, id]; id];
  AppendTo[used, "root"];
  root = <|"Id" -> "root", "Kind" -> "Claim", "Label" -> title, "Importance" -> 1., "Difficulty" -> 0.3, "Order" -> 0, "Layer" -> "Paper",
    "Summary" -> iSWS2KClip[StringRiffle[DeleteDuplicates[Select[Flatten[{Lookup[covers, "DeckTitle", {}], Lookup[covers, "Texts", {}],
      If[AssociationQ[rootRun], Lookup[rootRun["Slides"], "Texts"], {}]}], StringQ[#] && # =!= "" &]], " / "], 400],
    "Points" -> If[AssociationQ[rootRun], iSWS2KFields[rootRun]["Points"], {}],
    "Text" -> StringRiffle[Lookup[runs, "Label", {}], " / "],
    "Source" -> <|"Kind" -> "Slides", "Deck" -> Replace[path, None -> ""], "Covers" -> Lookup[covers, "Slide", {}],
      "Slides" -> If[AssociationQ[rootRun], Lookup[rootRun["Slides"], "Slide"], {}]|>|>;
  AppendTo[nodes, root];
  Do[Module[{run = runs[[i]], id, f, partQ, par},
      id = mkId[run]; ids[i] = id;
      partQ = partRank =!= None && run["Rank"] === partRank;
      par = Which[partQ || partRank === None, "root", StringQ[curPart], curPart, True, "root"];
      If[partQ, curPart = id];
      f = iSWS2KFields[run];
      AppendTo[nodes, Join[<|"Id" -> id, "Kind" -> If[partQ, "Section", "Concept"], "Label" -> run["Label"],
        "Importance" -> If[partQ, 0.9, 0.7], "Difficulty" -> 0.4, "Order" -> i, "Layer" -> "Paper"|>, f]];
      AppendTo[edges, <|"From" -> par, "To" -> id, "EdgeKind" -> "Contains", "Weight" -> 0.9|>];
      If[KeyExistsQ[lastAt, par], AppendTo[edges, <|"From" -> lastAt[par], "To" -> id, "EdgeKind" -> "Precedes", "Weight" -> 0.6|>]];
      lastAt[par] = id],
    {i, Length[runs]}];
  (* \:5199\:3057\:76f4\:3057: \:63a8\:6572\:30fb\:610f\:5473\:4ed8\:3051\:3067\:8db3\:3055\:308c\:305f\:9805\:76ee (Role / Bridge / Notes / QA \:306a\:3069) \:3068\:5468\:8fba\:77e5\:8b58\:3092\:6b8b\:3059 *)
  If[AssociationQ[prev],
    With[{old = Association[(#["Id"] -> #) & /@ Select[Lookup[prev, "Nodes", {}], AssociationQ]]},
      nodes = Map[If[KeyExistsQ[old, #["Id"]], Join[old[#["Id"]], #], #] &, nodes];
      keep = Select[Values[old], Lookup[#, "Layer", "Paper"] =!= "Paper" &];
      nodes = Join[nodes, keep];
      With[{kids = Lookup[keep, "Id", {}], all = Lookup[nodes, "Id"]},
        edges = Join[edges, Select[Lookup[prev, "Edges", {}], AssociationQ[#] && (MemberQ[kids, #["From"]] || MemberQ[kids, #["To"]]) &&
          MemberQ[all, #["From"]] && MemberQ[all, #["To"]] &]]]]];
  kg = SourceVault`SourceVaultKGFromJSON[<|"GraphId" -> gid, "Title" -> title, "Language" -> lang, "Kind" -> "Slides", "Root" -> "root",
    "PrivacyLevel" -> N[pl],
    "Sources" -> {<|"Key" -> "deck", "Locator" -> Replace[path, None -> ""], "Kind" -> "SlideDeck", "Note" -> "\:65e2\:5b58\:306e\:30b9\:30e9\:30a4\:30c9 (SlideGraphFromSlides)"|>},
    "Nodes" -> nodes, "Edges" -> edges|>];
  If[! AssociationQ[kg], Return[kg]];
  <|"KG" -> kg, "Graph" -> gid, "Title" -> title, "Language" -> lang, "PrivacyLevel" -> N[pl], "Refreshed" -> AssociationQ[prev],
    "Runs" -> runs, "Ids" -> ids, "RootRun" -> rootRun, "Parts" -> If[partRank === None, 0, Count[Lookup[runs, "Rank"], partRank]],
    "Covers" -> Lookup[covers, "Slide", {}], "Tail" -> If[IntegerQ[tailAt], Range[tailAt, Length[recs0]], {}], "SlideCount" -> Length[recs0]|>];

(* \:524d\:7f6e\:304d\:306e\:30e1\:30bf\:30bb\:30eb\:306e\:6587 *)
iSWS2KStoryText[b_Association] := Module[{titles = Lookup[b["Runs"], "Label", {}]},
  StringRiffle[{
    "Graph: " <> b["Graph"],
    If[b["Language"] === "ja", "Source: \:30b9\:30e9\:30a4\:30c9 (\:65e2\:5b58\:306e\:30b9\:30e9\:30a4\:30c9\:304c\:6b63\:3002\:300c\:751f\:6210\:300d\:3067\:4f5c\:308a\:76f4\:3055\:306a\:3044\:3002\:300cKG\:69cb\:7bc9\:300d\:3067\:30b9\:30e9\:30a4\:30c9\:304b\:3089\:5199\:3057\:76f4\:3059)",
      "Source: slides (the existing slides are the source; do not regenerate them; Build KG re-mirrors the slides)"],
    "Slides: " <> ToString[b["SlideCount"]],
    "Language: " <> b["Language"],
    "Story: " <> If[b["Language"] === "ja", "\:65e2\:5b58\:306e\:30b9\:30e9\:30a4\:30c9\:306e\:9806: ", "Order of the existing slides: "] <>
      StringRiffle[Take[titles, UpTo[40]], " \:2192 "] <> If[Length[titles] > 40, " \:2026", ""]}, "\n"]];

(* \:679a k \:306e\:984c\:76ee\:30bb\:30eb (FE): \:5148\:982d 3 \:30bb\:30eb\:4ee5\:5185\:306e\:6700\:521d\:306e\:898b\:51fa\:3057 *)
iSWS2KTitleCellFE[cells_List, styles_List, range_List] := Module[{idx},
  idx = Select[Range[range[[1]], Min[range[[2]], Length[styles]]], ! IntersectingQ[Flatten[{styles[[#]]}], $iSWS2KSkipStyles] &];
  idx = SelectFirst[Take[idx, UpTo[3]], IntersectingQ[Flatten[{styles[[#]]}], Keys[$iSWS2KHeadingRank]] &, None];
  If[IntegerQ[idx], cells[[idx]], None]];

iSWS2KWriteFE[nb_NotebookObject, b_Association] := Module[{ranges = iSWSlideRanges[nb], cells = Cells[nb], styles = iSWCellStyles[nb],
    tagged = 0, slideNode = <||>, firstNav, meta = {}, storyCO, dirCO, text},
  If[Length[ranges] =!= b["SlideCount"],
    Return[Failure["SlideCountMismatch", <|"MessageTemplate" -> "\:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:306e\:679a\:6570 (`1`) \:3068\:8aad\:307f\:53d6\:3063\:305f\:679a\:6570 (`2`) \:304c\:5408\:3044\:307e\:305b\:3093\:3002\:4fdd\:5b58\:3057\:3066\:304b\:3089\:3082\:3046\:4e00\:5ea6\:3002",
      "MessageParameters" -> {Length[ranges], b["SlideCount"]}|>]]];
  KeyValueMap[Function[{i, id}, Scan[(slideNode[#] = id) &, Lookup[b["Runs"][[i]]["Slides"], "Slide"]]], b["Ids"]];
  If[AssociationQ[b["RootRun"]], Scan[(slideNode[#] = "root") &, Lookup[b["RootRun"]["Slides"], "Slide"]]];
  KeyValueMap[Function[{k, id}, With[{co = iSWS2KTitleCellFE[cells, styles, ranges[[k]]]},
      If[co =!= None,
        With[{tags = Flatten[{Replace[iSWCellTags[co], Except[_List | _String] -> {}]}]},
          If[iSWKGNodeOfTags[tags] === None,
            SetOptions[co, CellTags -> Append[Select[tags, StringQ[#] && ! StringStartsQ[#, $iSWSyncTagPrefix] &], $iSWSyncTagPrefix <> id]]];
          tagged++]]]], slideNode];
  Quiet[SlideEnsureDeckStyles[nb]];
  (* \:524d\:7f6e\:304d: \:6307\:793a\:30bb\:30eb (\:7121\:3051\:308c\:3070) \:3068 Story \:30bb\:30eb (\:7121\:3051\:308c\:3070\:8db3\:3059\:3001\:3042\:3063\:3066 Graph: \:304c\:7121\:3051\:308c\:3070\:5148\:982d\:306b\:8db3\:3059) *)
  styles = iSWCellStyles[nb]; cells = Cells[nb];
  storyCO = SelectFirst[Range[Length[cells]], MemberQ[Flatten[{styles[[#]]}], "SlideStory"] &, None];
  dirCO = SelectFirst[Range[Length[cells]], MemberQ[Flatten[{styles[[#]]}], "Directive"] &, None];
  If[dirCO === None,
    AppendTo[meta, Cell["Title: " <> b["Title"] <> "\nPrivacyLevel: " <> ToString[b["PrivacyLevel"]] <> "\n", "Directive"]]];
  If[storyCO === None,
    AppendTo[meta, Cell[iSWS2KStoryText[b], "SlideStory"]],
    text = Quiet[iSWSlideCellText[NotebookRead[cells[[storyCO]]]]];
    If[StringQ[text] && ! StringContainsQ[text, RegularExpression["(?m)^\\s*Graph\\s*:\\s*\\S"]],
      SelectionMove[cells[[storyCO]], All, Cell];
      NotebookWrite[nb, Cell["Graph: " <> b["Graph"] <> "\nSource: " <> If[b["Language"] === "ja", "\:30b9\:30e9\:30a4\:30c9", "slides"] <> "\n" <> text, "SlideStory"]]]];
  If[meta =!= {},
    ranges = iSWSlideRanges[nb]; cells = Cells[nb];
    firstNav = ranges[[1, 1]];
    SelectionMove[cells[[firstNav]], Before, Cell];
    NotebookWrite[nb, meta]];
  <|"Tagged" -> tagged, "MetaCells" -> Length[meta]|>];

SlideGraphFromSlides[opts : OptionsPattern[]] := With[{nb = iSWNotebook[]},
  If[nb === $Failed, $Failed, SlideGraphFromSlides[nb, opts]]];
SlideGraphFromSlides[nb_NotebookObject, opts : OptionsPattern[]] := Module[{opt, src, nbExpr, data, recs, meta, b, saved, w = None, fn, story},
  If[! iSWKGEnsure[], Return[iSWKGFail[]]];
  opt = Association[Options[SlideGraphFromSlides], FilterRules[{opts}, Options[SlideGraphFromSlides]]];
  src = iSWDeckTextSource[nb];
  nbExpr = Quiet @ Check[iAsNotebook[src], $Failed];
  If[Head[nbExpr] =!= Notebook, Return[Failure["NoNotebook", <|"MessageTemplate" -> "\:30ce\:30fc\:30c8\:30d6\:30c3\:30af\:3092\:8aad\:3081\:307e\:305b\:3093"|>]]];
  data = Quiet @ Check[iSlideSplit[nbExpr, iFlattenCells], $Failed];
  If[! AssociationQ[data] || data["Slides"] === {},
    Return[Failure["NoSlides", <|"MessageTemplate" -> "\:30b9\:30e9\:30a4\:30c9 (SlideShowNavigationBar \:3067\:533a\:5207\:3089\:308c\:305f\:679a) \:304c\:898b\:3064\:304b\:308a\:307e\:305b\:3093\:3002"|>]]];
  recs = MapIndexed[iSWS2KSlide[#1, First[#2]] &, data["Slides"]];
  fn = Quiet[NotebookFileName[nb]];
  story = Quiet @ Check[Fold[Join[#2, #1] &, <||>, iSWParseStoryText /@ iSWStyleTexts[nb, "SlideStory"]], <||>];
  meta = Join[KeyTake[Replace[Quiet @ Check[iSWDirectiveMeta[nb], <||>], Except[_Association] -> <||>], {"Title", "PrivacyLevel"}],
    <|"Graph" -> Lookup[Replace[story, Except[_Association] -> <||>], "Graph", None],
      "Path" -> Replace[opt["DeckPath"], Automatic :> If[StringQ[fn], fn, None]],
      "BaseName" -> If[StringQ[fn], FileBaseName[fn], Last[iSWDeckBaseName[nb]]]|>];
  b = iSWS2KBuild[recs, meta, opt];
  If[! AssociationQ[b], Return[b]];
  If[TrueQ[opt["Save"]],
    saved = SourceVault`SourceVaultKGSave[b["KG"]];
    If[! StringQ[saved], Return[Failure["SaveFailed", <|"MessageTemplate" -> "KG `1` \:3092\:4fdd\:5b58\:3067\:304d\:307e\:305b\:3093", "MessageParameters" -> {b["Graph"]}|>]]]];
  If[TrueQ[opt["Write"]], w = iSWS2KWriteFE[nb, b]; If[FailureQ[w], Return[w]]];
  Success["GraphFromSlides", <|"GraphId" -> b["Graph"], "Title" -> b["Title"], "Nodes" -> Length[b["KG"]["Nodes"]], "Parts" -> b["Parts"],
    "Slides" -> b["SlideCount"], "Covers" -> b["Covers"], "Tail" -> b["Tail"], "PrivacyLevel" -> b["PrivacyLevel"],
    "Language" -> b["Language"], "Refreshed" -> b["Refreshed"], "Written" -> w, "KG" -> b["KG"]|>]];

(* \:30d5\:30a1\:30a4\:30eb: \:65e2\:5b9a\:306f\:5143\:3092\:6b8b\:3057\:3066 <\:540d\:524d>_sw.nb \:306b\:66f8\:304f ("InPlace" -> True \:3067\:4e0a\:66f8\:304d\:3001"Output" -> path \:3067\:66f8\:304d\:5148) *)
SlideGraphFromSlides[path_String /; StringEndsQ[path, ".nb", IgnoreCase -> True], opts : OptionsPattern[]] := Module[
  {out, res, nbo, opt = Association[Options[SlideGraphFromSlides], FilterRules[{opts}, Options[SlideGraphFromSlides]]]},
  If[! FileExistsQ[path], Return[Failure["NoFile", <|"MessageTemplate" -> "\:30d5\:30a1\:30a4\:30eb\:304c\:3042\:308a\:307e\:305b\:3093: `1`", "MessageParameters" -> {path}|>]]];
  out = Which[TrueQ[opt["InPlace"]], path, StringQ[opt["Output"]], opt["Output"],
    True, FileNameJoin[{DirectoryName[path], FileBaseName[path] <> "_sw.nb"}]];
  (* Return \:3092 UsingFrontEnd \:306e\:4e2d\:3067\:4f7f\:308f\:306a\:3044 (\:5916\:306e Module \:307e\:3067\:629c\:3051\:306a\:3044) *)
  res = UsingFrontEnd[
    nbo = NotebookOpen[path, Visible -> False];
    If[Head[nbo] =!= NotebookObject,
      Failure["OpenFailed", <|"MessageTemplate" -> "\:958b\:3051\:307e\:305b\:3093: `1`", "MessageParameters" -> {path}|>],
      With[{r = Block[{iSWStatus = (Null &)}, SlideGraphFromSlides[nbo, "DeckPath" -> If[TrueQ[opt["Write"]], out, path], opts]]},
        If[! FailureQ[r] && TrueQ[opt["Write"]], NotebookSave[nbo, out]];
        NotebookClose[nbo];
        r]]];
  If[FailureQ[res], res, Success["GraphFromSlides", Join[res[[2]], <|"File" -> If[TrueQ[opt["Write"]], out, None], "Source" -> path|>]]]];

