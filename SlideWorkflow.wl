(* \:7bc0\:306e\:884c (Id / Label / \:672c\:6587\:30ce\:30fc\:30c9 / \:4e0b\:4f4d\:7bc0 / \:6e08) \[LongDash] \:4e00\:89a7 (SlideGraphSectionText) \:3068\:9023\:9396\:3067\:5171\:7528\:3002
