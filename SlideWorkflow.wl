  "\:30e9\:30a4\:30bb\:30f3\:30b9\:306e\:5e2d (\:540c\:6642\:306b\:52d5\:304b\:305b\:308b Wolfram \:306e\:30d7\:30ed\:30bb\:30b9\:306e\:6570) \:304c\:57cb\:307e\:3063\:3066\:3044\:308b\:53ef\:80fd\:6027\:304c\:3042\:308a\:307e\:3059 (\:5e2d\:304c\:8db3\:308a\:306a\:3044\:3068\:304d\:3082\:300cnot activated\:300d\:3068\:8868\:793a\:3055\:308c\:307e\:3059)\:3002\:4f7f\:3063\:3066\:3044\:306a\:3044 WolframKernel.exe / wolframscript.exe \:3092\:7d42\:4e86\:3057\:3066\:5e2d\:3092\:7a7a\:3051\:3066\:304b\:3089\:3001",
  "The Wolfram license seats (how many Wolfram processes may run at once) may be exhausted (the \"not activated\" message also appears when no seat is free). End unused WolframKernel.exe / wolframscript.exe processes to free a seat, then "];

(* FE \:5185\:3078\:30d5\:30a9\:30fc\:30eb\:30d0\:30c3\:30af\:3059\:308b\:3068\:304d\:306b\:72b6\:614b\:6b04\:3078\:8db3\:3059\:6ce8\:8a18\:3002\:5b50\:304c\:8d77\:52d5\:3067\:304d\:306a\:304b\:3063\:305f\:3068\:304d ($iSWExternalBroken) \:3060\:3051 *)
iSWExternalSeatNote[] := If[$SlideExportExternal =!= False && TrueQ[$iSWExternalBroken],
  iSL[" (\:5225\:30d7\:30ed\:30bb\:30b9\:3092\:8d77\:52d5\:3067\:304d\:307e\:305b\:3093: \:30e9\:30a4\:30bb\:30f3\:30b9\:306e\:5e2d\:304c\:57cb\:307e\:3063\:3066\:3044\:308b\:53ef\:80fd\:6027\:3002\:4f7f\:3063\:3066\:3044\:306a\:3044 WolframKernel.exe / wolframscript.exe \:3092\:7d42\:4e86\:3059\:308b\:3068\:5e2d\:304c\:7a7a\:304d\:307e\:3059)",
    " (the separate process could not start: license seats may be exhausted; end unused WolframKernel.exe / wolframscript.exe to free a seat)"],
  ""];

iSWExternalExport[deckFile_String, kind_String, outSpec_String, optsCode_String] := Module[
  {script, tmp, res, out, so, msgs, r},
  $iSWExternalLastError = None; $iSWExternalLastRan = False;
  tmp = FileNameJoin[{$TemporaryDirectory,
    "slidewf_export_" <> IntegerString[RandomInteger[{10^8, 10^9}]] <> ".wls"}];
  script = StringJoin[
    "Global`$packageDirectory = " <> iSWASCIIForm[Global`$packageDirectory] <> ";\n",
    "Get[FileNameJoin[{Global`$packageDirectory, \"SlideWorkflow.wl\"}]];\n",
    (* \:89aa\:30ab\:30fc\:30cd\:30eb\:306e $SlideIncludeInput \:3092\:5b50\:30d7\:30ed\:30bb\:30b9\:306b\:3082\:5f15\:304d\:7d99\:3050 *)
    "SlideWorkflow`$SlideIncludeInput = " <> iSWASCIIForm[$SlideIncludeInput] <> ";\n",
    "ed = EvaluationData[SlideWorkflow`", kind, "[",
      iSWASCIIForm[deckFile], ", ", iSWASCIIForm[outSpec],
      If[optsCode === "", "", ", " <> optsCode], "]];\n",
    "Print[\"__SLIDEWF_MESSAGES__\", ToString[Take[ed[\"MessagesText\"], UpTo[3]], InputForm, CharacterEncoding -> \"PrintableASCII\"]];\n",
    "Print[\"__SLIDEWF_RESULT__\", ToString[ed[\"Result\"], InputForm, CharacterEncoding -> \"PrintableASCII\"]];\n"];
  Export[tmp, script, "Text", CharacterEncoding -> "UTF-8"];
  res = RunProcess[{iSWWolframScriptPath[], "-file", tmp}];
  Quiet[DeleteFile[tmp]];
  If[!AssociationQ[res],
    $iSWExternalLastError = "RunProcess: " <> ToString[Short[res]]; Return[$Failed]];
  so = ToString[Lookup[res, "StandardOutput", ""]];
  msgs = StringCases[so, "__SLIDEWF_MESSAGES__" ~~ m : Shortest[___] ~~ "\n" :> m];
  out = StringCases[so, "__SLIDEWF_RESULT__" ~~ x___ ~~ EndOfString :> x];
  $iSWExternalLastRan = msgs =!= {} || out =!= {};
  r = If[out === {}, $Failed, Quiet[Check[ToExpression[StringTrim[First[out]]], $Failed]]];
  If[r === $Failed || FailureQ[r], $iSWExternalLastError = iSWExternalErrorText[res, msgs]];
  r];

(* \:4fdd\:5b58\:6e08\:307f\:306a\:3089\:5225\:30d7\:30ed\:30bb\:30b9\:3067\:66f8\:304d\:51fa\:3059 (FE \:3092\:5360\:6709\:3057\:306a\:3044)\:3002
   \:672a\:4fdd\:5b58\:30fb\:5916\:90e8\:5931\:6557\:6642\:306f\:5f93\:6765\:306e\:30a4\:30f3\:30d7\:30ed\:30bb\:30b9\:7d4c\:8def\:3078\:30d5\:30a9\:30fc\:30eb\:30d0\:30c3\:30af\:3059\:308b\:3002 *)
iSWTryExternal[nb_, kind_String, outSpec_String] := Module[{src, r},
  If[$SlideExportExternal === False || TrueQ[$iSWExternalBroken], Return[$Failed]];
  If[iSWUnsavedQ[nb], Return[$Failed]];
  src = iSWDeckSource[nb];
  If[!StringQ[src], Return[$Failed]];
  iSWStatus[nb, iSL["\:5225\:30d7\:30ed\:30bb\:30b9\:3067\:66f8\:304d\:51fa\:3057\:4e2d (FE \:306f\:64cd\:4f5c\:53ef\:80fd)...",
    "Exporting in a separate process (FE stays usable)..."]];
  r = iSWExternalExport[src, kind, outSpec, ""];
  (* \:5e2d\:67af\:6e07\:7b49\:3067\:5b50\:30d7\:30ed\:30bb\:30b9\:304c\:8d77\:304d\:306a\:3044\:74b0\:5883\:3067\:306f\:4ee5\:5f8c\:8a66\:3055\:306a\:3044 *)
  (* \:5b50\:304c\:30b9\:30af\:30ea\:30d7\:30c8\:3092\:8d70\:3089\:305b\:3066\:5931\:6557\:3057\:305f (\:30d1\:30b9\:30fb\:30c7\:30c3\:30ad\:306e\:554f\:984c) \:306a\:3089\:6b21\:3082\:8a66\:3059 (v1.50) *)
  If[r === $Failed && $SlideExportExternal === Automatic && ! TrueQ[$iSWExternalLastRan],
    $iSWExternalBroken = True];
  r];

iSWExportImagesAction[nb_] := Module[{dir, base, imgs, files, ext, outdir},
  {dir, base} = iSWDeckBaseName[nb];
  outdir = FileNameJoin[{dir, base <> "_slides"}];
  ext = iSWTryExternal[nb, "SlideDeckExportImages", outdir];
  If[MatchQ[ext, {__String}],
    iSWStatus[nb, iSL[ToString[Length[ext]] <> " \:679a\:66f8\:304d\:51fa\:3057\:307e\:3057\:305f (\:5225\:30d7\:30ed\:30bb\:30b9)",
      "Exported " <> ToString[Length[ext]] <> " images (external)"]];
    iSWStatusClearLater[nb];
    Quiet[SystemOpen[outdir]];
    Return[ext]];
  If[iSWUnsavedQ[nb],
    iSWStatus[nb, iSL["\:672a\:4fdd\:5b58\:306e\:305f\:3081 FE \:5185\:3067\:51e6\:7406\:3057\:307e\:3059 (\:4fdd\:5b58\:5f8c\:306a\:3089\:5225\:30d7\:30ed\:30bb\:30b9\:3067\:9ad8\:901f)",
      "Unsaved: processing inside FE (save first to use the external process)"]]];
  iSWStatus[nb, iSL["\:753b\:50cf\:66f8\:304d\:51fa\:3057\:4e2d...", "Exporting images..."] <> iSWExternalSeatNote[]];
  imgs = SlideDeckImages[iSWDeckSource[nb]];
  If[!MatchQ[imgs, {__Image}],
    iSWStatus[nb, iSL["\:66f8\:304d\:51fa\:3057\:5931\:6557", "Export failed"]]; iSWStatusClearLater[nb];
    Return[$Failed]];
  Module[{d = FileNameJoin[{dir, base <> "_slides"}]},
    If[!DirectoryQ[d], CreateDirectory[d, CreateIntermediateDirectories -> True]];
    files = MapIndexed[
      Export[FileNameJoin[{d, StringPadLeft[ToString[#2[[1]]], 2, "0"] <> ".png"}], #1] &,
      imgs];
    iSWStatus[nb, iSL[ToString[Length[files]] <> " \:679a\:66f8\:304d\:51fa\:3057\:307e\:3057\:305f",
      "Exported " <> ToString[Length[files]] <> " images"]];
    iSWStatusClearLater[nb];
    Quiet[SystemOpen[d]];
    files]];

iSWExportVideoAction[nb_] := Module[{dir, base, imgs, out, ext, mp4},
  {dir, base} = iSWDeckBaseName[nb];
  mp4 = FileNameJoin[{dir, base <> ".mp4"}];
