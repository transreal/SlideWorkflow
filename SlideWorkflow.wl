        "Then" -> Function[SlideGraphRefine[graphId, "Mode" -> "Visual", "Overview" -> False, "Refine" -> False, "PDF" -> pdf,
          "Audience" -> au, "Story" -> st, "BatchNodes" -> bn]]]]]];
