iSWKGSubtreeIds[kg_Association, sectionId_String] := Module[{kids, out = {sectionId}, q = {sectionId}},
  kids = GroupBy[Select[kg["Edges"], #["EdgeKind"] === "Contains" &], #["From"] &, Map[#["To"] &]];
  While[q =!= {}, q = Flatten[Lookup[kids, q, {}]]; out = Join[out, q]];
