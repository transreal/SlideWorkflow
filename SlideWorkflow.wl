  (* v1.55: \:539f\:7a3f\:304c\:30dd\:30b9\:30bf\:30fc\:306e\:3068\:304d\:306f\:3001\:30dd\:30b9\:30bf\:30fc\:539f\:7a3f\:306e\:3042\:308b\:679a\:3060\:3051\:3092\:8aad\:3080 (\:8a33\:306e\:78ba\:8a8d\:306f\:7121\:3057) *)
  If[SlideTalkMode[] === "Poster" && ! TrueQ[OptionValue["Record"]],
