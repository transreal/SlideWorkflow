Options[SlideGraphReuse] = {"Parent" -> Automatic, "After" -> None, "Prefix" -> Automatic, "Subtree" -> True, "Pin" -> False};
SlideGraphReuse[target_, source_String, ids_, opts : OptionsPattern[]] := Module[{tk, sk, sgid = source, r, saved},
