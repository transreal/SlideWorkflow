$iSWStoryKeyMap = <|"graph" -> "Graph", "kg" -> "Graph", "\:30b0\:30e9\:30d5" -> "Graph",
  "audience" -> "Audience", "\:8074\:304d\:624b" -> "Audience", "\:8074\:8846" -> "Audience", "\:5bfe\:8c61" -> "Audience",
