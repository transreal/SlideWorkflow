    nested = Join[nested, Select[next, secQ]];
    q = Select[next, ! secQ[#] && KeyExistsQ[index, #] && ! MemberQ[out, #] &];
    out = Join[out, q]];
  <|"Own" -> DeleteDuplicates[out], "Nested" -> DeleteDuplicates[nested]|>];

