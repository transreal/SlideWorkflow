          SelectionMove[cells[[i]], All, Cell];
          NotebookWrite[nb, Cell[First[c], "SlidePosterTalk", TaggingRules -> {"SWTalkKind" -> "Poster"}], All];
          n++]]],
    {i, Reverse[Range[Length[cells]]]}];
  n];
