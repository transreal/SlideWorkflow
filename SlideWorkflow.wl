(* v1.53: \:8868\:793a\:3092\:66f8\:304f\:6240\:306f\:3059\:3079\:3066\:3053\:308c\:3092\:901a\:3059\:3002\:30ea\:30e2\:30b3\:30f3\:306e\:898b\:5f35\:308a (1.5 \:79d2\:3054\:3068) \:304c\:300c\:8d70\:3063\:3066\:3044\:308c\:3070\:5fdc\:7b54on\:300d\:3068\:66f8\:3044\:3066\:3044\:3066\:3001
   \:5fdc\:7b54off \:304b\:3089\:518d\:751f\:3059\:308b\:3068\:8868\:793a\:304c\:52dd\:624b\:306b\:300c\:5fdc\:7b54on\:300d\:306b\:306a\:3063\:305f (\:8cea\:554f\:30bf\:30a4\:30e0\:306f\:7121\:3044\:307e\:307e) *)
iSWTalkLabelFor[run_] := (
  If[! TrueQ[run] && ! iSWPlayActiveQ[], $iSWBridgeNarrationOnly = False];
